# ============================================================
# TECHNICAL SCORE
# ============================================================

def calculate_technical_score(row):

    score = 0

    if row["ema9"] > row["ema21"]:
        score += 1
    else:
        score -= 1

    if row["ema21"] > row["ema50"]:
        score += 1
    else:
        score -= 1

    if row["close"] > row["ema21"]:
        score += 1
    else:
        score -= 1

    if row["close"] > row["vwap"]:
        score += 1
    else:
        score -= 1

    if row["macd"] > row["macd_signal"]:
        score += 1
    else:
        score -= 1

    if score >= 4:

        state = "STRONGLY BULLISH"

    elif score >= 2:

        state = "BULLISH"

    elif score <= -4:

        state = "STRONGLY BEARISH"

    elif score <= -2:

        state = "BEARISH"

    else:

        state = "NEUTRAL"

    return score, state


# ============================================================
# SWINGS
# ============================================================

def find_swings(df):

    highs = []
    lows = []

    window = SWING_WINDOW

    for i in range(
        window,
        len(df) - window,
    ):

        current_high = (
            df.iloc[i]["high"]
        )

        current_low = (
            df.iloc[i]["low"]
        )

        left_highs = (
            df.iloc[
                i - window:i
            ]["high"]
        )

        right_highs = (
            df.iloc[
                i + 1:i + window + 1
            ]["high"]
        )

        left_lows = (
            df.iloc[
                i - window:i
            ]["low"]
        )

        right_lows = (
            df.iloc[
                i + 1:i + window + 1
            ]["low"]
        )

        # ----------------------------------------------------
        # Swing HIGH
        # ----------------------------------------------------

        if (
            current_high >
            left_highs.max() + PRICE_EPSILON
            and
            current_high >=
            right_highs.max() - PRICE_EPSILON
        ):

            confirmation_index = (
                i + SWING_WINDOW
            )

            highs.append(
                {
                    "index": i,
                    "confirmation_index":
                        confirmation_index,
                    "time":
                        df.iloc[i]["begin"],
                    "confirmation_time":
                        df.iloc[
                            confirmation_index
                        ]["begin"],
                    "price":
                        float(current_high),
                }
            )

        # ----------------------------------------------------
        # Swing LOW
        # ----------------------------------------------------

        if (
            current_low <
            left_lows.min() - PRICE_EPSILON
            and
            current_low <=
            right_lows.min() + PRICE_EPSILON
        ):

            confirmation_index = (
                i + SWING_WINDOW
            )

            lows.append(
                {
                    "index": i,
                    "confirmation_index":
                        confirmation_index,
                    "time":
                        df.iloc[i]["begin"],
                    "confirmation_time":
                        df.iloc[
                            confirmation_index
                        ]["begin"],
                    "price":
                        float(current_low),
                }
            )

    return highs, lows


def classify_highs(highs):

    result = []

    previous = None

    for item in highs:

        price = item["price"]

        if previous is None:

            label = "HIGH"

        elif (
            price >
            previous +
            PRICE_EPSILON
        ):

            label = "HH"

        elif (
            price <
            previous -
            PRICE_EPSILON
        ):

            label = "LH"

        else:

            label = "EQUAL"

        item = item.copy()

        item["label"] = label

        result.append(item)

        previous = price

    return result


def classify_lows(lows):

    result = []

    previous = None

    for item in lows:

        price = item["price"]

        if previous is None:

            label = "LOW"

        elif (
            price >
            previous +
            PRICE_EPSILON
        ):

            label = "HL"

        elif (
            price <
            previous -
            PRICE_EPSILON
        ):

            label = "LL"

        else:

            label = "EQUAL"

        item = item.copy()

        item["label"] = label

        result.append(item)

        previous = price

    return result


# ============================================================
# EVENT STRENGTH
# ============================================================

def calculate_event_strength(
    df,
    index,
    direction,
    level,
):

    row = df.iloc[index]

    high = float(row["high"])
    low = float(row["low"])

    open_price = float(
        row["open"]
    )

    close = float(
        row["close"]
    )

    candle_range = (
        high -
        low
    )

    if candle_range <= 0:

        body_score = 0.0
        close_score = 0.0
        wick_score = 0.0

    else:

        body = abs(
            close -
            open_price
        )

        body_score = (
            body /
            candle_range
        ) * 100

        if direction == "UP":

            close_position = (
                close -
                low
            ) / candle_range

        else:

            close_position = (
                high -
                close
            ) / candle_range

        close_score = (
            close_position *
            100
        )

        upper_wick = (
            high -
            max(
                open_price,
                close,
            )
        )

        lower_wick = (
            min(
                open_price,
                close,
            ) -
            low
        )

        if direction == "UP":

            opposite_wick = (
                upper_wick
            )

        else:

            opposite_wick = (
                lower_wick
            )

        wick_ratio = (
            opposite_wick /
            candle_range
        )

        wick_score = max(
            0.0,
            (
                1 -
                wick_ratio
            ) * 100,
        )

    volume_ratio = row.get(
        "volume_ratio",
        np.nan,
    )

    if pd.isna(volume_ratio):

        volume_score = 50.0
        volume_known = False

    else:

        volume_known = True

        if volume_ratio < 0.50:

            volume_score = 15.0

        elif volume_ratio < 0.80:

            volume_score = 40.0

        elif volume_ratio < 1.20:

            volume_score = 60.0

        elif volume_ratio < 1.80:

            volume_score = 80.0

        else:

            volume_score = 100.0

    break_distance = abs(
        close -
        level
    )

    atr = row.get(
        "atr14",
        np.nan,
    )

    if (
        pd.isna(atr)
        or
        atr <= 0
    ):

        break_score = 50.0

    else:

        break_score = min(
            100.0,
            (
                break_distance /
                atr
            ) * 100,
        )

    score = (
        break_score * 0.30 +
        volume_score * 0.25 +
        body_score * 0.20 +
        close_score * 0.15 +
        wick_score * 0.10
    )

    if volume_known:

        if volume_ratio < 0.50:

            score *= 0.72

        elif volume_ratio < 0.65:

            score *= 0.85

    score = max(
        0.0,
        min(
            100.0,
            score,
        ),
    )

    if score >= 80:

        quality = "VERY STRONG"

    elif score >= 65:

        quality = "STRONG"

    elif score >= 45:

        quality = "NORMAL"

    else:

        quality = "WEAK"

    return {
        "score": score,
        "quality": quality,
        "atr": atr,
        "volume_ratio": volume_ratio,
        "body_score": body_score,
        "break_score": break_score,
    }


# ============================================================
# STRUCTURAL SAFETY HELPERS
# ============================================================

def freeze_confirmation_level(
    current_level,
    new_level,
):

    if current_level is None:

        return new_level

    return current_level


def confirmation_breaks_down(
    close,
    confirmation_level,
):

    if confirmation_level is None:

        return False

    return (
        close <
        confirmation_level -
        PRICE_EPSILON
    )


def confirmation_breaks_up(
    close,
    confirmation_level,
):

    if confirmation_level is None:

        return False

    return (
        close >
        confirmation_level +
        PRICE_EPSILON
    )


def transition_failure_up(
    close,
    protected_high,
):

    if protected_high is None:

        return False

    return (
        close >
        protected_high +
        PRICE_EPSILON
    )


def transition_failure_down(
    close,
    protected_low,
):

    if protected_low is None:

        return False

    return (
        close <
        protected_low -
        PRICE_EPSILON
    )


# ============================================================
# LOOKAHEAD-SAFE SWING ACCESS
# ============================================================

def swing_is_confirmed(
    swing,
    current_index,
):

    if swing is None:

        return False

    return (
        swing["confirmation_index"]
        <=
        current_index
    )


def confirmed_swings_up_to(
    swings,
    current_index,
):

    return [
        item
        for item in swings
        if swing_is_confirmed(
            item,
            current_index,
        )
    ]


# ============================================================
# STRUCTURE ENGINE
# ============================================================

def run_structure_engine(
    df,
    highs,
    lows,
):

    events = []

    state = "INITIALIZING"

    current_trend = None

    protected_high = None
    protected_low = None

    transition_direction = None
    transition_phase = None

    transition_confirmation_level = None

    transition_high = None
    transition_low = None

    transition_start_index = None

    transition_high_sequence = []
    transition_low_sequence = []

    bos_high_level_used = set()
    bos_low_level_used = set()

    choch_high_level_used = set()
    choch_low_level_used = set()

    transition_failed_high_levels_used = set()
    transition_failed_low_levels_used = set()

    reversal_high_levels_used = set()
    reversal_low_levels_used = set()

    state_changing_event_types = {
        "TREND_CONFIRMED",
        "CHOCH",
        "TRANSITION_FAILED",
        "REVERSAL_CONFIRMED",
    }

    # --------------------------------------------------------
    # Event writer
    # --------------------------------------------------------

    def add_event(
        index,
        event_type,
        direction=None,
        level=None,
        strength=None,
    ):

        nonlocal events

        for existing in events:

            existing_level = (
                existing.get("level")
            )

            level_match = True

            if (
                level is not None
                and
                existing_level is not None
            ):

                level_match = (
                    abs(
                        existing_level -
                        level
                    )
                    <= PRICE_EPSILON
                )

            elif (
                level !=
                existing_level
            ):

                level_match = False

            if (
                existing["index"] == index
                and
                existing["event"] ==
                event_type
                and
                existing.get(
                    "direction"
                ) == direction
                and
                level_match
            ):

                return False

        if (
            event_type
            in
            state_changing_event_types
        ):

            for existing in events:

                if (
                    existing["index"] ==
                    index
                    and
                    existing["event"]
                    in
                    state_changing_event_types
                ):
                    raise RuntimeError(
                        "Multiple state-changing events on the same bar: "
                        f"index={index}, existing={existing['event']}, "
                        f"new={event_type}"
                    )

        event = {
            "index": int(index),
            # The event is known only after the bar closes. Keep both
            # timestamps explicit so execution cannot confuse decision
            # time with the bar's opening timestamp.
            "time": df.iloc[index]["end"],
            "bar_begin": df.iloc[index]["begin"],
            "event": event_type,
            "direction": direction,
            "level": level,
            "strength": strength,
        }

        events.append(event)

        return True

    # --------------------------------------------------------
    # Reset transition
    # --------------------------------------------------------

    def reset_transition():

        nonlocal transition_direction
        nonlocal transition_phase
        nonlocal transition_confirmation_level
        nonlocal transition_high
        nonlocal transition_low
        nonlocal transition_start_index
        nonlocal transition_high_sequence
        nonlocal transition_low_sequence

        transition_direction = None
        transition_phase = None

        transition_confirmation_level = None

        transition_high = None
        transition_low = None

        transition_start_index = None

        transition_high_sequence = []
        transition_low_sequence = []

    # --------------------------------------------------------
    # Swing lookup
    # --------------------------------------------------------

    high_by_confirmation_index = {}

    low_by_confirmation_index = {}

    for item in highs:

        confirmation_index = (
            item["confirmation_index"]
        )

        high_by_confirmation_index.setdefault(
            confirmation_index,
            []
        ).append(item)

    for item in lows:

        confirmation_index = (
            item["confirmation_index"]
        )

        low_by_confirmation_index.setdefault(
            confirmation_index,
            []
        ).append(item)

    # --------------------------------------------------------
    # Main loop
    # --------------------------------------------------------

    for i in range(len(df)):

        row = df.iloc[i]

        close = float(
            row["close"]
        )

        # IMPORTANT:
        # These are swings that are known NOW.
        current_confirmed_highs = (
            high_by_confirmation_index.get(
                i,
                []
            )
        )

        current_confirmed_lows = (
            low_by_confirmation_index.get(
                i,
                []
            )
        )

        current_high = (
            current_confirmed_highs[-1]
            if current_confirmed_highs
            else None
        )

        current_low = (
            current_confirmed_lows[-1]
            if current_confirmed_lows
            else None
        )

        trend_confirmed_this_bar = False

        # ====================================================
        # INITIAL TREND
        # ====================================================

        if current_trend is None:

            recent_highs = (
                confirmed_swings_up_to(
                    highs,
                    i,
                )
            )

            recent_lows = (
                confirmed_swings_up_to(
                    lows,
                    i,
                )
            )

            if (
                len(recent_highs) >= 2
                and
                len(recent_lows) >= 2
            ):

                h1 = recent_highs[-2]
                h2 = recent_highs[-1]

                l1 = recent_lows[-2]
                l2 = recent_lows[-1]

                if (
                    h1["index"] < h2["index"]
                    and
                    l1["index"] < l2["index"]
                    and
                    h2["price"] >
                    h1["price"] +
                    PRICE_EPSILON
                    and
                    l2["price"] >
                    l1["price"] +
                    PRICE_EPSILON
                ):

                    current_trend = "BULLISH"
                    state = "TREND"

                    protected_high = h2
                    protected_low = l2

                    trend_confirmed_this_bar = True

                    bos_high_level_used.add(
                        protected_high["price"]
                    )

                    add_event(
                        i,
                        "TREND_CONFIRMED",
                        "UP",
                        protected_high["price"],
                    )

                elif (
                    h1["index"] < h2["index"]
                    and
                    l1["index"] < l2["index"]
                    and
                    h2["price"] <
                    h1["price"] -
                    PRICE_EPSILON
                    and
                    l2["price"] <
                    l1["price"] -
                    PRICE_EPSILON
                ):

                    current_trend = "BEARISH"
                    state = "TREND"

                    protected_high = h2
                    protected_low = l2

                    trend_confirmed_this_bar = True

                    bos_low_level_used.add(
                        protected_low["price"]
                    )

                    add_event(
                        i,
                        "TREND_CONFIRMED",
                        "DOWN",
                        protected_low["price"],
                    )

        # ====================================================
        # BULLISH TREND
        # ====================================================

        if (
            current_trend == "BULLISH"
            and
            state == "TREND"
        ):

            # ------------------------------------------------
            # New protected high
            # ------------------------------------------------

            if (
                current_high is not None
                and
                (
                    protected_high is None
                    or
                    current_high["price"] >
                    protected_high["price"] +
                    PRICE_EPSILON
                )
            ):

                protected_high = current_high

                bos_high_level_used.discard(
                    protected_high["price"]
                )

            # ------------------------------------------------
            # New protected low
            # ------------------------------------------------

            if (
                current_low is not None
                and
                (
                    protected_low is None
                    or
                    current_low["price"] >
                    protected_low["price"] +
                    PRICE_EPSILON
                )
            ):

                protected_low = current_low

            # ------------------------------------------------
            # CHOCH DOWN
            # ------------------------------------------------

            if (
                not trend_confirmed_this_bar
                and
                protected_low is not None
                and
                close <
                protected_low["price"] -
                PRICE_EPSILON
                and
                protected_low["price"]
                not in
                choch_low_level_used
            ):

                choch_level = (
                    protected_low["price"]
                )

                choch_low_level_used.add(
                    choch_level
                )

                transition_direction = "DOWN"
                transition_phase = "BUILD"

                transition_confirmation_level = None

                transition_high = None
                transition_low = None

                transition_start_index = i

                transition_high_sequence = []
                transition_low_sequence = []

                state = "TRANSITION"

                add_event(
                    i,
                    "CHOCH",
                    "DOWN",
                    choch_level,
                )

                continue

            # ------------------------------------------------
            # BOS UP
            # ------------------------------------------------

            if (
                protected_high is not None
                and
                close >
                protected_high["price"] +
                PRICE_EPSILON
                and
                protected_high["price"]
                not in
                bos_high_level_used
            ):

                bos_high_level_used.add(
                    protected_high["price"]
                )

                strength = (
                    calculate_event_strength(
                        df,
                        i,
                        "UP",
                        protected_high["price"],
                    )
                )

                add_event(
                    i,
                    "BOS",
                    "UP",
                    protected_high["price"],
                    strength,
                )

        # ====================================================
        # BEARISH TREND
        # ====================================================

        if (
            current_trend == "BEARISH"
            and
            state == "TREND"
        ):

            # ------------------------------------------------
            # New protected low
            # ------------------------------------------------

            if (
                current_low is not None
                and
                (
                    protected_low is None
                    or
                    current_low["price"] <
                    protected_low["price"] -
                    PRICE_EPSILON
                )
            ):

                protected_low = current_low

            # ------------------------------------------------
            # New protected high
            # ------------------------------------------------

            if (
                current_high is not None
                and
                (
                    protected_high is None
                    or
                    current_high["price"] <
                    protected_high["price"] -
                    PRICE_EPSILON
                )
            ):

                protected_high = current_high

            # ------------------------------------------------
            # CHOCH UP
            # ------------------------------------------------

            if (
                not trend_confirmed_this_bar
                and
                protected_high is not None
                and
                close >
                protected_high["price"] +
                PRICE_EPSILON
                and
                protected_high["price"]
                not in
                choch_high_level_used
            ):

                choch_level = (
                    protected_high["price"]
                )

                choch_high_level_used.add(
                    choch_level
                )

                transition_direction = "UP"
                transition_phase = "BUILD"

                transition_confirmation_level = None

                transition_low = None
                transition_high = None

                transition_start_index = i

                transition_high_sequence = []
                transition_low_sequence = []

                state = "TRANSITION"

                add_event(
                    i,
                    "CHOCH",
                    "UP",
                    choch_level,
                )

                continue

            # ------------------------------------------------
            # BOS DOWN
            # ------------------------------------------------

            if (
                protected_low is not None
                and
                close <
                protected_low["price"] -
                PRICE_EPSILON
                and
                protected_low["price"]
                not in
                bos_low_level_used
            ):

                bos_low_level_used.add(
                    protected_low["price"]
                )

                strength = (
                    calculate_event_strength(
                        df,
                        i,
                        "DOWN",
                        protected_low["price"],
                    )
                )

                add_event(
                    i,
                    "BOS",
                    "DOWN",
                    protected_low["price"],
                    strength,
                )

        # ====================================================
        # DOWN TRANSITION
        # ====================================================

        if (
            state == "TRANSITION"
            and
            transition_direction == "DOWN"
        ):

            # ------------------------------------------------
            # FAILURE FIRST
            # ------------------------------------------------

            if (
                protected_high is not None
                and
                transition_failure_up(
                    close,
                    protected_high["price"],
                )
                and
                protected_high["price"]
                not in
                transition_failed_high_levels_used
            ):

                failed_level = (
                    protected_high["price"]
                )

                transition_failed_high_levels_used.add(
                    failed_level
                )

                bos_high_level_used.add(
                    failed_level
                )

                add_event(
                    i,
                    "TRANSITION_FAILED",
                    "UP",
                    failed_level,
                )

                reset_transition()

                state = "TREND"

                continue

            # ------------------------------------------------
            # Only swings CONFIRMED after CHOCH
            # ------------------------------------------------

            swing_is_after_transition_start = (
                transition_start_index is not None
                and
                i >
                transition_start_index
            )

            if (
                swing_is_after_transition_start
                and
                current_high is not None
            ):

                # ------------------------------------------------
                # For DOWN transition we need the latest
                # structurally valid LH candidate.
                #
                # A higher high invalidates the previous LH
                # candidate as the active transition high.
                # ------------------------------------------------

                if (
                    current_high["price"] <
                    protected_high["price"] -
                    PRICE_EPSILON
                ):

                    transition_high = (
                        current_high
                    )

                    transition_high_sequence.append(
                        current_high
                    )

            # ------------------------------------------------
            # Transition low
            # ------------------------------------------------

            if (
                swing_is_after_transition_start
                and
                current_low is not None
            ):

                if (
                    transition_low is None
                    or
                    current_low["price"] <
                    transition_low["price"] -
                    PRICE_EPSILON
                ):

                    transition_low = (
                        current_low
                    )

                    transition_low_sequence.append(
                        current_low
                    )

                    transition_confirmation_level = (
                        freeze_confirmation_level(
                            transition_confirmation_level,
                            transition_low["price"],
                        )
                    )

            # ------------------------------------------------
            # Reversal confirmation DOWN
            # ------------------------------------------------

            if (
                transition_phase ==
                "WAIT_BREAK"
                and
                confirmation_breaks_down(
                    close,
                    transition_confirmation_level,
                )
            ):

                level = (
                    transition_confirmation_level
                )

                if (
                    level not in
                    reversal_low_levels_used
                ):

                    reversal_low_levels_used.add(
                        level
                    )

                    add_event(
                        i,
                        "REVERSAL_CONFIRMED",
                        "DOWN",
                        level,
                    )

                    current_trend = "BEARISH"

                    state = "TREND"

                    if transition_low is not None:

                        protected_low = (
                            transition_low
                        )

                    if transition_high is not None:

                        protected_high = (
                            transition_high
                        )

                    reset_transition()

                    continue

            # ------------------------------------------------
            # BUILD -> WAIT_BREAK
            # ------------------------------------------------

            if (
                transition_confirmation_level
                is not None
                and
                transition_high is not None
            ):

                transition_phase = (
                    "WAIT_BREAK"
                )

        # ====================================================
        # UP TRANSITION
        # ====================================================

        if (
            state == "TRANSITION"
            and
            transition_direction == "UP"
        ):

            # ------------------------------------------------
            # FAILURE FIRST
            # ------------------------------------------------

            if (
                protected_low is not None
                and
                transition_failure_down(
                    close,
                    protected_low["price"],
                )
                and
                protected_low["price"]
                not in
                transition_failed_low_levels_used
            ):

                failed_level = (
                    protected_low["price"]
                )

                transition_failed_low_levels_used.add(
                    failed_level
                )

                bos_low_level_used.add(
                    failed_level
                )

                add_event(
                    i,
                    "TRANSITION_FAILED",
                    "DOWN",
                    failed_level,
                )

                reset_transition()

                state = "TREND"

                continue

            swing_is_after_transition_start = (
                transition_start_index is not None
                and
                i >
                transition_start_index
            )

            # ------------------------------------------------
            # Transition low
            # ------------------------------------------------

            if (
                swing_is_after_transition_start
                and
                current_low is not None
            ):

                if (
                    current_low["price"] >
                    protected_low["price"] +
                    PRICE_EPSILON
                ):

                    transition_low = (
                        current_low
                    )

                    transition_low_sequence.append(
                        current_low
                    )

            # ------------------------------------------------
            # Transition high
            # ------------------------------------------------

            if (
                swing_is_after_transition_start
                and
                current_high is not None
            ):

                if (
                    transition_high is None
                    or
                    current_high["price"] >
                    transition_high["price"] +
                    PRICE_EPSILON
                ):

                    transition_high = (
                        current_high
                    )

                    transition_high_sequence.append(
                        current_high
                    )

                    transition_confirmation_level = (
                        freeze_confirmation_level(
                            transition_confirmation_level,
                            transition_high["price"],
                        )
                    )

            # ------------------------------------------------
            # Reversal confirmation UP
            # ------------------------------------------------

            if (
                transition_phase ==
                "WAIT_BREAK"
                and
                confirmation_breaks_up(
                    close,
                    transition_confirmation_level,
                )
            ):

                level = (
                    transition_confirmation_level
                )

                if (
                    level not in
                    reversal_high_levels_used
                ):

                    reversal_high_levels_used.add(
                        level
                    )

                    add_event(
                        i,
                        "REVERSAL_CONFIRMED",
                        "UP",
                        level,
                    )

                    current_trend = "BULLISH"

                    state = "TREND"

                    if transition_high is not None:

                        protected_high = (
                            transition_high
                        )

                    if transition_low is not None:

                        protected_low = (
                            transition_low
                        )

                    reset_transition()

                    continue

            # ------------------------------------------------
            # BUILD -> WAIT_BREAK
            # ------------------------------------------------

            if (
                transition_confirmation_level
                is not None
                and
                transition_low is not None
            ):

                transition_phase = (
                    "WAIT_BREAK"
                )

    return {
        "state": state,
        "current_trend": current_trend,
        "protected_high": protected_high,
        "protected_low": protected_low,
        "transition_direction":
            transition_direction,
        "transition_phase":
            transition_phase,
        "transition_confirmation_level":
            transition_confirmation_level,
        "transition_high":
            transition_high,
        "transition_low":
            transition_low,
        "transition_start_index":
            transition_start_index,
        "events": events,
    }


# ============================================================
# STRUCTURE VALIDATION
# ============================================================

def validate_structure(structure):

    errors = []

    state = structure["state"]

    current_trend = (
        structure["current_trend"]
    )

    protected_high = (
        structure["protected_high"]
    )

    protected_low = (
        structure["protected_low"]
    )

    transition_direction = (
        structure[
            "transition_direction"
        ]
    )

    transition_phase = (
        structure[
            "transition_phase"
        ]
    )

    confirmation = (
        structure[
            "transition_confirmation_level"
        ]
    )

    transition_high = (
        structure["transition_high"]
    )

    transition_low = (
        structure["transition_low"]
    )

    transition_start_index = (
        structure[
            "transition_start_index"
        ]
    )

    # --------------------------------------------------------
    # General state
    # --------------------------------------------------------

    if state not in {
        "INITIALIZING",
        "TREND",
        "TRANSITION",
    }:

        errors.append(
            f"Unknown structure state: {state}"
        )

    # --------------------------------------------------------
    # Transition integrity
    # --------------------------------------------------------

    if state == "TRANSITION":

        if transition_direction not in {
            "UP",
            "DOWN",
        }:

            errors.append(
                "Transition state without direction"
            )

        if transition_phase not in {
            "BUILD",
            "WAIT_BREAK",
        }:

            errors.append(
                "Transition state without valid phase"
            )

        if confirmation is None:

            errors.append(
                "Transition has no frozen "
                "confirmation level"
            )

        if transition_start_index is None:

            errors.append(
                "Transition has no start index"
            )

    # --------------------------------------------------------
    # Confirmation geometry
    # --------------------------------------------------------

    if (
        state == "TRANSITION"
        and
        transition_direction == "DOWN"
        and
        confirmation is not None
        and
        transition_high is not None
    ):

        if (
            confirmation >
            transition_high["price"] +
            PRICE_EPSILON
        ):

            errors.append(
                "DOWN confirmation above "
                "transition high"
            )

    if (
        state == "TRANSITION"
        and
        transition_direction == "UP"
        and
        confirmation is not None
        and
        transition_low is not None
    ):

        if (
            confirmation <
            transition_low["price"] -
            PRICE_EPSILON
        ):

            errors.append(
                "UP confirmation below "
                "transition low"
            )

    # --------------------------------------------------------
    # Transition temporal integrity
    # --------------------------------------------------------

    if (
        state == "TRANSITION"
        and
        transition_start_index is not None
    ):

        if (
            transition_high is not None
            and
            transition_high["index"]
            <= transition_start_index
        ):

            errors.append(
                "Transition high predates "
                "or equals transition start"
            )

        if (
            transition_low is not None
            and
            transition_low["index"]
            <= transition_start_index
        ):

            errors.append(
                "Transition low predates "
                "or equals transition start"
            )

    # --------------------------------------------------------
    # Protected levels
    # --------------------------------------------------------

    if (
        current_trend == "BULLISH"
        and
        protected_high is None
    ):

        errors.append(
            "Bullish trend without "
            "protected high"
        )

    if (
        current_trend == "BULLISH"
        and
        protected_low is None
    ):

        errors.append(
            "Bullish trend without "
            "protected low"
        )

    if (
        current_trend == "BEARISH"
        and
        protected_high is None
    ):

        errors.append(
            "Bearish trend without "
            "protected high"
        )

    if (
        current_trend == "BEARISH"
        and
        protected_low is None
    ):

        errors.append(
            "Bearish trend without "
            "protected low"
        )

    return errors


# ============================================================
# RUNTIME STRUCTURAL TESTS
# ============================================================

def run_runtime_structure_tests(
    df,
    highs,
    lows,
    structure,
):

    print()
    print("=" * 70)
    print(
        "RUNTIME STRUCTURAL INTEGRITY TESTS"
    )
    print("=" * 70)
    print()

    passed = 0
    total = 0

    def test(
        name,
        condition,
    ):

        nonlocal passed
        nonlocal total

        total += 1

        if condition:

            print(
                f"[PASS] {name}"
            )

            passed += 1

        else:

            print(
                f"[FAIL] {name}"
            )

    # --------------------------------------------------------
    # 1. Every swing is only used after confirmation
    # --------------------------------------------------------

    all_confirmed_correctly = True

    for swing in (
        highs +
        lows
    ):

        if (
            swing["confirmation_index"]
            !=
            swing["index"] +
            SWING_WINDOW
        ):

            all_confirmed_correctly = False
            break

    test(
        "Every swing has correct confirmation index",
        all_confirmed_correctly,
    )

    # --------------------------------------------------------
    # 2. Every structural event uses confirmed information
    # --------------------------------------------------------

    event_times_valid = True

    for event in structure["events"]:

        index = event["index"]

        # Event itself can happen on current candle,
        # but any swing that defines its level must already
        # have been confirmed by this candle.

        level = event.get("level")

        if level is None:

            continue

        matching_swings = [
            swing
            for swing in (
                highs +
                lows
            )
            if abs(
                swing["price"] -
                level
            ) <= PRICE_EPSILON
        ]

        if matching_swings:

            if not any(
                swing["confirmation_index"]
                <= index
                for swing in matching_swings
            ):

                event_times_valid = False
                break

    test(
        "Structural events use confirmed swings only",
        event_times_valid,
    )

    # --------------------------------------------------------
    # 3. No transition swing before CHOCH
    # --------------------------------------------------------

    transition_temporal_valid = True

    start_index = (
        structure[
            "transition_start_index"
        ]
    )

    if (
        structure["state"] ==
        "TRANSITION"
        and
        start_index is not None
    ):

        transition_high = (
            structure["transition_high"]
        )

        transition_low = (
            structure["transition_low"]
        )

        if (
            transition_high is not None
            and
            transition_high["confirmation_index"]
            <= start_index
        ):

            transition_temporal_valid = False

        if (
            transition_low is not None
            and
            transition_low["confirmation_index"]
            <= start_index
        ):

            transition_temporal_valid = False

    test(
        "Transition uses only post-CHOCH confirmed swings",
        transition_temporal_valid,
    )

    # --------------------------------------------------------
    # 4. Failed transition cannot immediately BOS
    # --------------------------------------------------------

    failed_levels = []

    immediate_failed_bos = False

    for event in structure["events"]:

        if (
            event["event"] ==
            "TRANSITION_FAILED"
        ):

            failed_levels.append(
                (
                    event["direction"],
                    event["level"],
                    event["index"],
                )
            )

        elif (
            event["event"] ==
            "BOS"
        ):

            for (
                failed_direction,
                failed_level,
                failed_index,
            ) in failed_levels:

                same_direction = (
                    (
                        failed_direction ==
                        "UP"
                        and
                        event["direction"] ==
                        "UP"
                    )
                    or
                    (
                        failed_direction ==
                        "DOWN"
                        and
                        event["direction"] ==
                        "DOWN"
                    )
                )

                same_level = (
                    abs(
                        event["level"] -
                        failed_level
                    )
                    <= PRICE_EPSILON
                )

                later = (
                    event["index"] >
                    failed_index
                )

                if (
                    same_direction
                    and
                    same_level
                    and
                    later
                ):

                    immediate_failed_bos = True

    test(
        "Failed transition level never becomes immediate BOS",
        not immediate_failed_bos,
    )

    # --------------------------------------------------------
    # 5. No duplicate state-changing event on same bar
    # --------------------------------------------------------

    state_events = [
        event
        for event in structure["events"]
        if event["event"]
        in {
            "TREND_CONFIRMED",
            "CHOCH",
            "TRANSITION_FAILED",
            "REVERSAL_CONFIRMED",
        }
    ]

    counts = {}

    for event in state_events:

        key = event["index"]

        counts[key] = (
            counts.get(key, 0) +
            1
        )

    test(
        "No duplicate state-changing events on same bar",
        all(
            count <= 1
            for count in counts.values()
        ),
    )

    # --------------------------------------------------------
    # 6. Event sequence is chronological
    # --------------------------------------------------------

    indices = [
        event["index"]
        for event in structure["events"]
    ]

    test(
        "Structural events are chronological",
        indices == sorted(indices),
    )

    # --------------------------------------------------------
    # 7. Actual current transition candidate is temporal
    # --------------------------------------------------------

    candidate_valid = True

    if (
        structure["state"] ==
        "TRANSITION"
        and
        structure[
            "transition_direction"
        ] == "DOWN"
    ):

        candidate = (
            structure[
                "transition_high"
            ]
        )

        if candidate is not None:

            candidate_valid = (
                candidate["confirmation_index"]
                <=
                len(df) - 1
                and
                candidate["index"]
                >
                structure[
                    "transition_start_index"
                ]
            )

    test(
        "Current transition candidate is temporally valid",
        candidate_valid,
    )

    # --------------------------------------------------------
    # 8. Deterministic event sequence
    # --------------------------------------------------------

    event_signature = [
        (
            event["index"],
            event["event"],
            event["direction"],
            (
                None
                if event["level"] is None
                else round(
                    event["level"],
                    10,
                )
            ),
        )
        for event in structure["events"]
    ]

    deterministic = (
        event_signature ==
        list(event_signature)
    )

    test(
        "Runtime event sequence is deterministic",
        deterministic,
    )

    print()
    print("-" * 70)

    print(
        f"RESULT: {passed}/{total} PASS"
    )

    if passed == total:

        print(
            "RUNTIME STRUCTURE INTEGRITY: OK"
        )

        result = True

    else:

        print(
            "RUNTIME STRUCTURE INTEGRITY: FAILED"
        )

        result = False

    print("=" * 70)
    print()

    return result


# ============================================================
# SIGNAL ENGINE
# ============================================================

def run_signal_engine(
    structure,
    technical_score,
    technical_state,
):

    signal = "WAIT"

    reasons = []

    trend = structure[
        "current_trend"
    ]

    state = structure[
        "state"
    ]

    events = structure[
        "events"
    ]

    confirmation = structure[
        "transition_confirmation_level"
    ]

    last_event = (
        events[-1]
        if events
        else None
    )

    # --------------------------------------------------------
    # No trend
    # --------------------------------------------------------

    if trend is None:

        reasons.append(
            "No confirmed market trend"
        )

        return {
            "signal": signal,
            "reasons": reasons,
            "last_event": last_event,
        }

    # --------------------------------------------------------
    # Bullish trend
    # --------------------------------------------------------

    if (
        trend == "BULLISH"
        and
        state == "TREND"
    ):

        if (
            last_event is not None
            and
            last_event["event"] == "BOS"
            and
            last_event["direction"] == "UP"
            and
            last_event["strength"] is not None
            and
            last_event["strength"]["score"] >= 65
            and
            technical_score >= 2
        ):

            signal = "BUY"

            reasons.append(
                "Bullish trend confirmed"
            )

            reasons.append(
                "Strong BOS UP detected"
            )

            reasons.append(
                "Technical bias supports bullish direction"
            )

        else:

            reasons.append(
                "Bullish structure not fully confirmed for entry"
            )

            if technical_score < 2:

                reasons.append(
                    "Technical bias does not support BUY"
                )

    # --------------------------------------------------------
    # Bearish trend
    # --------------------------------------------------------

    elif (
        trend == "BEARISH"
        and
        state == "TREND"
    ):

        if (
            last_event is not None
            and
            last_event["event"] == "BOS"
            and
            last_event["direction"] == "DOWN"
            and
            last_event["strength"] is not None
            and
            last_event["strength"]["score"] >= 65
            and
            technical_score <= -2
        ):

            signal = "SELL"

            reasons.append(
                "Bearish trend confirmed"
            )

            reasons.append(
                "Strong BOS DOWN detected"
            )

            reasons.append(
                "Technical bias supports bearish direction"
            )

        else:

            reasons.append(
                "Bearish structure not fully confirmed for entry"
            )

            if technical_score > -2:

                reasons.append(
                    "Technical bias does not support SELL"
                )

    # --------------------------------------------------------
    # Transition
    # --------------------------------------------------------

    elif state == "TRANSITION":

        direction = (
            structure[
                "transition_direction"
            ]
        )

        if direction == "DOWN":

            reasons.append(
                "Bearish transition active"
            )

            if technical_score <= -2:

                reasons.append(
                    "Technical bias supports bearish direction"
                )

            if (
                last_event is not None
                and
                last_event["event"] == "CHOCH"
                and
                last_event["direction"] == "DOWN"
            ):

                reasons.append(
                    "CHOCH DOWN detected"
                )

            if structure[
                "transition_high"
            ] is not None:

                reasons.append(
                    "Lower high candidate formed"
                )

            if confirmation is not None:

                reasons.append(
                    f"Frozen confirmation level "
                    f"{confirmation:.2f}"
                )

                reasons.append(
                    f"Waiting for close below "
                    f"{confirmation:.2f}"
                )

        elif direction == "UP":

            reasons.append(
                "Bullish transition active"
            )

            if technical_score >= 2:

                reasons.append(
                    "Technical bias supports bullish direction"
                )

            if (
                last_event is not None
                and
                last_event["event"] == "CHOCH"
                and
                last_event["direction"] == "UP"
            ):

                reasons.append(
                    "CHOCH UP detected"
                )

            if confirmation is not None:

                reasons.append(
                    f"Frozen confirmation level "
                    f"{confirmation:.2f}"
                )

                reasons.append(
                    f"Waiting for close above "
                    f"{confirmation:.2f}"
                )

    return {
        "signal": signal,
        "reasons": reasons,
        "last_event": last_event,
    }


# ============================================================
# STRUCTURAL UNIT TESTS
# ============================================================

def run_structural_integrity_tests():

    print()
    print("=" * 70)
    print(
        "STRUCTURAL INTEGRITY TESTS"
    )
    print("=" * 70)
    print()

    passed = 0
    total = 0

    def test(
        name,
        condition,
    ):

        nonlocal passed
        nonlocal total

        total += 1

        if condition:

            print(
                f"[PASS] {name}"
            )

            passed += 1

        else:

            print(
                f"[FAIL] {name}"
            )

    # 1
    first = freeze_confirmation_level(
        None,
        284.83,
    )

    second = freeze_confirmation_level(
        first,
        285.04,
    )

    third = freeze_confirmation_level(
        second,
        285.20,
    )

    test(
        "Frozen confirmation level",
        (
            first == 284.83
            and
            second == 284.83
            and
            third == 284.83
        ),
    )

    # 2
    test(
        "No reversal above confirmation level",
        not confirmation_breaks_down(
            284.90,
            284.83,
        ),
    )

    # 3
    test(
        "No reversal at confirmation level",
        not confirmation_breaks_down(
            284.83,
            284.83,
        ),
    )

    # 4
    test(
        "Reversal below confirmation level",
        confirmation_breaks_down(
            284.82,
            284.83,
        ),
    )

    # 5
    test(
        "Transition failure above protected level",
        transition_failure_up(
            286.57,
            286.56,
        ),
    )

    # 6
    used_choch_levels = set()

    level = 284.72

    first_choch_allowed = (
        level not in
        used_choch_levels
    )

    if first_choch_allowed:

        used_choch_levels.add(
            level
        )

    second_choch_allowed = (
        level not in
        used_choch_levels
    )

    test(
        "No duplicate CHOCH events",
        (
            first_choch_allowed
            and
            not second_choch_allowed
        ),
    )

    # 7
    used_bos_levels = set()

    level = 285.16

    first_bos_allowed = (
        level not in
        used_bos_levels
    )

    if first_bos_allowed:

        used_bos_levels.add(
            level
        )

    second_bos_allowed = (
        level not in
        used_bos_levels
    )

    test(
        "No duplicate BOS events",
        (
            first_bos_allowed
            and
            not second_bos_allowed
        ),
    )

    # 8
    state_changing_events = {
        "TREND_CONFIRMED",
        "CHOCH",
        "TRANSITION_FAILED",
        "REVERSAL_CONFIRMED",
    }

    same_bar_events = []

    def state_change_allowed(
        index,
        event_type,
    ):

        if (
            event_type
            not in
            state_changing_events
        ):

            return True

        for event in same_bar_events:

            if (
                event["index"] ==
                index
                and
                event["event"]
                in
                state_changing_events
            ):

                return False

        return True

    first_allowed = state_change_allowed(
        100,
        "CHOCH",
    )

    if first_allowed:

        same_bar_events.append(
            {
                "index": 100,
                "event": "CHOCH",
            }
        )

    second_allowed = state_change_allowed(
        100,
        "TRANSITION_FAILED",
    )

    test(
        "No same-bar state-changing events",
        (
            first_allowed
            and
            not second_allowed
        ),
    )

    # 9
    test(
        "Bullish confirmation symmetry",
        (
            not confirmation_breaks_up(
                285.10,
                285.20,
            )
            and
            not confirmation_breaks_up(
                285.20,
                285.20,
            )
            and
            confirmation_breaks_up(
                285.21,
                285.20,
            )
        ),
    )

    # 10
    test(
        "Price epsilon prevents false break",
        (
            not confirmation_breaks_down(
                284.83 +
                PRICE_EPSILON / 2,
                284.83,
            )
            and
            not confirmation_breaks_up(
                284.83 -
                PRICE_EPSILON / 2,
                284.83,
            )
        ),
    )

    # 11
    failed_bos_levels = set()

    failed_level = 285.04

    failed_bos_levels.add(
        failed_level
    )

    test(
        "Failed transition level blocks immediate BOS",
        failed_level in
        failed_bos_levels,
    )

    # 12
    old_protected_high = {
        "index": 50,
        "price": 286.56,
    }

    transition_start = 60

    transition_high = None

    test(
        "CHOCH starts transition without old swing",
        (
            transition_high is None
            and
            old_protected_high["index"]
            <
            transition_start
        ),
    )

    # 13
    old_swing_index = 59
    new_swing_index = 61

    old_allowed = (
        old_swing_index >
        transition_start
    )

    new_allowed = (
        new_swing_index >
        transition_start
    )

    test(
        "Transition ignores pre-CHOCH swings",
        (
            not old_allowed
            and
            new_allowed
        ),
    )

    # 14
    protected_high = 285.04
    close = 285.05

    failure_detected = (
        transition_failure_up(
            close,
            protected_high,
        )
    )

    transition_high_registered = False

    if failure_detected:

        transition_high_registered = False

    test(
        "Transition failure precedes swing registration",
        (
            failure_detected
            and
            not transition_high_registered
        ),
    )

    # 15
    first_result = (
        confirmation_breaks_down(
            284.82,
            284.83,
        )
    )

    second_result = (
        confirmation_breaks_down(
            284.82,
            284.83,
        )
    )

    test(
        "Structural helper behavior is deterministic",
        first_result ==
        second_result,
    )

    # 16
    synthetic_swing = {
        "index": 10,
        "confirmation_index": 12,
    }

    test(
        "Swing is unavailable before confirmation",
        (
            not swing_is_confirmed(
                synthetic_swing,
                11,
            )
            and
            swing_is_confirmed(
                synthetic_swing,
                12,
            )
        ),
    )

    # 17
    synthetic_swings = [
        {
            "index": 10,
            "confirmation_index": 12,
            "price": 100.0,
        },
        {
            "index": 20,
            "confirmation_index": 22,
            "price": 101.0,
        },
    ]

    test(
        "Confirmed swing lookup is time-safe",
        (
            len(
                confirmed_swings_up_to(
                    synthetic_swings,
                    11,
                )
            ) == 0
            and
            len(
                confirmed_swings_up_to(
                    synthetic_swings,
                    12,
                )
            ) == 1
            and
            len(
                confirmed_swings_up_to(
                    synthetic_swings,
                    22,
                )
            ) == 2
        ),
    )

    print()
    print("-" * 70)

    print(
        f"RESULT: {passed}/{total} PASS"
    )

    if passed == total:

        print(
            "STRUCTURE ENGINE INTEGRITY: OK"
        )

        result = True

    else:

        print(
            "STRUCTURE ENGINE INTEGRITY: FAILED"
        )

        result = False

    print("=" * 70)
    print()

    return result


# ============================================================
# EXCHANGE SESSION ENGINE v5.4.4
# ============================================================

def trading_session_key(timestamp):
    """
    Return the MOEX trading-day key for a candle timestamp.

    Return the ordinary weekday trading-session key used by the
    research engine. Weekend candles are normally removed before this
    function is used because EXCLUDE_WEEKEND_SESSIONS=True.
    """
    ts = pd.Timestamp(timestamp)
    date = ts.normalize()

    if date.weekday() == 5:
        return date + pd.Timedelta(days=2)

    if date.weekday() == 6:
        return date + pd.Timedelta(days=1)

    return date


def build_session_keys(df):
    """Build one exchange-session key for every candle."""
    return df["begin"].map(trading_session_key)


def print_session_audit(df):
    """Print a compact audit of actual exchange-session grouping."""
    session_keys = build_session_keys(df)
    temp = df[["begin"]].copy()
    temp["session_key"] = session_keys

    grouped = (
        temp
        .groupby("session_key", sort=True)
        .agg(
            first_candle=("begin", "min"),
            last_candle=("begin", "max"),
            candles=("begin", "size"),
        )
    )

    print()
    print("=" * 70)
    print("MOEX SESSION AUDIT")
    print("=" * 70)
    print()

    for session_key, row in grouped.iterrows():
        print(
            f"SESSION {session_key.strftime('%Y-%m-%d')} "
            f"| {row['first_candle'].strftime('%Y-%m-%d %H:%M')} "
            f"-> {row['last_candle'].strftime('%Y-%m-%d %H:%M')} "
            f"| {int(row['candles'])} x 5M"
        )

    print()
    print(
        f"Total exchange sessions: {len(grouped)}"
    )
    print("=" * 70)
    print()


# ============================================================
# BACKTEST ENGINE v5.4.3
# MULTI-DAY HISTORICAL BACKTEST
# ============================================================


def apply_slippage(price, side, is_entry):
    """Apply conservative adverse slippage to a simulated fill."""
    if price is None or pd.isna(price):
        raise ValueError("Invalid fill price")

    price = float(price)
    rate = BACKTEST_SLIPPAGE_RATE

    if side == "LONG":
        return price * (1 + rate) if is_entry else price * (1 - rate)

    if side == "SHORT":
        return price * (1 - rate) if is_entry else price * (1 + rate)

    raise ValueError(f"Unknown backtest side: {side}")


def commission_for_notional(notional):
    return abs(float(notional)) * BACKTEST_COMMISSION_RATE


def build_signal_timeline(df, highs, lows):
    """
    Build a causal intraday signal timeline.

    Structure resets by MOEX exchange session, not simply by calendar
    date. This is important because MOEX can run additional weekend
    sessions which belong to the following trading day.

    Technical indicators remain continuous across the full dataset.
    """
    timeline = []

    session_keys = build_session_keys(df)

    for i in range(len(df)):
        current_session = session_keys.iloc[i]

        session_mask = session_keys == current_session
        session_indices = df.index[session_mask]
        first_session_index = int(session_indices[0])

        prefix = df.iloc[first_session_index : i + 1].copy()

        prefix_highs, prefix_lows = find_swings(prefix)
        prefix_highs = classify_highs(prefix_highs)
        prefix_lows = classify_lows(prefix_lows)

        structure = run_structure_engine(
            prefix,
            prefix_highs,
            prefix_lows,
        )

        # Structure is intentionally reset per session, so its internal
        # indices are local to `prefix`. Convert event indices to the
        # global dataframe coordinate system before they leave this scope.
        global_events = []
        for local_event in structure["events"]:
            event = local_event.copy()
            local_index = int(event["index"])
            global_index = first_session_index + local_index
            event["index"] = global_index
            event["time"] = df.iloc[global_index]["end"]
            event["bar_begin"] = df.iloc[global_index]["begin"]
            global_events.append(event)

        technical_score, technical_state = (
            calculate_technical_score(df.iloc[i])
        )

        signal_result = run_signal_engine(
            structure,
            technical_score,
            technical_state,
        )

        timeline.append(
            {
                "index": i,
                "time": df.iloc[i]["begin"],
                "date": df.iloc[i]["begin"].normalize(),
                "session_key": current_session,
                "signal": signal_result["signal"],
                "technical_score": technical_score,
                "technical_state": technical_state,
                "last_event": signal_result["last_event"],
                "signal_event": (
                    signal_result["last_event"].copy()
                    if signal_result["last_event"] is not None
                    else None
                ),
                "structure_state": structure["state"],
                "current_trend": structure["current_trend"],
                "events_snapshot": global_events,
                "atr14": df.iloc[i].get("atr14", np.nan),
                "volume_ratio": df.iloc[i].get("volume_ratio", np.nan),
            }
        )

    return timeline


def build_global_session_swings(df):
    """Build session-local swings while preserving global dataframe indices."""
    session_keys = build_session_keys(df)
    all_highs = []
    all_lows = []

    for session_key in session_keys.drop_duplicates():
        global_indices = list(df.index[session_keys == session_key])
        session_df = df.iloc[global_indices].reset_index(drop=True)
        raw_highs, raw_lows = find_swings(session_df)
        session_highs = classify_highs(raw_highs)
        session_lows = classify_lows(raw_lows)

        for swing in session_highs:
            item = swing.copy()
            item["index"] = int(global_indices[item["index"]])
            item["confirmation_index"] = int(global_indices[item["confirmation_index"]])
            item["time"] = df.iloc[item["index"]]["begin"]
            item["confirmation_time"] = df.iloc[item["confirmation_index"]]["begin"]
            all_highs.append(item)

        for swing in session_lows:
            item = swing.copy()
            item["index"] = int(global_indices[item["index"]])
            item["confirmation_index"] = int(global_indices[item["confirmation_index"]])
            item["time"] = df.iloc[item["index"]]["begin"]
            item["confirmation_time"] = df.iloc[item["confirmation_index"]]["begin"]
            all_lows.append(item)

    all_highs.sort(key=lambda x: x["confirmation_index"])
    all_lows.sort(key=lambda x: x["confirmation_index"])
    return all_highs, all_lows


def run_backtest(df, highs, lows):
    """Run a conservative, research-only signal backtest."""
    if len(df) < 2:
        raise RuntimeError("Not enough candles for backtest")

    timeline = build_signal_timeline(df, highs, lows)

    capital = float(BACKTEST_INITIAL_CAPITAL)
    starting_capital = capital
    position = None
    trades = []
    equity_curve = []

    def open_position(side, signal_index):
        nonlocal capital

        next_index = signal_index + 1
        if next_index >= len(df):
            return None

        raw_price = float(df.iloc[next_index]["open"])
        fill_price = apply_slippage(
            raw_price,
            side,
            True,
        )

        if fill_price <= 0:
            raise RuntimeError("Invalid backtest entry price")

        allocation = (
            capital * BACKTEST_POSITION_SIZE_PCT / 100.0
        )

        if allocation <= 0:
            raise RuntimeError("Non-positive backtest allocation")

        quantity = allocation / fill_price
        entry_notional = quantity * fill_price
        entry_commission = commission_for_notional(
            entry_notional
        )

        capital -= entry_commission

        signal_item = timeline[signal_index]
        signal_event = signal_item.get("signal_event")
        signal_strength = (
            signal_event.get("strength")
            if signal_event is not None
            else None
        )

        return {
            "side": side,
            "signal_index": signal_index,
            "signal_time": signal_item["time"],
            "signal_technical_score": signal_item["technical_score"],
            "signal_technical_state": signal_item["technical_state"],
            "signal_structure_state": signal_item["structure_state"],
            "signal_current_trend": signal_item["current_trend"],
            "signal_event": signal_event.copy() if signal_event is not None else None,
            "signal_event_strength": signal_strength,
            "signal_atr14": signal_item.get("atr14", np.nan),
            "signal_volume_ratio": signal_item.get("volume_ratio", np.nan),
            "entry_index": next_index,
            "entry_time": df.iloc[next_index]["begin"],
            "entry_price": fill_price,
            "raw_entry_price": raw_price,
            "quantity": quantity,
            "entry_commission": entry_commission,
        }

    def close_position(pos, signal_index, reason, forced_exit_index=None):
        nonlocal capital

        # Normal signal exits use the next bar open. Forced session/end exits
        # must not cross into another trading session, so they use an explicit
        # bar and that bar's close price.
        if forced_exit_index is not None:
            exit_index = int(forced_exit_index)
            if exit_index < 0 or exit_index >= len(df):
                raise RuntimeError("Invalid forced exit index")
            raw_price = float(df.iloc[exit_index]["close"])
        else:
            exit_index = signal_index + 1
            if exit_index >= len(df):
                exit_index = len(df) - 1
            raw_price = float(df.iloc[exit_index]["open"])
        exit_price = apply_slippage(
            raw_price,
            pos["side"],
            False,
        )

        quantity = pos["quantity"]
        entry_price = pos["entry_price"]
        raw_entry_price = float(pos.get("raw_entry_price", entry_price))
        entry_slippage_cost = abs(entry_price - raw_entry_price) * quantity
        exit_slippage_cost = abs(exit_price - raw_price) * quantity

        if pos["side"] == "LONG":
            gross_pnl = (
                exit_price - entry_price
            ) * quantity
        else:
            gross_pnl = (
                entry_price - exit_price
            ) * quantity

        exit_notional = quantity * exit_price
        exit_commission = commission_for_notional(
            exit_notional
        )

        net_pnl = (
            gross_pnl
            - pos["entry_commission"]
            - exit_commission
        )

        capital += gross_pnl
        capital -= exit_commission

        entry_index = int(pos["entry_index"])
        entry_fill = float(pos["entry_price"])

        max_favorable_price_move = 0.0
        max_adverse_price_move = 0.0

        diagnostic_end_index = (
            exit_index
            if forced_exit_index is not None
            else signal_index
        )

        if diagnostic_end_index < entry_index:
            diagnostic_end_index = entry_index

        if BACKTEST_DIAGNOSTICS:
            for mark_index in range(entry_index, diagnostic_end_index + 1):
                bar = df.iloc[mark_index]
                bar_high = float(bar["high"])
                bar_low = float(bar["low"])

                if pos["side"] == "LONG":
                    favorable_move = bar_high - entry_fill
                    adverse_move = bar_low - entry_fill
                else:
                    favorable_move = entry_fill - bar_low
                    adverse_move = entry_fill - bar_high

                max_favorable_price_move = max(
                    max_favorable_price_move,
                    favorable_move,
                )
                max_adverse_price_move = min(
                    max_adverse_price_move,
                    adverse_move,
                )

        signal_event = pos.get("signal_event")
        signal_level = (
            float(signal_event["level"])
            if signal_event is not None
            and signal_event.get("level") is not None
            else np.nan
        )

        entry_to_event_distance = (
            abs(entry_fill - signal_level)
            if not pd.isna(signal_level)
            else np.nan
        )

        signal_atr = pos.get("signal_atr14", np.nan)
        entry_to_event_distance_atr = (
            entry_to_event_distance / float(signal_atr)
            if not pd.isna(signal_atr)
            and float(signal_atr) > 0
            and not pd.isna(entry_to_event_distance)
            else np.nan
        )

        trade_events = []
        for timeline_item in timeline:
            timeline_index = timeline_item["index"]
            if entry_index <= timeline_index <= diagnostic_end_index:
                for event in timeline_item.get("events_snapshot", []):
                    if (
                        event["index"] > pos["signal_index"]
                        and event["index"] <= diagnostic_end_index
                    ):
                        trade_events.append(event)

        unique_events = []
        seen_event_keys = set()
        for event in trade_events:
            key = (
                event.get("index"),
                event.get("event"),
                event.get("direction"),
                event.get("level"),
            )
            if key not in seen_event_keys:
                seen_event_keys.add(key)
                unique_events.append(event)

        return {
            "side": pos["side"],
            "entry_time": pos["entry_time"],
            "exit_time": df.iloc[exit_index]["begin"],
            "entry_price": entry_price,
            "exit_price": exit_price,
            "quantity": quantity,
            "gross_pnl": gross_pnl,
            "entry_commission": pos["entry_commission"],
            "exit_commission": exit_commission,
            "total_commission": pos["entry_commission"] + exit_commission,
            "entry_slippage_cost": entry_slippage_cost,
            "exit_slippage_cost": exit_slippage_cost,
            "total_slippage_cost": entry_slippage_cost + exit_slippage_cost,
            "net_pnl": net_pnl,
            "return_pct": (
                net_pnl /
                (entry_price * quantity) * 100
            ),
            "reason": reason,
            "signal_index": pos["signal_index"],
            "entry_index": pos["entry_index"],
            "exit_index": exit_index,
            "signal_time": pos.get("signal_time"),
            "technical_score_at_signal": pos.get("signal_technical_score"),
            "technical_state_at_signal": pos.get("signal_technical_state"),
            "structure_state_at_signal": pos.get("signal_structure_state"),
            "trend_at_signal": pos.get("signal_current_trend"),
            "signal_event": signal_event.copy() if signal_event is not None else None,
            "signal_event_type": signal_event.get("event") if signal_event is not None else None,
            "signal_event_direction": signal_event.get("direction") if signal_event is not None else None,
            "signal_event_level": signal_level,
            "signal_event_strength_score": (
                signal_event.get("strength", {}).get("score")
                if signal_event is not None
                and signal_event.get("strength") is not None
                else np.nan
            ),
            "signal_atr14": pos.get("signal_atr14", np.nan),
            "signal_volume_ratio": pos.get("signal_volume_ratio", np.nan),
            "entry_to_signal_level_distance": entry_to_event_distance,
            "entry_to_signal_level_atr": entry_to_event_distance_atr,
            "holding_bars": exit_index - entry_index,
            "mfe_price": max_favorable_price_move,
            "mae_price": max_adverse_price_move,
            "mfe_money": max_favorable_price_move * quantity,
            "mae_money": max_adverse_price_move * quantity,
            "mfe_pct_of_entry": (
                max_favorable_price_move / entry_fill * 100
                if entry_fill > 0 else 0.0
            ),
            "mae_pct_of_entry": (
                max_adverse_price_move / entry_fill * 100
                if entry_fill > 0 else 0.0
            ),
            "structure_events_during_trade": unique_events,
        }

    for item in timeline:
        i = item["index"]
        signal = item["signal"]

        # Never carry an intraday position across an MOEX exchange-session
        # boundary. Weekend sessions are handled by session_key, so a
        # Saturday/Sunday additional session can remain part of Monday's
        # exchange trading day when MOEX defines it that way.
        if position is not None and i > 0:
            previous_session = trading_session_key(
                df.iloc[i - 1]["begin"]
            )
            current_session = trading_session_key(
                df.iloc[i]["begin"]
            )

            if current_session != previous_session:
                trade = close_position(
                    position,
                    i - 1,
                    "END_OF_SESSION",
                    forced_exit_index=i - 1,
                )
                trades.append(trade)
                position = None

        if position is not None:
            if (
                position["side"] == "LONG"
                and signal == "SELL"
                and i > position["signal_index"]
            ):
                trade = close_position(
                    position,
                    i,
                    "OPPOSITE_SIGNAL",
                )
                trades.append(trade)
                position = None

            elif (
                position["side"] == "SHORT"
                and signal == "BUY"
                and i > position["signal_index"]
            ):
                trade = close_position(
                    position,
                    i,
                    "OPPOSITE_SIGNAL",
                )
                trades.append(trade)
                position = None

        if position is None and signal in {"BUY", "SELL"}:
            next_index = i + 1
            if (
                REJECT_CROSS_SESSION_ENTRIES
                and next_index < len(df)
                and trading_session_key(df.iloc[next_index]["begin"])
                != trading_session_key(df.iloc[i]["begin"])
            ):
                # A signal at the final bar of a session has no valid
                # same-session next-open fill. Do not create a temporal
                # paradox by entering the next session.
                continue
            side = (
                "LONG"
                if signal == "BUY"
                else "SHORT"
            )
            new_position = open_position(
                side,
                i,
            )
            if new_position is not None:
                position = new_position

        equity = capital
        if position is not None:
            mark_price = float(df.iloc[i]["close"])
            if position["side"] == "LONG":
                unrealized = (
                    mark_price - position["entry_price"]
                ) * position["quantity"]
            else:
                unrealized = (
                    position["entry_price"] - mark_price
                ) * position["quantity"]
            equity += unrealized

        equity_curve.append(
            {
                "index": i,
                "time": df.iloc[i]["begin"],
                "equity": equity,
            }
        )

    if (
        position is not None
        and BACKTEST_CLOSE_OPEN_POSITION_AT_END
    ):
        last_index = len(df) - 1
        trade = close_position(
            position,
            last_index,
            "END_OF_DATA",
            forced_exit_index=last_index,
        )
        trades.append(trade)
        position = None

        equity_curve[-1]["equity"] = capital

    equity_values = [
        item["equity"]
        for item in equity_curve
    ]

    if equity_values:
        running_peak = equity_values[0]
        max_drawdown = 0.0
        for value in equity_values:
            running_peak = max(
                running_peak,
                value,
            )
            if running_peak > 0:
                drawdown = (
                    (value - running_peak) /
                    running_peak
                ) * 100
                max_drawdown = min(
                    max_drawdown,
                    drawdown,
                )
    else:
        max_drawdown = 0.0

    wins = [
        trade for trade in trades
        if trade["net_pnl"] > 0
    ]
    losses = [
        trade for trade in trades
        if trade["net_pnl"] < 0
    ]

    gross_profit = sum(
        trade["net_pnl"]
        for trade in wins
    )
    gross_loss = abs(sum(
        trade["net_pnl"]
        for trade in losses
    ))

    if gross_loss > 0:
        profit_factor = (
            gross_profit / gross_loss
        )
    else:
        profit_factor = np.inf if gross_profit > 0 else 0.0

    total_net_pnl = sum(
        trade["net_pnl"]
        for trade in trades
    )

    total_commission = sum(trade.get("total_commission", 0.0) for trade in trades)
    total_slippage = sum(trade.get("total_slippage_cost", 0.0) for trade in trades)

    if trades:
        win_rate = (
            len(wins) /
            len(trades) * 100
        )
        average_trade = (
            total_net_pnl /
            len(trades)
        )
    else:
        win_rate = 0.0
        average_trade = 0.0

    return {
        "starting_capital": starting_capital,
        "ending_capital": capital,
        "total_net_pnl": total_net_pnl,
        "total_commission": total_commission,
        "total_slippage": total_slippage,
        "return_pct": (
            (capital - starting_capital) /
            starting_capital * 100
        ),
        "trades": trades,
        "trade_count": len(trades),
        "wins": len(wins),
        "losses": len(losses),
        "win_rate": win_rate,
        "gross_profit": gross_profit,
        "gross_loss": gross_loss,
        "profit_factor": profit_factor,
        "average_trade": average_trade,
        "max_drawdown_pct": max_drawdown,
        "timeline": timeline,
        "equity_curve": equity_curve,
    }


def run_backtest_integrity_tests(backtest, df):
    print()
    print("=" * 70)
    print("BACKTEST INTEGRITY TESTS")
    print("=" * 70)
    print()

    passed = 0
    total = 0

    def test(name, condition):
        nonlocal passed, total
        total += 1
        if condition:
            print(f"[PASS] {name}")
            passed += 1
        else:
            print(f"[FAIL] {name}")

    trades = backtest["trades"]
    timeline = backtest["timeline"]

    test(
        "No trade uses future entry beyond dataset",
        all(
            trade["entry_index"] < len(df)
            for trade in trades
        ),
    )

    test(
        "All entries occur one bar after signal",
        all(
            trade["entry_index"] == trade["signal_index"] + 1
            for trade in trades
        ),
    )

    test(
        "Trade prices are positive",
        all(
            trade["entry_price"] > 0
            and trade["exit_price"] > 0
            for trade in trades
        ),
    )

    test(
        "No weekend candles remain in backtest dataset",
        (
            not EXCLUDE_WEEKEND_SESSIONS
            or not (df["begin"].dt.weekday >= 5).any()
        ),
    )

    test(
        "No overlapping trades",
        all(
            trades[i]["exit_index"] <= trades[i + 1]["entry_index"]
            for i in range(len(trades) - 1)
        ),
    )

    test(
        "Timeline is chronological",
        [item["index"] for item in timeline]
        == sorted(item["index"] for item in timeline),
    )

    test(
        "Timeline covers every backtest bar exactly once",
        [item["index"] for item in timeline]
        == list(range(len(df))),
    )

    def exit_index_is_valid(trade):
        # Normal exits must occur strictly after entry.
        if trade["exit_index"] > trade["entry_index"]:
            return True

        # A forced session/data-end exit may legitimately occur on the
        # same bar as entry when the position is opened on the final bar
        # available in that session/dataset. This is a close at the current
        # bar close, not a future-bar action and does not cross sessions.
        if trade["exit_index"] != trade["entry_index"]:
            return False
        if trade["reason"] not in {"END_OF_SESSION", "END_OF_DATA"}:
            return False

        idx = trade["exit_index"]
        if idx < 0 or idx >= len(df):
            return False
        if trade["reason"] == "END_OF_DATA":
            return idx == len(df) - 1
        if idx == len(df) - 1:
            return True
        return (
            trading_session_key(df.iloc[idx]["begin"])
            != trading_session_key(df.iloc[idx + 1]["begin"])
        )

    test(
        "Trade exits are valid relative to entries",
        all(exit_index_is_valid(trade) for trade in trades),
    )

    test(
        "No entry crosses into a new trading session",
        all(
            trading_session_key(df.iloc[trade["signal_index"]]["begin"])
            == trading_session_key(df.iloc[trade["entry_index"]]["begin"])
            for trade in trades
        ),
    )

    test(
        "No position crosses an MOEX trading-session boundary",
        all(
            trading_session_key(
                df.iloc[trade["entry_index"]]["begin"]
            )
            == trading_session_key(
                df.iloc[trade["exit_index"]]["begin"]
            )
            for trade in trades
        ),
    )

    test(
        "Timeline session keys are chronological",
        [item["session_key"] for item in timeline]
        == sorted(item["session_key"] for item in timeline),
    )

    test(
        "Trade sequence is chronological",
        all(
            trades[i]["entry_index"] < trades[i + 1]["entry_index"]
            for i in range(len(trades) - 1)
        ),
    )

    test(
        "Diagnostics fields exist on every trade",
        all(
            "signal_event" in trade
            and "signal_event_strength_score" in trade
            and "signal_atr14" in trade
            and "signal_volume_ratio" in trade
            and "entry_to_signal_level_distance" in trade
            and "holding_bars" in trade
            and "mfe_price" in trade
            and "mae_price" in trade
            and "structure_events_during_trade" in trade
            for trade in trades
        ),
    )

    test(
        "Diagnostic MFE/MAE are finite when diagnostics are enabled",
        (
            not BACKTEST_DIAGNOSTICS
            or all(
                np.isfinite(float(trade["mfe_price"]))
                and np.isfinite(float(trade["mae_price"]))
                for trade in trades
            )
        ),
    )

    test(
        "Diagnostic holding bars match entry/exit indexes",
        all(
            trade["holding_bars"]
            == trade["exit_index"] - trade["entry_index"]
            for trade in trades
        ),
    )

    test(
        "Diagnostic structure events are strictly after signal",
        all(
            all(
                event["index"] > trade["signal_index"]
                and event["index"] <= (
                    trade["exit_index"]
                    if trade["reason"] in {"END_OF_SESSION", "END_OF_DATA"}
                    else trade["exit_index"] - 1
                )
                for event in trade["structure_events_during_trade"]
            )
            for trade in trades
        ),
    )

    test(
        "Backtest remains research-only",
        True,
    )

    print()
    print("-" * 70)
    print(f"RESULT: {passed}/{total} PASS")

    if passed == total:
        print("BACKTEST INTEGRITY: OK")
        result = True
    else:
        print("BACKTEST INTEGRITY: FAILED")
        result = False

    print("=" * 70)
    print()
    return result




# ============================================================
# MANAGED TRADE ENGINE v5.6
# ============================================================

def _managed_event_key(event):
    return (
        event.get("index"),
        event.get("event"),
        event.get("direction"),
        event.get("level"),
    )


def _latest_confirmed_swing(swings, current_index, session_key,
                             df, direction, after_index=None):
    """Return the latest causal confirmed global-index swing."""
    candidate = None
    for swing in swings:
        confirmation_index = int(swing["confirmation_index"])
        swing_index = int(swing["index"])
        if confirmation_index > current_index:
            continue
        if confirmation_index < 0 or confirmation_index >= len(df):
            continue
        if after_index is not None and swing["index"] <= after_index:
            continue
        if trading_session_key(df.iloc[confirmation_index]["begin"]) != session_key:
            continue
        if candidate is None or confirmation_index > int(candidate["confirmation_index"]):
            candidate = swing
    return candidate


def run_managed_backtest(df, highs, lows):
    """
    Conservative v5.6 trade management on the exact v5.5 entries.

    Entry logic is untouched. Management uses only information known at
    the current closed 5M bar. Trailing/reversal conditions trigger an
    exit on the next 5M bar open. Session-end and final-data exits remain
    forced exits on the current bar close.
    """
    if len(df) < 2:
        raise RuntimeError("Not enough candles for managed backtest")

    timeline = build_signal_timeline(df, highs, lows)
    capital = float(BACKTEST_INITIAL_CAPITAL)
    starting_capital = capital
    position = None
    trades = []
    equity_curve = []

    def open_position(side, signal_index):
        nonlocal capital
        next_index = signal_index + 1
        if next_index >= len(df):
            return None

        raw_price = float(df.iloc[next_index]["open"])
        fill_price = apply_slippage(raw_price, side, True)
        if fill_price <= 0:
            raise RuntimeError("Invalid managed backtest entry price")

        allocation = capital * BACKTEST_POSITION_SIZE_PCT / 100.0
        if allocation <= 0:
            raise RuntimeError("Non-positive managed backtest allocation")

        quantity = allocation / fill_price
        entry_notional = quantity * fill_price
        entry_commission = commission_for_notional(entry_notional)
        capital -= entry_commission

        item = timeline[signal_index]
        signal_event = item.get("signal_event")
        signal_strength = (
            signal_event.get("strength")
            if signal_event is not None else None
        )
        signal_atr = item.get("atr14", np.nan)
        if pd.isna(signal_atr) or float(signal_atr) <= 0:
            signal_atr = np.nan

        return {
            "side": side,
            "signal_index": signal_index,
            "signal_time": item["time"],
            "signal_technical_score": item["technical_score"],
            "signal_technical_state": item["technical_state"],
            "signal_structure_state": item["structure_state"],
            "signal_current_trend": item["current_trend"],
            "signal_event": signal_event.copy() if signal_event is not None else None,
            "signal_event_strength": signal_strength,
            "signal_atr14": signal_atr,
            "signal_volume_ratio": item.get("volume_ratio", np.nan),
            "entry_index": next_index,
            "entry_time": df.iloc[next_index]["begin"],
            "entry_price": fill_price,
            "raw_entry_price": raw_price,
            "quantity": quantity,
            "entry_commission": entry_commission,
            "management_active": False,
            "activation_index": None,
            "activation_time": None,
            "trail_level": None,
            "max_favorable_close": fill_price,
            "tightened": False,
            "reversal_warning_index": None,
            "reversal_warning_time": None,
            "reversal_warning_level": None,
            "management_events": [],
            "last_management_index": signal_index,
        }

    def close_position(pos, condition_index, reason, forced_exit_index=None):
        nonlocal capital
        if forced_exit_index is not None:
            exit_index = int(forced_exit_index)
            raw_price = float(df.iloc[exit_index]["close"])
        else:
            exit_index = int(condition_index) + 1
            if exit_index >= len(df):
                # No next bar exists. Preserve the same terminal-bar
                # semantics as the ordinary backtest: realize the exit
                # on the final bar close instead of crashing.
                exit_index = len(df) - 1
                raw_price = float(df.iloc[exit_index]["close"])
            else:
                raw_price = float(df.iloc[exit_index]["open"])

        exit_price = apply_slippage(raw_price, pos["side"], False)
        quantity = pos["quantity"]
        entry_price = pos["entry_price"]
        raw_entry_price = float(pos.get("raw_entry_price", entry_price))
        entry_slippage_cost = abs(entry_price - raw_entry_price) * quantity
        exit_slippage_cost = abs(exit_price - raw_price) * quantity
        if pos["side"] == "LONG":
            gross_pnl = (exit_price - entry_price) * quantity
        else:
            gross_pnl = (entry_price - exit_price) * quantity

        exit_notional = quantity * exit_price
        exit_commission = commission_for_notional(exit_notional)
        net_pnl = gross_pnl - pos["entry_commission"] - exit_commission
        capital += gross_pnl
        capital -= exit_commission

        diagnostic_end_index = exit_index if forced_exit_index is not None else condition_index
        diagnostic_end_index = max(diagnostic_end_index, pos["entry_index"])
        mfe = 0.0
        mae = 0.0
        for mark_index in range(pos["entry_index"], diagnostic_end_index + 1):
            bar = df.iloc[mark_index]
            hi = float(bar["high"]); lo = float(bar["low"])
            if pos["side"] == "LONG":
                fav = hi - entry_price; adv = lo - entry_price
            else:
                fav = entry_price - lo; adv = entry_price - hi
            mfe = max(mfe, fav); mae = min(mae, adv)

        signal_event = pos.get("signal_event")
        signal_level = (
            float(signal_event["level"])
            if signal_event is not None and signal_event.get("level") is not None
            else np.nan
        )
        entry_distance = abs(entry_price - signal_level) if not pd.isna(signal_level) else np.nan
        signal_atr = pos.get("signal_atr14", np.nan)
        entry_distance_atr = (
            entry_distance / float(signal_atr)
            if not pd.isna(signal_atr) and float(signal_atr) > 0 and not pd.isna(entry_distance)
            else np.nan
        )

        trade_events = []
        for item in timeline:
            idx = item["index"]
            if pos["entry_index"] <= idx <= diagnostic_end_index:
                for event in item.get("events_snapshot", []):
                    if event["index"] > pos["signal_index"] and event["index"] <= diagnostic_end_index:
                        trade_events.append(event)
        unique_events = []
        seen = set()
        for event in trade_events:
            key = _managed_event_key(event)
            if key not in seen:
                seen.add(key); unique_events.append(event)

        realized_favorable = (
            (exit_price - entry_price) if pos["side"] == "LONG"
            else (entry_price - exit_price)
        )
        mfe_capture = (realized_favorable / mfe) if mfe > 0 else np.nan

        return {
            "side": pos["side"],
            "entry_time": pos["entry_time"],
            "exit_time": df.iloc[exit_index]["begin"],
            "entry_price": entry_price,
            "exit_price": exit_price,
            "quantity": quantity,
            "gross_pnl": gross_pnl,
            "entry_commission": pos["entry_commission"],
            "exit_commission": exit_commission,
            "total_commission": pos["entry_commission"] + exit_commission,
            "entry_slippage_cost": entry_slippage_cost,
            "exit_slippage_cost": exit_slippage_cost,
            "total_slippage_cost": entry_slippage_cost + exit_slippage_cost,
            "net_pnl": net_pnl,
            "return_pct": net_pnl / (entry_price * quantity) * 100,
            "reason": reason,
            "signal_index": pos["signal_index"],
            "entry_index": pos["entry_index"],
            "exit_condition_index": condition_index,
            "exit_index": exit_index,
            "signal_time": pos.get("signal_time"),
            "technical_score_at_signal": pos.get("signal_technical_score"),
            "technical_state_at_signal": pos.get("signal_technical_state"),
            "structure_state_at_signal": pos.get("signal_structure_state"),
            "trend_at_signal": pos.get("signal_current_trend"),
            "signal_event": signal_event.copy() if signal_event is not None else None,
            "signal_event_type": signal_event.get("event") if signal_event is not None else None,
            "signal_event_direction": signal_event.get("direction") if signal_event is not None else None,
            "signal_event_level": signal_level,
            "signal_event_strength_score": (
                signal_event.get("strength", {}).get("score")
                if signal_event is not None and signal_event.get("strength") is not None
                else np.nan
            ),
            "signal_atr14": pos.get("signal_atr14", np.nan),
            "signal_volume_ratio": pos.get("signal_volume_ratio", np.nan),
            "entry_to_signal_level_distance": entry_distance,
            "entry_to_signal_level_atr": entry_distance_atr,
            "holding_bars": exit_index - pos["entry_index"],
            "mfe_price": mfe,
            "mae_price": mae,
            "mfe_money": mfe * quantity,
            "mae_money": mae * quantity,
            "mfe_pct_of_entry": mfe / entry_price * 100 if entry_price > 0 else 0.0,
            "mae_pct_of_entry": mae / entry_price * 100 if entry_price > 0 else 0.0,
            "mfe_capture_ratio": mfe_capture,
            "management_active": pos["management_active"],
            "activation_index": pos["activation_index"],
            "activation_time": pos["activation_time"],
            "final_trail_level": pos["trail_level"],
            "tightened": pos["tightened"],
            "reversal_warning_index": pos["reversal_warning_index"],
            "reversal_warning_time": pos["reversal_warning_time"],
            "reversal_warning_level": pos["reversal_warning_level"],
            "management_events": list(pos["management_events"]),
            "structure_events_during_trade": unique_events,
        }

    session_keys = build_session_keys(df)

    for item in timeline:
        i = item["index"]
        signal = item["signal"]

        if position is not None and i > 0 and session_keys.iloc[i] != session_keys.iloc[i - 1]:
            trade = close_position(position, i - 1, "END_OF_SESSION", forced_exit_index=i - 1)
            trades.append(trade); position = None

        if position is not None:
            side = position["side"]
            current_close = float(df.iloc[i]["close"])
            signal_atr = position.get("signal_atr14", np.nan)
            if pd.isna(signal_atr) or float(signal_atr) <= 0:
                signal_atr = float(df.iloc[i].get("atr14", np.nan))
            if pd.isna(signal_atr) or float(signal_atr) <= 0:
                signal_atr = np.nan

            favorable_close = (current_close - position["entry_price"] if side == "LONG"
                               else position["entry_price"] - current_close)
            position["max_favorable_close"] = max(position["max_favorable_close"], favorable_close + position["entry_price"])

            # 1. Activation after +0.50 ATR.
            if (not position["management_active"] and not pd.isna(signal_atr)
                    and favorable_close >= MANAGED_TRAILING_ACTIVATION_ATR * float(signal_atr)):
                position["management_active"] = True
                position["activation_index"] = i
                position["activation_time"] = df.iloc[i]["begin"]
                position["management_events"].append({"index": i, "event": "TRAIL_ACTIVATED", "atr": float(signal_atr)})

            # 2. Reversal warning/confirmation from already-confirmed structure events.
            if MANAGED_REVERSAL_EXIT_ENABLED:
                new_events = []
                for event in item.get("events_snapshot", []):
                    if event["index"] <= position["signal_index"]:
                        continue
                    if event["index"] > i:
                        continue
                    key = _managed_event_key(event)
                    if key not in {_managed_event_key(x) for x in position["management_events"] if "event" in x and x.get("event") in {"CHOCH", "REVERSAL_CONFIRMED"}}:
                        new_events.append(event)
                for event in new_events:
                    opposite = (side == "LONG" and event.get("direction") == "DOWN") or (side == "SHORT" and event.get("direction") == "UP")
                    if not opposite:
                        continue
                    if event.get("event") == "CHOCH":
                        position["reversal_warning_index"] = event["index"]
                        position["reversal_warning_time"] = event["time"]
                        position["reversal_warning_level"] = event.get("level")
                        position["management_events"].append(event.copy())
                    elif event.get("event") == "REVERSAL_CONFIRMED":
                        if (not MANAGED_REVERSAL_CONFIRMATION_ONLY) or position["reversal_warning_index"] is not None:
                            trade = close_position(position, i, "STRUCTURAL_REVERSAL")
                            trades.append(trade); position = None
                            break
                        position["management_events"].append(event.copy())

            if position is not None and position["management_active"]:
                atr_now = float(df.iloc[i].get("atr14", np.nan)) if not pd.isna(df.iloc[i].get("atr14", np.nan)) else float(signal_atr) if not pd.isna(signal_atr) else np.nan
                if not pd.isna(atr_now) and atr_now > 0:
                    tightened = favorable_close >= MANAGED_TIGHTEN_ATR * float(signal_atr) if not pd.isna(signal_atr) else False
                    if tightened and not position["tightened"]:
                        position["tightened"] = True
                        position["management_events"].append({"index": i, "event": "TRAIL_TIGHTENED", "atr": atr_now})
                    mult = MANAGED_TIGHT_TRAIL_ATR if position["tightened"] else MANAGED_INITIAL_TRAIL_ATR
                    if side == "LONG":
                        highest_close = max(float(df.iloc[j]["close"]) for j in range(position["activation_index"], i + 1))
                        atr_stop = highest_close - mult * atr_now
                        swing = _latest_confirmed_swing(lows, i, session_keys.iloc[i], df, "LOW", after_index=position["entry_index"])
                        structure_stop = (swing["price"] - MANAGED_STRUCTURE_BUFFER_ATR * atr_now) if swing is not None else -np.inf
                        candidate = max(atr_stop, structure_stop)
                        if position["trail_level"] is None or candidate > position["trail_level"]:
                            position["trail_level"] = candidate
                        if position["trail_level"] is not None and current_close < position["trail_level"] - PRICE_EPSILON:
                            trade = close_position(position, i, "TRAILING_STOP")
                            trades.append(trade); position = None
                    else:
                        lowest_close = min(float(df.iloc[j]["close"]) for j in range(position["activation_index"], i + 1))
                        atr_stop = lowest_close + mult * atr_now
                        swing = _latest_confirmed_swing(highs, i, session_keys.iloc[i], df, "HIGH", after_index=position["entry_index"])
                        structure_stop = (swing["price"] + MANAGED_STRUCTURE_BUFFER_ATR * atr_now) if swing is not None else np.inf
                        candidate = min(atr_stop, structure_stop)
                        if position["trail_level"] is None or candidate < position["trail_level"]:
                            position["trail_level"] = candidate
                        if position["trail_level"] is not None and current_close > position["trail_level"] + PRICE_EPSILON:
                            trade = close_position(position, i, "TRAILING_STOP")
                            trades.append(trade); position = None

        if position is not None:
            if ((position["side"] == "LONG" and signal == "SELL") or
                (position["side"] == "SHORT" and signal == "BUY")) and i > position["signal_index"]:
                trade = close_position(position, i, "OPPOSITE_SIGNAL")
                trades.append(trade); position = None

        if position is None and signal in {"BUY", "SELL"}:
            next_index = i + 1
            if (
                REJECT_CROSS_SESSION_ENTRIES
                and next_index < len(df)
                and trading_session_key(df.iloc[next_index]["begin"])
                != trading_session_key(df.iloc[i]["begin"])
            ):
                # A signal at the final bar of a session has no valid
                # same-session next-open fill. Do not enter the next session.
                continue
            side = "LONG" if signal == "BUY" else "SHORT"
            new_position = open_position(side, i)
            if new_position is not None:
                position = new_position

        equity = capital
        if position is not None:
            mark = float(df.iloc[i]["close"])
            unrealized = ((mark - position["entry_price"]) * position["quantity"]
                          if position["side"] == "LONG"
                          else (position["entry_price"] - mark) * position["quantity"])
            equity += unrealized
        equity_curve.append({"index": i, "time": df.iloc[i]["begin"], "equity": equity})

    if position is not None and BACKTEST_CLOSE_OPEN_POSITION_AT_END:
        last_index = len(df) - 1
        trade = close_position(position, last_index, "END_OF_DATA", forced_exit_index=last_index)
        trades.append(trade); position = None
        equity_curve[-1]["equity"] = capital

    values = [item["equity"] for item in equity_curve]
    running_peak = values[0] if values else starting_capital
    max_drawdown = 0.0
    for value in values:
        running_peak = max(running_peak, value)
        if running_peak > 0:
            max_drawdown = min(max_drawdown, (value - running_peak) / running_peak * 100)

    wins = [t for t in trades if t["net_pnl"] > 0]
    losses = [t for t in trades if t["net_pnl"] < 0]
    gross_profit = sum(t["net_pnl"] for t in wins)
    gross_loss = abs(sum(t["net_pnl"] for t in losses))
    profit_factor = gross_profit / gross_loss if gross_loss > 0 else (np.inf if gross_profit > 0 else 0.0)
    total_net = sum(t["net_pnl"] for t in trades)
    total_commission = sum(t.get("total_commission", 0.0) for t in trades)
    total_slippage = sum(t.get("total_slippage_cost", 0.0) for t in trades)

    return {
        "starting_capital": starting_capital,
        "ending_capital": capital,
        "total_net_pnl": total_net,
        "total_commission": total_commission,
        "total_slippage": total_slippage,
        "return_pct": (capital - starting_capital) / starting_capital * 100,
        "trades": trades,
        "trade_count": len(trades),
        "wins": len(wins),
        "losses": len(losses),
        "win_rate": len(wins) / len(trades) * 100 if trades else 0.0,
        "gross_profit": gross_profit,
        "gross_loss": gross_loss,
        "profit_factor": profit_factor,
        "average_trade": total_net / len(trades) if trades else 0.0,
        "max_drawdown": max_drawdown,
        "timeline": timeline,
    }


def run_managed_backtest_integrity_tests(backtest, df):
    print()
    print("=" * 70)
    print("MANAGED BACKTEST INTEGRITY TESTS")
    print("=" * 70)
    print()
    passed = 0; total = 0
    def test(name, condition):
        nonlocal passed, total
        total += 1
        print(f"[{'PASS' if condition else 'FAIL'}] {name}")
        if condition: passed += 1
    trades = backtest["trades"]; timeline = backtest["timeline"]
    test("No future entry beyond dataset", all(t["entry_index"] < len(df) for t in trades))
    test("All entries occur one bar after signal", all(t["entry_index"] == t["signal_index"] + 1 for t in trades))
    def managed_exit_index_is_valid(trade):
        if trade["exit_index"] > trade["entry_index"]:
            return True
        if trade["exit_index"] != trade["entry_index"]:
            return False
        if trade["reason"] not in {"END_OF_SESSION", "END_OF_DATA"}:
            return False
        idx = trade["exit_index"]
        if idx < 0 or idx >= len(df):
            return False
        if trade["reason"] == "END_OF_DATA":
            return idx == len(df) - 1
        if idx == len(df) - 1:
            return True
        return (
            trading_session_key(df.iloc[idx]["begin"])
            != trading_session_key(df.iloc[idx + 1]["begin"])
        )

    test("All exits are valid relative to entries", all(managed_exit_index_is_valid(t) for t in trades))
    test("No entry crosses session boundary", all(trading_session_key(df.iloc[t["signal_index"]]["begin"]) == trading_session_key(df.iloc[t["entry_index"]]["begin"]) for t in trades))
    test("Non-forced exits execute on next bar", all(t["exit_index"] == t["exit_condition_index"] + 1 for t in trades if t["reason"] not in {"END_OF_SESSION", "END_OF_DATA"}))
    test("No session boundary crossing", all(trading_session_key(df.iloc[t["entry_index"]]["begin"]) == trading_session_key(df.iloc[t["exit_index"]]["begin"]) for t in trades))
    test("No overlapping trades", all(trades[i]["exit_index"] <= trades[i+1]["entry_index"] for i in range(len(trades)-1)))
    test("Timeline covers every bar", [x["index"] for x in timeline] == list(range(len(df))))
    test("No weekend candles", not EXCLUDE_WEEKEND_SESSIONS or not (df["begin"].dt.weekday >= 5).any())
    test("Trailing activation is never before entry", all(t["activation_index"] is None or t["activation_index"] >= t["entry_index"] for t in trades))
    test("Trailing levels are finite when present", all(t["final_trail_level"] is None or np.isfinite(float(t["final_trail_level"])) for t in trades))
    test("MFE/MAE are finite", all(np.isfinite(float(t["mfe_price"])) and np.isfinite(float(t["mae_price"])) for t in trades))
    test("Holding bars match indexes", all(t["holding_bars"] == t["exit_index"] - t["entry_index"] for t in trades))
    test("Management is research-only", True)
    print(); print("-" * 70); print(f"RESULT: {passed}/{total} PASS")
    print("MANAGED BACKTEST INTEGRITY: OK" if passed == total else "MANAGED BACKTEST INTEGRITY: FAILED")
    print("=" * 70); print()
    return passed == total


def print_managed_backtest_report(backtest):
    print()
    print("MANAGED BACKTEST v5.6 / COST MODEL v5.9.2:")
    print()
    print(f"Period {DATE_FROM} -> {DATE_TILL}")
