def _print_v576_group(work, side, label, mask):
    g = work.loc[mask.fillna(False)] if hasattr(mask, "fillna") else work
    g = g[g["signal"].eq(side)]
    if g.empty:
        print(f"{label:<38} N=0")
        return
    print(
        f"{label:<38} N={len(g):>3} | "
        f"h3={_format_stat(_safe_mean(g['label_forward_return_3']))} | "
        f"h6={_format_stat(_safe_mean(g['label_forward_return_6']))} | "
        f"h12={_format_stat(_safe_mean(g['label_forward_return_12']))} | "
        f"MFE6={_format_stat(_safe_mean(g['diag_directional_mfe_6']))} | "
        f"MAE6={_format_stat(_safe_mean(g['diag_directional_mae_6']))}"
    )


def print_v576_consolidated_research_report(signal_rows, df):
    """v5.7.6 consolidated research report; descriptive only.

    This report does not create, tune, filter, rank, or alter trading signals.
    Forward labels are outcomes and are never used by the strategy engine.
    """
    print()
    print("=" * 70)
    print("v5.7.6 CONSOLIDATED RESEARCH / CONTEXT REVIEW")
    print("=" * 70)
    print("STRATEGY LOGIC: UNCHANGED")
    print("Purpose: consolidate v5.7.3-v5.7.5 evidence before any future filter research.")
    print()

    unique_events = _research_unique_signal_events(signal_rows)
    unique_events = _attach_directional_forward_stats(unique_events, df, horizon=6)
    work = _build_v575_event_anatomy(unique_events)

    print(f"Actionable signal rows: {len(signal_rows)}")
    print(f"Unique BOS event occurrences: {len(work)}")
    print(f"BUY unique events: {(work['signal'] == 'BUY').sum()} | SELL unique events: {(work['signal'] == 'SELL').sum()}")

    if work.empty:
        print("No unique events available.")
        return

    # ------------------------------------------------------------
    # 1. Coverage / sample warning
    # ------------------------------------------------------------
    print()
    print("SAMPLE / COVERAGE")
    print("-" * 110)
    print("These statistics are descriptive research, not validated strategy rules.")
    print("Small event counts, especially SELL, are insufficient for parameter selection.")

    for side in ["BUY", "SELL"]:
        s = work[work["signal"].eq(side)]
        if s.empty:
            continue
        valid_h6 = pd.to_numeric(s["label_forward_return_6"], errors="coerce").dropna()
        positive = (valid_h6 > 0).sum()
        print(
            f"{side}: N={len(s)} | valid h6={len(valid_h6)} | "
            f"positive h6 outcomes={positive}/{len(valid_h6)}"
        )

    # ------------------------------------------------------------
    # 2. Direct feature evidence
    # ------------------------------------------------------------
    print()
    print("DIRECT CONTEXT EVIDENCE — CORRELATION VS DIRECTIONAL h6")
    print("-" * 110)
    corr_cols = [
        ("entry_distance_ATR", "anat_distance_atr"),
        ("pre_move_3", "anat_premove3"),
        ("pre_move_6", "anat_premove6"),
        ("pre_move_12", "anat_premove12"),
