    # ------------------------------------------------------------
    print()
    print("RESEARCH TAKEAWAYS — NON-ACTIONABLE")
    print("-" * 110)
    print("1. Entry geometry, pre-move, candle range and participation repeatedly appear in the event-level diagnostics.")
    print("2. The observed relationships are not uniformly monotonic; combinations matter more than a single feature in this sample.")
    print("3. Directional MFE/MAE shows that several failed events still produced intratrade favourable movement before reversing.")
    print("4. SELL evidence remains too sparse for a reliable context conclusion.")
    print("5. No threshold, filter, delay, score, ranking, or signal modification is introduced by v5.7.6.")
