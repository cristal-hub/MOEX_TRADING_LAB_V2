# ============================================================
# DATA ENGINE
# ============================================================

def _cache_root():
    """Return a deterministic cache directory next to this script."""
    base = Path(__file__).resolve().parent if "__file__" in globals() else Path.cwd()
    root = base / CACHE_DIR
    (root / CACHE_1M_DIRNAME).mkdir(parents=True, exist_ok=True)
    (root / CACHE_5M_DIRNAME).mkdir(parents=True, exist_ok=True)
    return root


def _cache_safe_name(value):
    return str(value).replace("/", "_").replace("\\", "_").replace(":", "-")


def _validate_1m_frame(df, source_label="1m data"):
    required = [
        "begin", "end", "open", "high", "low", "close", "volume", "value"
    ]

    for column in required:
        if column not in df.columns:
            raise RuntimeError(
                f"Required column missing from {source_label}: {column}"
            )

    df = df.copy()
    df["begin"] = pd.to_datetime(df["begin"])
    df["end"] = pd.to_datetime(df["end"])

    numeric_columns = ["open", "high", "low", "close", "volume", "value"]
    for column in numeric_columns:
        df[column] = pd.to_numeric(df[column], errors="coerce")

    if df[numeric_columns].isna().any().any():
        raise RuntimeError(f"NaN detected in {source_label}")

    if (df["high"] < df["low"]).any():
        raise RuntimeError(f"Invalid OHLC data in {source_label}: high < low")

    if (df["volume"] < 0).any():
        raise RuntimeError(f"Invalid volume in {source_label}")

    if (df["close"] <= 0).any():
        raise RuntimeError(f"Invalid price in {source_label}")

    if df["begin"].duplicated().any():
        raise RuntimeError(f"Duplicate 1m candle timestamps in {source_label}")

    return df.sort_values("begin").reset_index(drop=True)


def _load_cached_1m_day(cache_file):
    try:
        cached = pd.read_csv(cache_file)
        cached = _validate_1m_frame(cached, f"cache {cache_file.name}")
        return cached
    except Exception as exc:
        if CACHE_VERBOSE:
            print(f"  CACHE INVALID -> {cache_file.name}: {exc}")
        return None


def download_1m_data():
    """Download 1m candles day-by-day with deterministic local caching."""
    start = pd.Timestamp(DATE_FROM)
    end = pd.Timestamp(DATE_TILL)

    if start > end:
        raise RuntimeError(f"Invalid date range: {DATE_FROM} > {DATE_TILL}")

    cache_root = _cache_root()
    frames = []
    current = start
    cache_hits = 0
    cache_misses = 0
    network_days = 0

    while current <= end:
        day = current.strftime("%Y-%m-%d")
        cache_name = (
            f"{_cache_safe_name(SECURITY)}_{_cache_safe_name(BOARD)}_"
            f"{day}_1m_v{CACHE_SCHEMA_VERSION}.csv"
        )
        cache_file = cache_root / CACHE_1M_DIRNAME / cache_name

        cached = None
        if CACHE_ENABLED and cache_file.exists():
            cached = _load_cached_1m_day(cache_file)

        if cached is not None:
            frames.append(cached)
            cache_hits += 1
            if CACHE_VERBOSE:
                print(f"  CACHE HIT 1M  {day}: {len(cached)} candles")
        else:
            cache_misses += 1
            params = {
                "interval": 1,
                "from": day,
                "till": day,
                "iss.meta": "off",
            }

            if CACHE_VERBOSE:
                print(f"  DOWNLOAD 1M {day} ...")

            response = requests.get(API_URL, params=params, timeout=20)
            response.raise_for_status()

            data = response.json()
            candles = data.get("candles", {})
            columns = candles.get("columns", [])
            rows = candles.get("data", [])

            if rows:
                downloaded = pd.DataFrame(rows, columns=columns)
                downloaded = _validate_1m_frame(downloaded, f"MOEX {day}")
                frames.append(downloaded)
                network_days += 1

                if CACHE_ENABLED:
                    downloaded.to_csv(cache_file, index=False)
                    if CACHE_VERBOSE:
                        print(f"  CACHE SAVE 1M {day}: {cache_file.name}")
            else:
                if CACHE_VERBOSE:
                    print(f"  NO DATA     {day}")

        current += pd.Timedelta(days=1)

    if not frames:
        raise RuntimeError(
            f"MOEX returned no candle data for {DATE_FROM} to {DATE_TILL}"
        )

    df = pd.concat(frames, ignore_index=True)
    df = _validate_1m_frame(df, "combined 1m data")

    # Cross-day cache corruption/overlap guard.
    if df["begin"].duplicated().any():
        raise RuntimeError("Duplicate 1m candle timestamps detected after cache merge")

    if len(df) < MIN_1M_CANDLES:
        raise RuntimeError(f"Too few 1m candles: {len(df)}")

    print(
        f"CACHE SUMMARY: 1M hits={cache_hits}, misses={cache_misses}, "
        f"network_days={network_days}, rows={len(df)}"
    )

    return df


def filter_weekend_sessions(df):
    """Remove Saturday/Sunday candles from the research dataset."""
    if not EXCLUDE_WEEKEND_SESSIONS:
        return df.copy(), 0

    weekend_mask = df["begin"].dt.weekday >= 5
    removed = int(weekend_mask.sum())

    filtered = (
        df.loc[~weekend_mask]
        .sort_values("begin")
        .reset_index(drop=True)
    )

    if len(filtered) < MIN_1M_CANDLES:
        raise RuntimeError(
            "Too few 1m candles after weekend filtering: "
            f"{len(filtered)}"
        )

    return filtered, removed


# ============================================================
# 1M -> 5M
# ============================================================

def _aggregate_5m_uncached(df):
    work = df.copy()
    work = work.set_index("begin")

    result = (
        work
        .resample("5min", label="left", closed="left")
        .agg({
            "open": "first",
            "high": "max",
            "low": "min",
            "close": "last",
            "volume": "sum",
            "value": "sum",
            "end": "last",
        })
    )

    # v5.17-V2 A6: n_1m — количество 1M свечей в каждой 5M группе.
    # Считается отдельно, т.к. после set_index("begin") колонки "begin"
    # больше нет, и agg с "begin": "count" падает.
    n_1m = (
        work
        .resample("5min", label="left", closed="left")
        .size()
        .rename("n_1m")
    )
    result = result.join(n_1m)

    result = result.dropna(subset=["open", "high", "low", "close"])
    result = result.reset_index()
    return result


def _a6_audit_5m_groups(result, source_label="5m data"):
    """
    v5.17-V2 A6: аудит 5M-групп.

    Проверяет, что каждая 5M свеча собрана ровно из 5 1M свечей.
    Исключение: последняя свеча каждой сессии может иметь n_1m < 5.

    Не меняет OHLCV. Не падает. Пишет отчёт v5.14_5m_group_audit.csv.
    """
    try:
        if "n_1m" not in result.columns:
            print()
            print("=" * 70)
            print("v5.17-V2 A6: 5M GROUP AUDIT")
            print("=" * 70)
            print(f"Source: {source_label}")
            print("n_1m column not present (loaded from cache).")
            print("Audit skipped. Delete cache 5M to force re-aggregation.")
            print("=" * 70)
            print()
            return

        work = result[["begin", "end", "open", "high", "low", "close",
                       "volume", "value", "n_1m"]].copy()
        work["begin"] = pd.to_datetime(work["begin"])
        work["session"] = work["begin"].dt.date

        # Для каждой сессии: последняя свеча — исключение из правила
        last_in_session = work.groupby("session")["begin"].transform("max")
        work["is_last_in_session"] = work["begin"] == last_in_session

        work["is_full_group"] = work["n_1m"] == 5
        work["is_incomplete"] = (~work["is_full_group"]) & (~work["is_last_in_session"])
        work["is_oversized"] = work["n_1m"] > 5
        work["is_last_incomplete"] = work["is_last_in_session"] & (~work["is_full_group"])

        out_cols = [
            "begin", "end", "open", "high", "low", "close",
            "volume", "value", "session", "n_1m",
            "is_full_group", "is_incomplete", "is_oversized",
            "is_last_in_session", "is_last_incomplete",
        ]
        out = work[out_cols].copy()
        try:
            out.to_csv("v5.14_5m_group_audit.csv", index=False)
        except Exception:
            pass

        total = len(work)
        full = int(work["is_full_group"].sum())
        incomplete = int(work["is_incomplete"].sum())
        oversized = int(work["is_oversized"].sum())
        last_incomplete = int(work["is_last_incomplete"].sum())

        print()
        print("=" * 70)
        print("v5.17-V2 A6: 5M GROUP AUDIT")
        print("=" * 70)
        print(f"Source: {source_label}")
        print(f"Total 5M candles:               {total}")
        print(f"Full groups (n_1m == 5):        {full}")
        print(f"Incomplete (not last, n_1m<5):  {incomplete}")
        print(f"Oversized (n_1m > 5):           {oversized}")
        print(f"Last-in-session incomplete:     {last_incomplete}")
        if incomplete > 0 or oversized > 0:
            print()
            print("!!! 5M GROUP INTEGRITY ISSUES FOUND !!!")
            bad = work[work["is_incomplete"] | work["is_oversized"]]
            print(bad[["begin", "n_1m", "session"]].head(20).to_string(index=False))
        else:
            print()
            print("[PASS] All non-last 5M candles contain exactly 5 x 1M.")
        print(f"CSV: v5.14_5m_group_audit.csv")
        print("=" * 70)
        print()
    except Exception as exc:
        print(f"[A6 WARN] 5M group audit failed: {type(exc).__name__}: {exc}")


def _validate_5m_frame(result, source_label="5m data"):
    required = ["begin", "end", "open", "high", "low", "close", "volume", "value"]
    for column in required:
        if column not in result.columns:
            raise RuntimeError(f"Required column missing from {source_label}: {column}")

    # v5.17-V2 A6: аудит 5M-групп (n_1m == 5 для всех, кроме последней в сессии).
    _a6_audit_5m_groups(result, source_label)

    result = result.copy()
    result["begin"] = pd.to_datetime(result["begin"])
    result["end"] = pd.to_datetime(result["end"])
    for column in ["open", "high", "low", "close", "volume", "value"]:
        result[column] = pd.to_numeric(result[column], errors="coerce")

    if result[["open", "high", "low", "close", "volume", "value"]].isna().any().any():
        raise RuntimeError(f"NaN detected in {source_label}")
    if result["begin"].duplicated().any():
        raise RuntimeError(f"Duplicate 5m candle timestamps in {source_label}")
    if (result["high"] < result["low"]).any():
        raise RuntimeError(f"Invalid 5m OHLC data in {source_label}")
    if (result["volume"] < 0).any():
        raise RuntimeError(f"Invalid 5m volume in {source_label}")
    if (result["close"] <= 0).any():
        raise RuntimeError(f"Invalid 5m price in {source_label}")

    result = result.sort_values("begin").reset_index(drop=True)
    if len(result) < MIN_5M_CANDLES:
        raise RuntimeError(f"Too few 5m candles: {len(result)}")
    return result


def aggregate_5m(df):
    """Aggregate 1m data to 5m with a deterministic range-keyed cache."""
    cache_root = _cache_root()
    cache_name = (
        f"{_cache_safe_name(SECURITY)}_{_cache_safe_name(BOARD)}_"
        f"{DATE_FROM}_{DATE_TILL}_5m_v{CACHE_SCHEMA_VERSION}.csv"
    )
    cache_file = cache_root / CACHE_5M_DIRNAME / cache_name

    if CACHE_ENABLED and cache_file.exists():
        try:
            cached = pd.read_csv(cache_file)
            cached = _validate_5m_frame(cached, f"cache {cache_file.name}")
            print(f"CACHE HIT 5M: {len(cached)} candles -> {cache_file.name}")
            return cached
        except Exception as exc:
            if CACHE_VERBOSE:
                print(f"  CACHE INVALID 5M -> {cache_file.name}: {exc}")

    result = _aggregate_5m_uncached(df)
    result = _validate_5m_frame(result, "aggregated 5m data")

    if CACHE_ENABLED:
        result.to_csv(cache_file, index=False)
        print(f"CACHE SAVE 5M: {len(result)} candles -> {cache_file.name}")

    return result


# ============================================================
# INDICATORS
# ============================================================

def calculate_indicators(df):

    df = df.copy()

    close = df["close"]

    df["ema9"] = (
        close
        .ewm(
            span=9,
            adjust=False,
        )
        .mean()
    )

    df["ema21"] = (
        close
        .ewm(
            span=21,
            adjust=False,
        )
        .mean()
    )

    df["ema50"] = (
        close
        .ewm(
            span=50,
            adjust=False,
        )
        .mean()
    )

    # --------------------------------------------------------
    # RSI 14 — Wilder style
    # --------------------------------------------------------

    delta = close.diff()

    gain = delta.clip(
        lower=0
    )

    loss = -delta.clip(
        upper=0
    )

    avg_gain = (
        gain
        .ewm(
            alpha=1 / 14,
            adjust=False,
            min_periods=14,
        )
        .mean()
    )

    avg_loss = (
        loss
        .ewm(
            alpha=1 / 14,
            adjust=False,
            min_periods=14,
        )
        .mean()
    )

    rs = (
        avg_gain /
        avg_loss.replace(
            0,
            np.nan,
        )
    )

    _rsi = (
        100 -
        (
            100 /
            (1 + rs)
        )
    )

    # --------------------------------------------------------
    # v5.17-V2 A2: mathematically correct RSI edges.
    # avg_loss == 0 and avg_gain > 0   -> RSI = 100 (no losses).
    # avg_loss == 0 and avg_gain == 0  -> RSI = 50  (no movement).
    # Strategy logic is unchanged; RSI is not part of
    # calculate_technical_score. This only affects research output
    # and makes rsi14 mathematically well defined.
    # --------------------------------------------------------
    _rsi = _rsi.mask(
        (avg_loss == 0) & (avg_gain > 0),
        100.0,
    )
    _rsi = _rsi.mask(
        (avg_loss == 0) & (avg_gain == 0),
        50.0,
    )

    df["rsi14"] = _rsi

    # --------------------------------------------------------
    # MACD
    # --------------------------------------------------------

    ema12 = (
        close
        .ewm(
            span=12,
            adjust=False,
        )
        .mean()
    )

    ema26 = (
        close
        .ewm(
            span=26,
            adjust=False,
        )
        .mean()
    )

    df["macd"] = (
        ema12 -
        ema26
    )

    df["macd_signal"] = (
        df["macd"]
        .ewm(
            span=9,
            adjust=False,
        )
        .mean()
    )

    df["macd_hist"] = (
        df["macd"] -
        df["macd_signal"]
    )

    # --------------------------------------------------------
    # VWAP
    # --------------------------------------------------------

    typical_price = (
        df["high"] +
        df["low"] +
        df["close"]
    ) / 3

    session = df["begin"].dt.date

    cumulative_value = (
        typical_price *
        df["volume"]
    ).groupby(session).cumsum()

    cumulative_volume = (
        df["volume"]
    ).groupby(session).cumsum()

    df["vwap"] = (
        cumulative_value /
        cumulative_volume.replace(
            0,
            np.nan,
        )
    )

    # --------------------------------------------------------
    # ATR 14 — Wilder
    # --------------------------------------------------------

    previous_close = close.shift(1)

    tr1 = (
        df["high"] -
        df["low"]
    )

    tr2 = (
        df["high"] -
        previous_close
    ).abs()

    tr3 = (
        df["low"] -
        previous_close
    ).abs()

    true_range = pd.concat(
        [
            tr1,
            tr2,
            tr3,
        ],
        axis=1,
    ).max(axis=1)

    df["atr14"] = (
        true_range
        .ewm(
            alpha=1 / 14,
            adjust=False,
            min_periods=14,
        )
        .mean()
    )

    # --------------------------------------------------------
    # Volume
    # --------------------------------------------------------

    df["volume_avg20"] = (
        df["volume"]
        .rolling(20)
        .mean()
    )

    df["volume_ratio"] = (
        df["volume"] /
        df["volume_avg20"].replace(
            0,
            np.nan,
        )
    )

    return df


# ============================================================
# v5.7 RESEARCH FEATURE ENGINE
# ============================================================

def _safe_ratio(numerator, denominator):
    if pd.isna(numerator) or pd.isna(denominator) or float(denominator) == 0:
        return np.nan
    return float(numerator) / float(denominator)


def build_research_features(df):
    """Build causal, bar-by-bar research features without changing strategy logic.

    Every feature at row i uses information available no later than the close
    of row i. Forward-return columns are research labels only and are never
    used by the signal/backtest engines.
    """
    work = df.copy()
    session_keys = build_session_keys(work)

    work["feature_ema9_21_spread"] = work["ema9"] - work["ema21"]
    work["feature_ema21_50_spread"] = work["ema21"] - work["ema50"]
    work["feature_close_ema21_pct"] = (work["close"] - work["ema21"]) / work["ema21"] * 100.0
    work["feature_close_ema50_pct"] = (work["close"] - work["ema50"]) / work["ema50"] * 100.0
    work["feature_ema9_slope_3"] = work["ema9"] - work["ema9"].shift(3)
    work["feature_ema21_slope_3"] = work["ema21"] - work["ema21"].shift(3)
    work["feature_ema50_slope_5"] = work["ema50"] - work["ema50"].shift(5)

    work["feature_rsi_delta_3"] = work["rsi14"] - work["rsi14"].shift(3)
    work["feature_macd_hist_delta_3"] = work["macd_hist"] - work["macd_hist"].shift(3)
    work["feature_macd_hist_atr"] = work.apply(
        lambda r: _safe_ratio(r["macd_hist"], r["atr14"]), axis=1
    )

    work["feature_vwap_distance_pct"] = (work["close"] - work["vwap"]) / work["vwap"] * 100.0
    work["feature_atr_pct_price"] = work["atr14"] / work["close"] * 100.0
    work["feature_atr_ratio_20"] = work["atr14"] / work["atr14"].rolling(20).mean()
    work["feature_volume_ratio"] = work["volume_ratio"]
    work["feature_volume_ratio_delta_3"] = work["volume_ratio"] - work["volume_ratio"].shift(3)

    candle_range = (work["high"] - work["low"]).replace(0, np.nan)
    body = (work["close"] - work["open"]).abs()
    work["feature_candle_body_pct"] = body / candle_range * 100.0
    work["feature_candle_range_atr"] = candle_range / work["atr14"]
    work["feature_upper_wick_pct"] = (
        work["high"] - work[["open", "close"]].max(axis=1)
    ) / candle_range * 100.0
    work["feature_lower_wick_pct"] = (
        work[["open", "close"]].min(axis=1) - work["low"]
    ) / candle_range * 100.0
    work["feature_return_1"] = work["close"].pct_change() * 100.0
    work["feature_return_3"] = work["close"].pct_change(3) * 100.0
    work["feature_return_6"] = work["close"].pct_change(6) * 100.0

    # Session-safe forward labels. They describe what happened later but are
    # strictly excluded from any decision feature above.
    for horizon in RESEARCH_FORWARD_HORIZONS:
        ret_col = f"label_forward_return_{horizon}"
        mfe_col = f"label_forward_mfe_{horizon}"
        mae_col = f"label_forward_mae_{horizon}"
        work[ret_col] = np.nan
        work[mfe_col] = np.nan
        work[mae_col] = np.nan

    for session_key in session_keys.drop_duplicates():
        indices = list(work.index[session_keys == session_key])
        for pos, i in enumerate(indices):
            close_now = float(work.iloc[i]["close"])
            for horizon in RESEARCH_FORWARD_HORIZONS:
                if pos + horizon >= len(indices):
                    continue
                future_indices = indices[pos + 1: pos + horizon + 1]
                final_close = float(work.iloc[future_indices[-1]]["close"])
                highs = work.iloc[future_indices]["high"].astype(float)
                lows = work.iloc[future_indices]["low"].astype(float)
                work.at[i, f"label_forward_return_{horizon}"] = (final_close / close_now - 1.0) * 100.0
                work.at[i, f"label_forward_mfe_{horizon}"] = (highs.max() / close_now - 1.0) * 100.0
                work.at[i, f"label_forward_mae_{horizon}"] = (lows.min() / close_now - 1.0) * 100.0

    work["session_key"] = session_keys
    return work


def attach_signal_context(features_df, timeline):
    """Attach causal signal/structure context to the research matrix."""
    result = features_df.copy()
    context = {}
    for item in timeline:
        event = item.get("signal_event")
        context[item["index"]] = {
            "signal": item.get("signal"),
            "technical_score": item.get("technical_score"),
            "technical_state": item.get("technical_state"),
            "structure_state": item.get("structure_state"),
            "current_trend": item.get("current_trend"),
            "signal_event_type": event.get("event") if event else None,
            "signal_event_direction": event.get("direction") if event else None,
            "signal_event_strength": (
                (event.get("strength") or {}).get("score") if event else np.nan
            ),
            "signal_event_level": event.get("level") if event else np.nan,
        }
    context_df = pd.DataFrame.from_dict(context, orient="index")
    context_df.index.name = "index"
    result = result.join(context_df, how="left")
    return result


def attach_entry_diagnostics(features_df, timeline, df):
    """Attach non-causal research diagnostics for signal/entry geometry.

    These columns intentionally use the next bar open because that is the
    actual backtest entry price. They are diagnostics only and never enter
    signal, position sizing, exit, or management decisions.
    """
    result = features_df.copy()
    session_keys = build_session_keys(df)

    result["diag_signal_event_index"] = np.nan
    result["diag_bars_since_signal_event"] = np.nan
    result["diag_signal_distance_atr"] = np.nan
    result["diag_signal_distance_pct"] = np.nan
    result["diag_entry_distance_atr"] = np.nan
    result["diag_entry_distance_pct"] = np.nan
    result["diag_pre_signal_return_3"] = np.nan
    result["diag_pre_signal_return_6"] = np.nan
    result["diag_pre_signal_return_12"] = np.nan

    for item in timeline:
        i = int(item["index"])
        if item.get("signal") not in ("BUY", "SELL"):
            continue

        event = item.get("signal_event")
        if not event or event.get("level") is None:
            continue

        event_index = int(event.get("index", i))
        level = float(event["level"])
        atr_value = df.iloc[i]["atr14"]
        atr = float(atr_value) if pd.notna(atr_value) else np.nan
        close_now = float(df.iloc[i]["close"])
        direction = 1.0 if item["signal"] == "BUY" else -1.0

        # Positive signed distance means price has moved away from the
        # structure level in the direction of the proposed trade.
        signal_distance = direction * (close_now - level)
        result.at[i, "diag_signal_event_index"] = event_index
        result.at[i, "diag_bars_since_signal_event"] = i - event_index
        result.at[i, "diag_signal_distance_pct"] = (signal_distance / level * 100.0) if level else np.nan
        result.at[i, "diag_signal_distance_atr"] = (signal_distance / atr) if pd.notna(atr) and atr != 0 else np.nan

        # Exact frozen-backtest entry convention: next bar OPEN.
        next_i = i + 1
        if next_i < len(df) and session_keys.iloc[next_i] == session_keys.iloc[i]:
            next_open = float(df.iloc[next_i]["open"])
            entry_distance = direction * (next_open - level)
            result.at[i, "diag_entry_distance_pct"] = (entry_distance / level * 100.0) if level else np.nan
            result.at[i, "diag_entry_distance_atr"] = (entry_distance / atr) if pd.notna(atr) and atr != 0 else np.nan

        # Explicit pre-signal returns for research readability.
        for horizon in (3, 6, 12):
            past_i = i - horizon
            col = f"diag_pre_signal_return_{horizon}"
            if past_i >= 0 and session_keys.iloc[past_i] == session_keys.iloc[i]:
                past_close = float(df.iloc[past_i]["close"])
                result.at[i, col] = (close_now / past_close - 1.0) * 100.0

    return result


def run_research_feature_engine(df, highs, lows):
    """Create the v5.7.3 research matrix without changing strategy logic."""
    features = build_research_features(df)
    timeline = build_signal_timeline(df, highs, lows)
    features = attach_signal_context(features, timeline)
    features = attach_entry_diagnostics(features, timeline, df)

    # Explicit audit: causal feature columns remain separate from labels and
    # non-causal entry diagnostics. Nothing here is consumed by the strategy.
    label_prefix = "label_"
    feature_columns = [c for c in features.columns if c.startswith("feature_")]
    invalid = [c for c in feature_columns if c.startswith(label_prefix)]
    if invalid:
        raise RuntimeError(f"Research feature contamination detected: {invalid}")

    if RESEARCH_EXPORT_CSV:
        features.to_csv(RESEARCH_CSV_PATH, index=False)

    signal_rows = features[features["signal"].isin(["BUY", "SELL"])].copy()
    return features, signal_rows


def _research_unique_signal_events(signal_rows):
    """Collapse repeated actionable rows onto unique BOS event occurrences.

    A single BOS can remain the latest actionable event for more than one
    timeline bar. For event-level diagnostics we therefore count each
    (session, event_index, direction, level) combination once.
    The first actionable row attached to that event is retained because it
    represents the earliest actionable observation of the event.
    """
    if signal_rows.empty:
        return signal_rows.copy()

    work = signal_rows.copy()
    # Preserve the original 5M bar position explicitly. The DataFrame index
    # is later reset for clean reporting, so downstream forward-stat code
    # must not rely on a physical ``index`` column.
    work["_source_index"] = work.index.astype(int)
    key_cols = [
        "session_key",
        "diag_signal_event_index",
        "signal_event_type",
        "signal_event_direction",
        "signal_event_level",
    ]
    for col in key_cols:
        if col not in work.columns:
            raise RuntimeError(f"Missing research event key column: {col}")

    # The research matrix keeps the source bar number as the DataFrame index;
    # it is not a physical column.  Sort by that index instead of assuming an
    # ``index`` column exists.  This preserves the earliest actionable row for
    # each unique event without changing any strategy logic.
    work = work.sort_index()
    work = work.drop_duplicates(subset=key_cols, keep="first")
    return work.reset_index(drop=True)


def _safe_mean(series):
    values = pd.to_numeric(series, errors="coerce").dropna()
    return float(values.mean()) if not values.empty else np.nan


def _safe_median(series):
    values = pd.to_numeric(series, errors="coerce").dropna()
    return float(values.median()) if not values.empty else np.nan


def _safe_win_rate(series):
    values = pd.to_numeric(series, errors="coerce").dropna()
    return float((values > 0).mean() * 100.0) if not values.empty else np.nan


def _format_stat(value, digits=3):
    if pd.isna(value):
        return "n/a"
    return f"{float(value):.{digits}f}"


def _directional_forward_mfe_mae(df, signal_index, side, horizon):
    """Calculate side-aware forward MFE/MAE from future bars.

    BUY: favorable = future high, adverse = future low.
    SELL: favorable = future low, adverse = future high.
    The horizon is constrained to the same exchange session.
    """
    if signal_index < 0 or signal_index >= len(df):
        return np.nan, np.nan

    session_keys = build_session_keys(df)
    session = session_keys.iloc[signal_index]
    future_indices = []
    for j in range(signal_index + 1, len(df)):
        if session_keys.iloc[j] != session:
            break
        future_indices.append(j)
        if len(future_indices) >= horizon:
            break

    if not future_indices:
        return np.nan, np.nan

    close_now = float(df.iloc[signal_index]["close"])
    highs = df.iloc[future_indices]["high"].astype(float)
    lows = df.iloc[future_indices]["low"].astype(float)

    if close_now <= 0:
        return np.nan, np.nan

    if side == "BUY":
        mfe = (float(highs.max()) / close_now - 1.0) * 100.0
        mae = (float(lows.min()) / close_now - 1.0) * 100.0
    elif side == "SELL":
        mfe = (1.0 - float(lows.min()) / close_now) * 100.0
        mae = (1.0 - float(highs.max()) / close_now) * 100.0
    else:
        return np.nan, np.nan

    return mfe, mae


def _attach_directional_forward_stats(signal_rows, df, horizon=6):
    """Add exact side-aware forward MFE/MAE for research reporting only."""
    work = signal_rows.copy()
    mfe_values = []
    mae_values = []

    for _, row in work.iterrows():
        mfe, mae = _directional_forward_mfe_mae(
            df,
            int(row["_source_index"]),
            str(row["signal"]),
            horizon,
        )
        mfe_values.append(mfe)
        mae_values.append(mae)

    work[f"diag_directional_mfe_{horizon}"] = mfe_values
    work[f"diag_directional_mae_{horizon}"] = mae_values
    return work


def _print_distance_bucket_table(rows, title, horizon=6):
    print()
    print(title)
    print("-" * 70)

    if rows.empty:
        print("No rows available.")
        return

    work = rows.copy()
    distance = pd.to_numeric(work["diag_entry_distance_atr"], errors="coerce")
    work = work.loc[distance.notna()].copy()
    work["_distance"] = distance.loc[work.index]

    bins = [-np.inf, 0.5, 1.0, 1.5, 2.0, 2.5, np.inf]
    labels = ["<0.5", "0.5-1.0", "1.0-1.5", "1.5-2.0", "2.0-2.5", ">2.5"]
    work["bucket"] = pd.cut(
        work["_distance"],
        bins=bins,
        labels=labels,
        right=False,
    )

    header = (
        f"{'bucket':<10} {'N':>4} {'mean h1':>10} {'mean h3':>10} "
        f"{'mean h6':>10} {'mean h12':>10} {'win h6':>9} "
        f"{'MFE6':>9} {'MAE6':>9}"
    )
    print(header)

    for bucket in labels:
        group = work.loc[work["bucket"] == bucket]
        if group.empty:
            print(f"{bucket:<10} {0:>4}")
            continue
        print(
            f"{bucket:<10} {len(group):>4} "
            f"{_format_stat(_safe_mean(group['label_forward_return_1'])):>10} "
            f"{_format_stat(_safe_mean(group['label_forward_return_3'])):>10} "
            f"{_format_stat(_safe_mean(group['label_forward_return_6'])):>10} "
            f"{_format_stat(_safe_mean(group['label_forward_return_12'])):>10} "
            f"{_format_stat(_safe_win_rate(group['label_forward_return_6']), 1):>8}% "
            f"{_format_stat(_safe_mean(group[f'diag_directional_mfe_{horizon}'])):>9} "
            f"{_format_stat(_safe_mean(group[f'diag_directional_mae_{horizon}'])):>9}"
        )


def _print_distance_quantiles(rows, side):
    print()
    print(f"{side} ENTRY-DISTANCE QUANTILES")
    print("-" * 70)
    if rows.empty:
        print("No rows available.")
        return

    work = rows.copy()
    work["_distance"] = pd.to_numeric(work["diag_entry_distance_atr"], errors="coerce")
    work = work.dropna(subset=["_distance"])
    if work.empty:
        print("No finite entry-distance observations.")
        return

    q = work["_distance"].quantile([0.10, 0.25, 0.50, 0.75, 0.90])
    for pct, value in q.items():
        print(f"Q{int(pct * 100):>2}: {value:.3f} ATR")


def _print_pre_signal_analysis(rows, side):
    print()
    print(f"{side} PRE-SIGNAL MOVEMENT ANALYSIS")
    print("-" * 70)
    if rows.empty:
        print("No rows available.")
        return

    work = rows.copy()
    direction = np.where(work["signal"] == "BUY", 1.0, -1.0)
    for horizon in (3, 6, 12):
        source = f"diag_pre_signal_return_{horizon}"
        signed_col = f"_signed_pre_{horizon}"
        work[signed_col] = pd.to_numeric(work[source], errors="coerce") * direction
        values = work[signed_col].dropna()
        outcome = pd.to_numeric(work[f"label_forward_return_{horizon}"], errors="coerce")
        mask = work[signed_col].notna() & outcome.notna()
        if values.empty or mask.sum() < 2:
            print(f"pre {horizon:>2} bars: N={len(values):>3} | insufficient data")
            continue
        corr = float(work.loc[mask, signed_col].corr(outcome.loc[mask]))
        print(
            f"pre {horizon:>2} bars: N={len(values):>3} | "
            f"mean signed move={values.mean():.3f}% | "
            f"median={values.median():.3f}% | "
            f"corr with h{horizon} outcome={corr:.3f}"
        )


def print_v573_research_report_legacy(features, signal_rows, df):
    """v5.7.3 observational lab: direct entry distance + pre-signal movement.

    This function does not modify the signal engine, backtest, managed trade
    engine, position sizing, exits, or any strategy decision. It only analyzes
    already-generated signal rows and future labels.
    """
    print()
    print("=" * 70)
    print("v5.7.3 ENTRY DISTANCE / EXHAUSTION RESEARCH")
    print("=" * 70)
    print()
    print("STRATEGY LOGIC: UNCHANGED")
    print("Purpose: observational analysis of direct entry geometry.")
    print()

    unique_events = _research_unique_signal_events(signal_rows)
    print(f"Actionable signal rows: {len(signal_rows)}")
    print(f"Unique actionable event occurrences: {len(unique_events)}")
    print(
        f"BUY unique events: {(unique_events['signal'] == 'BUY').sum()} | "
        f"SELL unique events: {(unique_events['signal'] == 'SELL').sum()}"
    )

    unique_events = _attach_directional_forward_stats(unique_events, df, horizon=6)

    for side in ("BUY", "SELL"):
        side_rows = unique_events[unique_events["signal"] == side].copy()
        _print_distance_bucket_table(
            side_rows,
            f"{side} — ENTRY DISTANCE IN ATR BUCKETS",
            horizon=6,
        )
        _print_distance_quantiles(side_rows, side)
        _print_pre_signal_analysis(side_rows, side)

    # Compact monotonicity diagnostics over the bucket means. This is not a
    # strategy verdict; it simply reports whether the observed sample slopes
    # in one direction. Small samples are explicitly shown above.
    print()
    print("DIRECT-DISTANCE DIAGNOSTIC")
    print("-" * 70)
    for side in ("BUY", "SELL"):
        side_rows = unique_events[unique_events["signal"] == side].copy()
        side_rows["_distance"] = pd.to_numeric(
            side_rows["diag_entry_distance_atr"], errors="coerce"
        )
        side_rows = side_rows.dropna(subset=["_distance"])
        if len(side_rows) < 3:
            print(f"{side}: insufficient observations for distance diagnostic (N={len(side_rows)})")
            continue
        corr = side_rows["_distance"].corr(
            pd.to_numeric(side_rows["label_forward_return_6"], errors="coerce")
        )
        print(
            f"{side}: N={len(side_rows)} | "
            f"corr(entry_distance_ATR, h6_return)="
            f"{_format_stat(corr, 3)}"
        )

    print()
    print("IMPORTANT: v5.7.3 does NOT filter, reject, delay, or alter any signal.")
    print("All forward outcomes remain research labels only.")
    print("=" * 70)
    print()



def _safe_corr(a, b):
    x = pd.to_numeric(a, errors="coerce")
    y = pd.to_numeric(b, errors="coerce")
    mask = x.notna() & y.notna()
    if mask.sum() < 3:
        return np.nan
    return float(x[mask].corr(y[mask]))


def _quantile_bucket(series, labels):
    """Create sample-relative quartile buckets without imposing strategy rules."""
    x = pd.to_numeric(series, errors="coerce")
    if x.notna().sum() < 4:
        return pd.Series(index=series.index, dtype="object")
    try:
        return pd.qcut(x, q=4, labels=labels, duplicates="drop")
    except ValueError:
        return pd.Series(index=series.index, dtype="object")


def _build_v574_context(unique_events):
    """Build observational context flags from information known at the event bar."""
    work = unique_events.copy()

    # Signed features: positive means aligned with the signal direction.
    direction = np.where(work["signal"].eq("BUY"), 1.0, -1.0)
    work["ctx_distance_atr"] = pd.to_numeric(work["diag_entry_distance_atr"], errors="coerce")
    work["ctx_pre_move_3_signed"] = pd.to_numeric(work["diag_pre_signal_return_3"], errors="coerce") * direction
    work["ctx_pre_move_6_signed"] = pd.to_numeric(work["diag_pre_signal_return_6"], errors="coerce") * direction
    work["ctx_pre_move_12_signed"] = pd.to_numeric(work["diag_pre_signal_return_12"], errors="coerce") * direction
    work["ctx_vwap_distance_signed"] = pd.to_numeric(work["feature_vwap_distance_pct"], errors="coerce") * direction
    work["ctx_ema_spread_signed"] = pd.to_numeric(work["feature_ema9_21_spread"], errors="coerce") * direction
    work["ctx_ema21_50_signed"] = pd.to_numeric(work["feature_ema21_50_spread"], errors="coerce") * direction
    work["ctx_ema9_slope_signed"] = pd.to_numeric(work["feature_ema9_slope_3"], errors="coerce") * direction
    work["ctx_rsi_delta_signed"] = pd.to_numeric(work["feature_rsi_delta_3"], errors="coerce") * direction
    work["ctx_macd_hist_signed"] = pd.to_numeric(work["feature_macd_hist_atr"], errors="coerce") * direction
    work["ctx_macd_delta_signed"] = pd.to_numeric(work["feature_macd_hist_delta_3"], errors="coerce") * direction
    work["ctx_volume_ratio"] = pd.to_numeric(work["feature_volume_ratio"], errors="coerce")
    work["ctx_candle_body_pct"] = pd.to_numeric(work["feature_candle_body_pct"], errors="coerce")
    work["ctx_candle_range_atr"] = pd.to_numeric(work["feature_candle_range_atr"], errors="coerce")
    work["ctx_upper_wick_pct"] = pd.to_numeric(work["feature_upper_wick_pct"], errors="coerce")
    work["ctx_lower_wick_pct"] = pd.to_numeric(work["feature_lower_wick_pct"], errors="coerce")
    work["ctx_strength"] = pd.to_numeric(work["signal_event_strength"], errors="coerce")

    # Binary context flags are descriptive only. Thresholds are deliberately
    # broad and are NOT used by the strategy or backtest.
    work["ctx_distance_high"] = work["ctx_distance_atr"] >= 1.5
    work["ctx_distance_low"] = work["ctx_distance_atr"] < 1.0
    work["ctx_premove_high"] = work["ctx_pre_move_6_signed"] >= 0.35
    work["ctx_premove_low"] = work["ctx_pre_move_6_signed"] < 0.35
    work["ctx_vwap_stretched"] = work["ctx_vwap_distance_signed"] >= 0.35
    work["ctx_vwap_close"] = work["ctx_vwap_distance_signed"] < 0.35
    work["ctx_trend_aligned"] = (work["ctx_ema_spread_signed"] > 0) & (work["ctx_ema21_50_signed"] > 0)
    work["ctx_trend_not_aligned"] = ~work["ctx_trend_aligned"]
    work["ctx_momentum_aligned"] = (work["ctx_rsi_delta_signed"] > 0) & (work["ctx_macd_delta_signed"] > 0)
    work["ctx_momentum_not_aligned"] = ~work["ctx_momentum_aligned"]
    work["ctx_volume_high"] = work["ctx_volume_ratio"] >= 1.5
    work["ctx_volume_normal"] = work["ctx_volume_ratio"] < 1.5
    work["ctx_range_high"] = work["ctx_candle_range_atr"] >= 1.5
    work["ctx_range_normal"] = work["ctx_candle_range_atr"] < 1.5

    work["ctx_geometry"] = np.select(
        [
            work["ctx_distance_low"] & work["ctx_premove_low"],
            work["ctx_distance_low"] & work["ctx_premove_high"],
            work["ctx_distance_high"] & work["ctx_premove_low"],
            work["ctx_distance_high"] & work["ctx_premove_high"],
        ],
        [
            "distance_low + pre_move_low",
            "distance_low + pre_move_high",
            "distance_high + pre_move_low",
            "distance_high + pre_move_high",
        ],
        default="insufficient_context",
    )

    work["ctx_exhaustion_proxy"] = (
        work["ctx_distance_high"]
        & work["ctx_premove_high"]
        & (work["ctx_vwap_stretched"] | work["ctx_range_high"])
    )
    work["ctx_confirmation_proxy"] = (
        work["ctx_distance_low"]
        & work["ctx_premove_low"]
        & work["ctx_trend_aligned"]
        & work["ctx_momentum_aligned"]
    )

    return work


def _print_context_matrix(rows, side):
    print()
    print(f"{side} — DISTANCE × PRE-SIGNAL CONTEXT")
    print("-" * 110)
    if rows.empty:
        print("No rows available.")
        return
    work = rows.copy()
    work = work[work["ctx_geometry"] != "insufficient_context"]
    if work.empty:
        print("Insufficient context observations.")
        return
    header = f"{'context':<34} {'N':>4} {'h3':>9} {'h6':>9} {'h12':>9} {'win h6':>9} {'MFE6':>9} {'MAE6':>9}"
    print(header)
    for name in [
        "distance_low + pre_move_low",
        "distance_low + pre_move_high",
        "distance_high + pre_move_low",
        "distance_high + pre_move_high",
    ]:
        g = work[work["ctx_geometry"] == name]
        if g.empty:
            print(f"{name:<34} {0:>4}")
            continue
        print(
            f"{name:<34} {len(g):>4} "
            f"{_format_stat(_safe_mean(g['label_forward_return_3'])):>9} "
            f"{_format_stat(_safe_mean(g['label_forward_return_6'])):>9} "
            f"{_format_stat(_safe_mean(g['label_forward_return_12'])):>9} "
            f"{_format_stat(_safe_win_rate(g['label_forward_return_6']), 1):>8}% "
            f"{_format_stat(_safe_mean(g['diag_directional_mfe_6'])):>9} "
            f"{_format_stat(_safe_mean(g['diag_directional_mae_6'])):>9}"
        )


def _print_context_feature_diagnostics(rows, side):
    print()
    print(f"{side} — CONTEXT FEATURE CORRELATIONS")
    print("-" * 110)
    if rows.empty:
        print("No rows available.")
        return
    outcome = pd.to_numeric(rows["label_forward_return_6"], errors="coerce")
    specs = [
        ("entry_distance_ATR", "ctx_distance_atr"),
        ("pre_move_3_signed", "ctx_pre_move_3_signed"),
        ("pre_move_6_signed", "ctx_pre_move_6_signed"),
        ("pre_move_12_signed", "ctx_pre_move_12_signed"),
        ("VWAP_distance_signed", "ctx_vwap_distance_signed"),
        ("EMA9-21_signed", "ctx_ema_spread_signed"),
        ("EMA21-50_signed", "ctx_ema21_50_signed"),
        ("EMA9_slope_signed", "ctx_ema9_slope_signed"),
        ("RSI_delta_signed", "ctx_rsi_delta_signed"),
        ("MACD_hist_ATR_signed", "ctx_macd_hist_signed"),
        ("MACD_delta_signed", "ctx_macd_delta_signed"),
        ("volume_ratio", "ctx_volume_ratio"),
        ("body_pct", "ctx_candle_body_pct"),
        ("range_ATR", "ctx_candle_range_atr"),
        ("BOS_strength", "ctx_strength"),
    ]
    print(f"{'feature':<27} {'N':>4} {'corr vs h6':>14}")
    for label, col in specs:
        n = pd.to_numeric(rows[col], errors="coerce").notna().sum()
        corr = _safe_corr(rows[col], outcome)
        print(f"{label:<27} {n:>4} {_format_stat(corr, 3):>14}")


def _print_proxy_comparison(rows, side):
    print()
    print(f"{side} — COMBINED CONTEXT PROXIES")
    print("-" * 110)
    if rows.empty:
        print("No rows available.")
        return
    for label, mask in [
        ("all events", pd.Series(True, index=rows.index)),
        ("exhaustion_proxy", rows["ctx_exhaustion_proxy"]),
        ("confirmation_proxy", rows["ctx_confirmation_proxy"]),
        ("trend_not_aligned", rows["ctx_trend_not_aligned"]),
        ("momentum_not_aligned", rows["ctx_momentum_not_aligned"]),
        ("volume_high", rows["ctx_volume_high"]),
        ("range_high", rows["ctx_range_high"]),
        ("VWAP_stretched", rows["ctx_vwap_stretched"]),
    ]:
        g = rows.loc[mask.fillna(False)] if hasattr(mask, "fillna") else rows
        if label == "all events":
            g = rows
        if g.empty:
            print(f"{label:<24} N=0")
            continue
        print(
            f"{label:<24} N={len(g):>3} | "
            f"h3={_format_stat(_safe_mean(g['label_forward_return_3']))} | "
            f"h6={_format_stat(_safe_mean(g['label_forward_return_6']))} | "
            f"h12={_format_stat(_safe_mean(g['label_forward_return_12']))} | "
            f"win_h6={_format_stat(_safe_win_rate(g['label_forward_return_6']),1)}% | "
            f"MFE6={_format_stat(_safe_mean(g['diag_directional_mfe_6']))} | "
            f"MAE6={_format_stat(_safe_mean(g['diag_directional_mae_6']))}"
        )


def print_v574_research_report(features, signal_rows, df):
    """v5.7.4.1 observational context lab; strategy remains untouched."""
    print()
    print("=" * 70)
    print("v5.7.5 BOS EVENT ANATOMY RESEARCH")
    print("=" * 70)
    print("STRATEGY LOGIC: UNCHANGED")
    print("Purpose: determine which causal contexts accompany continuation or failure.")
    print()

    unique_events = _research_unique_signal_events(signal_rows)
    print(f"Actionable signal rows: {len(signal_rows)}")
    print(f"Unique actionable event occurrences: {len(unique_events)}")
    print(
        f"BUY unique events: {(unique_events['signal'] == 'BUY').sum()} | "
        f"SELL unique events: {(unique_events['signal'] == 'SELL').sum()}"
    )
    if unique_events.empty:
        print("No unique actionable events.")
        return

    unique_events = _attach_directional_forward_stats(unique_events, df, horizon=6)
    unique_events = _build_v574_context(unique_events)

    for side in ("BUY", "SELL"):
        side_rows = unique_events[unique_events["signal"] == side].copy()
        _print_context_matrix(side_rows, side)
        _print_context_feature_diagnostics(side_rows, side)
        _print_proxy_comparison(side_rows, side)

    print()
    print("EVENT-LEVEL CONTEXT SAMPLE")
    print("-" * 110)
    sample_cols = [
        "time", "signal", "signal_event_strength", "ctx_distance_atr",
        "ctx_pre_move_6_signed", "ctx_vwap_distance_signed",
        "ctx_ema_spread_signed", "ctx_rsi_delta_signed",
        "ctx_macd_delta_signed", "ctx_volume_ratio", "ctx_candle_range_atr",
        "ctx_geometry", "ctx_exhaustion_proxy", "ctx_confirmation_proxy",
        "label_forward_return_6", "diag_directional_mfe_6", "diag_directional_mae_6",
    ]
    available = [c for c in sample_cols if c in unique_events.columns]
    print(unique_events[available].to_string(index=False))

    # Export a dedicated event-level matrix. It is deliberately separate from
    # the causal bar-by-bar CSV because it contains forward labels.
    event_path = "v5.7.5_event_anatomy.csv"
    if RESEARCH_EXPORT_CSV:
        unique_events.to_csv(event_path, index=False)
        print()
        print(f"Event context CSV: {event_path}")

    print()
    print("IMPORTANT: v5.7.4.1 does NOT filter, reject, delay, or alter signals.")
    print("All context flags are descriptive; forward labels are research-only.")
    print("No live orders are possible in this program.")
    print("=" * 70)
    print()


def print_research_feature_report(features, signal_rows):
    print()
    print("=" * 70)
    print("v5.7.3 RESEARCH FEATURE ENGINE")
    print("=" * 70)
    print()
    print(f"Research rows: {len(features)}")
    print(f"Causal feature columns: {sum(c.startswith('feature_') for c in features.columns)}")
    print(f"Actionable signal rows: {len(signal_rows)}")
    print(f"BUY rows: {(signal_rows['signal'] == 'BUY').sum()}")
    print(f"SELL rows: {(signal_rows['signal'] == 'SELL').sum()}")
    print(f"Forward label horizons: {', '.join(str(x) for x in RESEARCH_FORWARD_HORIZONS)} bars")
    if RESEARCH_EXPORT_CSV:
        print(f"CSV export: {RESEARCH_CSV_PATH}")
