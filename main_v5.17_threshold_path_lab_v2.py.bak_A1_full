        ("body_pct", "anat_body_pct"),
        ("range_ATR", "anat_range_atr"),
        ("BOS_strength", "anat_strength"),
    ]
    for side in ["BUY", "SELL"]:
        s = work[work["signal"].eq(side)]
        print()
        print(f"{side}")
        for label, col in corr_cols:
            x = pd.to_numeric(s[col], errors="coerce") if col in s.columns else pd.Series(dtype=float)
            y = pd.to_numeric(s["label_forward_return_6"], errors="coerce")
            mask = x.notna() & y.notna()
            if mask.sum() < 3 or x[mask].nunique() < 2 or y[mask].nunique() < 2:
                value = "n/a"
            else:
                value = f"{x[mask].corr(y[mask]):+.3f}"
            print(f"  {label:<24} N={int(mask.sum()):>2} | corr={value}")

    # ------------------------------------------------------------
    # 3. Context groups side-by-side
    # ------------------------------------------------------------
    print()
    print("CONTEXT GROUPS — DESCRIPTIVE COMPARISON")
    print("-" * 110)
    group_specs = [
        ("geometry near", "anat_geometry", "near_entry"),
        ("geometry mid", "anat_geometry", "mid_entry"),
        ("geometry stretched", "anat_geometry", "stretched_entry"),
        ("pre-move quiet", "anat_premove", "quiet"),
        ("pre-move moderate", "anat_premove", "moderate"),
        ("pre-move strong", "anat_premove", "strong"),
        ("candle compact", "anat_candle", "compact"),
        ("candle normal", "anat_candle", "normal"),
        ("candle expanded", "anat_candle", "expanded"),
        ("participation low", "anat_participation", "low"),
        ("participation normal", "anat_participation", "normal"),
        ("participation high", "anat_participation", "high"),
        ("wick upper rejection", "anat_wick", "upper_rejection"),
        ("wick lower rejection", "anat_wick", "lower_rejection"),
        ("trend aligned", "anat_trend", "aligned"),
        ("trend opposed", "anat_trend", "opposed"),
        ("momentum aligned", "anat_momentum", "aligned"),
        ("momentum opposed", "anat_momentum", "opposed"),
        ("exhaustion shape", "anat_exhaustion_shape", True),
        ("confirmation shape", "anat_confirmation_shape", True),
    ]
    for label, col, value in group_specs:
        mask = work[col].eq(value)
        print()
        print(f"{label}")
        for side in ["BUY", "SELL"]:
            _print_v576_group(work, side, f"  {side}", mask)

    # ------------------------------------------------------------
    # 4. Event signatures and outcome bands — descriptive only
    # ------------------------------------------------------------
    print()
    print("EVENT SIGNATURES")
    print("-" * 110)
    display_cols = [
        "time", "signal", "signal_event_strength", "anat_distance_atr",
        "anat_premove6", "anat_vwap_signed", "anat_ema9_21",
        "anat_volume", "anat_range_atr", "anat_geometry", "anat_premove",
        "anat_candle", "anat_participation", "anat_trend", "anat_momentum",
        "anat_wick", "anat_exhaustion_shape", "label_forward_return_6",
