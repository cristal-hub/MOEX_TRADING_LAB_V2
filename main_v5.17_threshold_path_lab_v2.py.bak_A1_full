        )


def run_future_perturbation_test(df):
    """Prove that future-bar changes cannot alter earlier decisions."""
    if len(df) < 20:
        return True

    cutoff = len(df) // 2
    original = build_signal_timeline(df, [], [])
    mutated_df = df.copy(deep=True)

    # MOEX volume/value columns are commonly int64. Future perturbation
    # uses fractional multipliers, so explicitly promote these columns
    # before assignment instead of relying on pandas implicit casting.
    mutated_df["volume"] = mutated_df["volume"].astype(float)
    mutated_df["value"] = mutated_df["value"].astype(float)

    for column, multiplier in (("open", 1.11), ("high", 1.13), ("low", 0.89), ("close", 1.09)):
        mutated_df.loc[cutoff + 1:, column] = mutated_df.loc[cutoff + 1:, column] * multiplier
    mutated_df.loc[cutoff + 1:, "volume"] = mutated_df.loc[cutoff + 1:, "volume"] * 1.7
    mutated_df.loc[cutoff + 1:, "value"] = mutated_df.loc[cutoff + 1:, "value"] * 1.7
    mutated_df = calculate_indicators(mutated_df)

    mutated = build_signal_timeline(mutated_df, [], [])

    def comparable(item):
        event = item.get("signal_event")
        return (
            item["index"],
            item["signal"],
            item["technical_score"],
            item["technical_state"],
            item["structure_state"],
            item["current_trend"],
            None if event is None else (event.get("index"), event.get("event"), event.get("direction"), event.get("level")),
            tuple((e.get("index"), e.get("event"), e.get("direction"), e.get("level")) for e in item.get("events_snapshot", [])),
        )

    return [comparable(x) for x in original[:cutoff + 1]] == [comparable(x) for x in mutated[:cutoff + 1]]


# ============================================================

def _build_v575_event_anatomy(unique_events):
    """Build event-level anatomy from information available at the BOS bar.

    Research only. Nothing here is consumed by the Signal Engine or either
    backtest. Forward labels are outcomes, never inputs.
    """
    work = unique_events.copy()
    if work.empty:
        return work

    direction = np.where(work["signal"].eq("BUY"), 1.0, -1.0)

    def num(name):
        return pd.to_numeric(work.get(name, np.nan), errors="coerce")

    work["anat_distance_atr"] = num("diag_entry_distance_atr")
    work["anat_premove3"] = num("diag_pre_signal_return_3") * direction
    work["anat_premove6"] = num("diag_pre_signal_return_6") * direction
    work["anat_premove12"] = num("diag_pre_signal_return_12") * direction
    work["anat_vwap_signed"] = num("feature_vwap_distance_pct") * direction
    work["anat_ema9_21"] = num("feature_ema9_21_spread") * direction
    work["anat_ema21_50"] = num("feature_ema21_50_spread") * direction
    work["anat_ema9_slope"] = num("feature_ema9_slope_3") * direction
    work["anat_rsi_delta"] = num("feature_rsi_delta_3") * direction
    work["anat_macd_delta"] = num("feature_macd_hist_delta_3") * direction
    work["anat_macd_hist"] = num("feature_macd_hist_atr") * direction
    work["anat_volume"] = num("feature_volume_ratio")
    work["anat_body_pct"] = num("feature_candle_body_pct")
    work["anat_range_atr"] = num("feature_candle_range_atr")
    work["anat_upper_wick"] = num("feature_upper_wick_pct")
    work["anat_lower_wick"] = num("feature_lower_wick_pct")
    work["anat_strength"] = num("signal_event_strength")
    work["anat_break"] = num("signal_event_break_score") if "signal_event_break_score" in work else np.nan
    work["anat_event_atr"] = num("signal_event_atr") if "signal_event_atr" in work else np.nan

    # Anatomy labels are deliberately descriptive and broad.
    work["anat_geometry"] = np.select(
        [work["anat_distance_atr"] < 0.75,
         work["anat_distance_atr"].between(0.75, 1.50, inclusive="left"),
         work["anat_distance_atr"] >= 1.50],
        ["near_entry", "mid_entry", "stretched_entry"],
        default="unknown",
    )
    work["anat_premove"] = np.select(
        [work["anat_premove6"] < 0.20,
         work["anat_premove6"].between(0.20, 0.50, inclusive="left"),
         work["anat_premove6"] >= 0.50],
        ["quiet", "moderate", "strong"],
        default="unknown",
    )
    work["anat_candle"] = np.select(
        [work["anat_range_atr"] < 0.75,
         work["anat_range_atr"].between(0.75, 1.50, inclusive="left"),
         work["anat_range_atr"] >= 1.50],
        ["compact", "normal", "expanded"],
        default="unknown",
    )
    work["anat_participation"] = np.select(
        [work["anat_volume"] < 1.0,
         work["anat_volume"].between(1.0, 1.5, inclusive="left"),
         work["anat_volume"] >= 1.5],
        ["low", "normal", "high"],
        default="unknown",
    )
    work["anat_momentum"] = np.select(
        [(work["anat_rsi_delta"] > 0) & (work["anat_macd_delta"] > 0),
         (work["anat_rsi_delta"] <= 0) & (work["anat_macd_delta"] <= 0)],
        ["aligned", "opposed"],
        default="mixed",
    )
    work["anat_trend"] = np.select(
        [(work["anat_ema9_21"] > 0) & (work["anat_ema21_50"] > 0),
         (work["anat_ema9_21"] <= 0) & (work["anat_ema21_50"] <= 0)],
        ["aligned", "opposed"],
        default="mixed",
    )
    work["anat_wick"] = np.select(
        [(work["anat_upper_wick"] > 30) & (work["anat_lower_wick"] < 20),
         (work["anat_lower_wick"] > 30) & (work["anat_upper_wick"] < 20)],
        ["upper_rejection", "lower_rejection"],
        default="balanced_or_mixed",
    )

    work["anat_context_signature"] = (
        work["anat_geometry"].astype(str) + " | " +
        work["anat_premove"].astype(str) + " | " +
        work["anat_candle"].astype(str) + " | " +
        work["anat_participation"].astype(str) + " | trend=" +
        work["anat_trend"].astype(str) + " | momentum=" +
        work["anat_momentum"].astype(str)
    )

    # Simple composite descriptive labels, never strategy rules.
    work["anat_exhaustion_shape"] = (
        (work["anat_geometry"] == "stretched_entry") &
        (work["anat_premove"].isin(["moderate", "strong"])) &
        ((work["anat_vwap_signed"] >= 0.35) | (work["anat_range_atr"] >= 1.5))
    )
    work["anat_confirmation_shape"] = (
        (work["anat_geometry"] == "near_entry") &
        (work["anat_premove"] == "quiet") &
        (work["anat_trend"] == "aligned") &
        (work["anat_momentum"] == "aligned")
    )
    return work


def _print_anatomy_group(work, label, mask):
    g = work.loc[mask.fillna(False)] if hasattr(mask, "fillna") else work
    if g.empty:
        print(f"{label:<34} N=0")
        return
    print(
        f"{label:<34} N={len(g):>3} | "
        f"h3={_format_stat(_safe_mean(g['label_forward_return_3']))} | "
        f"h6={_format_stat(_safe_mean(g['label_forward_return_6']))} | "
        f"h12={_format_stat(_safe_mean(g['label_forward_return_12']))} | "
        f"win_h6={_format_stat(_safe_win_rate(g['label_forward_return_6']),1)}% | "
        f"MFE6={_format_stat(_safe_mean(g['diag_directional_mfe_6']))} | "
        f"MAE6={_format_stat(_safe_mean(g['diag_directional_mae_6']))}"
    )


def print_v575_event_anatomy_report(signal_rows, df):
    """v5.7.5 event anatomy lab; no strategy/backtest mutation."""
    print()
    print("=" * 70)
    print("v5.7.5 EVENT ANATOMY / BOS CONTINUATION RESEARCH")
    print("=" * 70)
    print("STRATEGY LOGIC: UNCHANGED")
    print("Purpose: inspect complete BOS anatomy at the event bar.")
    print()

    unique_events = _research_unique_signal_events(signal_rows)
    unique_events = _attach_directional_forward_stats(unique_events, df, horizon=6)
    work = _build_v575_event_anatomy(unique_events)
    print(f"Actionable signal rows: {len(signal_rows)}")
    print(f"Unique BOS event occurrences: {len(work)}")
    if work.empty:
        print("No unique events available.")
        return
    print(f"BUY unique events: {(work['signal'] == 'BUY').sum()} | SELL unique events: {(work['signal'] == 'SELL').sum()}")

    for side in ["BUY", "SELL"]:
        side_rows = work[work["signal"] == side].copy()
        print()
        print(f"{side} — EVENT ANATOMY GROUPS")
        print("-" * 110)
        for label, col in [
            ("geometry: near_entry", "anat_geometry"),
            ("geometry: mid_entry", "anat_geometry"),
            ("geometry: stretched_entry", "anat_geometry"),
            ("pre_move: quiet", "anat_premove"),
            ("pre_move: moderate", "anat_premove"),
            ("pre_move: strong", "anat_premove"),
            ("candle: compact", "anat_candle"),
            ("candle: normal", "anat_candle"),
            ("candle: expanded", "anat_candle"),
            ("participation: low", "anat_participation"),
            ("participation: normal", "anat_participation"),
            ("participation: high", "anat_participation"),
            ("trend: aligned", "anat_trend"),
            ("trend: opposed", "anat_trend"),
            ("momentum: aligned", "anat_momentum"),
            ("momentum: opposed", "anat_momentum"),
            ("wick: upper_rejection", "anat_wick"),
            ("wick: lower_rejection", "anat_wick"),
        ]:
            _print_anatomy_group(side_rows, label, side_rows[col].eq(label.split(": ",1)[1]) if ": " in label else side_rows[col].eq(label))

        print(f"{side} — COMPOSITE SHAPES")
        print("-" * 110)
        _print_anatomy_group(side_rows, "exhaustion_shape", side_rows["anat_exhaustion_shape"])
        _print_anatomy_group(side_rows, "confirmation_shape", side_rows["anat_confirmation_shape"])
        _print_anatomy_group(side_rows, "all events", pd.Series(True, index=side_rows.index))

    print()
    print("EVENT-LEVEL ANATOMY TABLE")
    print("-" * 110)
    cols = [
        "time", "signal", "signal_event_strength", "anat_distance_atr",
        "anat_premove3", "anat_premove6", "anat_premove12",
        "anat_vwap_signed", "anat_ema9_21", "anat_ema21_50",
        "anat_rsi_delta", "anat_macd_delta", "anat_volume",
        "anat_body_pct", "anat_range_atr", "anat_upper_wick", "anat_lower_wick",
        "anat_geometry", "anat_premove", "anat_candle", "anat_participation",
        "anat_trend", "anat_momentum", "anat_wick", "anat_exhaustion_shape",
        "anat_confirmation_shape", "label_forward_return_3", "label_forward_return_6",
        "label_forward_return_12", "diag_directional_mfe_6", "diag_directional_mae_6",
    ]
    cols = [c for c in cols if c in work.columns]
    print(work[cols].to_string(index=False))

    path = "v5.7.5_event_anatomy.csv"
    if RESEARCH_EXPORT_CSV:
        work.to_csv(path, index=False)
        print()
        print(f"Event anatomy CSV: {path}")

    print()
    print("IMPORTANT: v5.7.5 does NOT filter, reject, delay, or alter signals.")
    print("All anatomy labels are descriptive; forward labels are research-only.")
    print("No live orders are possible in this program.")
    print("=" * 70)
    print()


