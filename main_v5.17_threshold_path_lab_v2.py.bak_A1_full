    print(f"Initial trail {MANAGED_INITIAL_TRAIL_ATR:.2f} ATR | Tight trail {MANAGED_TIGHT_TRAIL_ATR:.2f} ATR")
    print(f"Structure buffer {MANAGED_STRUCTURE_BUFFER_ATR:.2f} ATR")
    print(f"Initial capital {backtest['starting_capital']:.2f}")
    print(f"Final capital {backtest['ending_capital']:.2f}")
    print(f"Net P&L {backtest['total_net_pnl']:.2f}")
    print(f"Return {backtest['return_pct']:.2f}%")
    print(f"Trades {backtest['trade_count']}")
    print(f"Wins {backtest['wins']}")
    print(f"Losses {backtest['losses']}")
    print(f"Win rate {backtest['win_rate']:.2f}%")
    print(f"Profit factor {backtest['profit_factor']:.3f}")
    print(f"Average trade {backtest['average_trade']:.2f}")
    print(f"Max drawdown {backtest['max_drawdown']:.2f}%")
    print(f"Commission rate {BACKTEST_COMMISSION_RATE * 100:.4f}% per side")
    print(f"Slippage rate {BACKTEST_SLIPPAGE_RATE * 100:.4f}% per side")
    print(f"Total commission paid {backtest.get('total_commission', 0.0):.2f}")
    print(f"Total slippage cost {backtest.get('total_slippage', 0.0):.2f}")
    print(f"Round-trip commission rate {BACKTEST_COMMISSION_RATE * 200:.4f}%")
    print(f"Commission-only break-even move {BACKTEST_COMMISSION_RATE * 200:.4f}%")
    print()
    for number, trade in enumerate(backtest["trades"], 1):
        activation = trade.get("activation_time")
        warning = trade.get("reversal_warning_time")
        print(f"#{number} {trade['side']} SIGNAL={trade['signal_time'].strftime('%Y-%m-%d %H:%M')} ENTRY={trade['entry_time'].strftime('%Y-%m-%d %H:%M')} EXIT={trade['exit_time'].strftime('%Y-%m-%d %H:%M')}")
        print(f"  Exit reason: {trade['reason']} | NET={trade['net_pnl']:.2f} | RETURN={trade['return_pct']:.2f}%")
        print(f"  Costs: commission={trade.get('total_commission', 0.0):.2f} | slippage={trade.get('total_slippage_cost', 0.0):.2f}")
        print(f"  Holding: {trade['holding_bars']} bars | MFE={trade['mfe_pct_of_entry']:.2f}% | MAE={trade['mae_pct_of_entry']:.2f}% | MFE capture={_format_diag(trade.get('mfe_capture_ratio'), 2)}")
        print(f"  Trail active: {'YES' if trade['management_active'] else 'NO'} | activated={activation.strftime('%Y-%m-%d %H:%M') if activation is not None else 'N/A'} | final trail={_format_diag(trade.get('final_trail_level'), 4)}")
        print(f"  Reversal warning: {warning.strftime('%Y-%m-%d %H:%M') if warning is not None else 'N/A'} | tightened={'YES' if trade.get('tightened') else 'NO'}")
        print()


def _format_diag(value, digits=2, suffix=""):
    if value is None or pd.isna(value):
        return "N/A"
    return f"{float(value):.{digits}f}{suffix}"


def print_trade_diagnostics(backtest):
    if not BACKTEST_DIAGNOSTICS:
        return

    print()
    print("TRADE DIAGNOSTICS v5.5:")
    print()

    if not backtest["trades"]:
        print("No trades for diagnostics")
        return

    for number, trade in enumerate(backtest["trades"], start=1):
        event = trade.get("signal_event")
        event_text = "N/A"
        if event is not None:
            event_text = (
                f"{event.get('event')} "
                f"{event.get('direction')} "
                f"level={_format_diag(event.get('level'), 4)}"
            )

        structure_events = trade.get("structure_events_during_trade", [])
        if structure_events:
            changes = ", ".join(
                f"{event_item.get('event')}"
                f"({event_item.get('direction')})"
                for event_item in structure_events
            )
        else:
            changes = "NONE"

        print(
            f"#{number} {trade['side']} "
            f"SIGNAL={trade.get('signal_time').strftime('%Y-%m-%d %H:%M') if trade.get('signal_time') is not None else 'N/A'} "
            f"ENTRY={trade['entry_time'].strftime('%Y-%m-%d %H:%M')} "
            f"EXIT={trade['exit_time'].strftime('%Y-%m-%d %H:%M')}"
        )
        print(
            f"  Signal event: {event_text} "
            f"strength={_format_diag(trade.get('signal_event_strength_score'), 1)}"
        )
        print(
            f"  Technical: {trade.get('technical_state_at_signal')} "
            f"score={trade.get('technical_score_at_signal')} "
            f"ATR={_format_diag(trade.get('signal_atr14'), 4)} "
            f"VOL={_format_diag(trade.get('signal_volume_ratio'), 2, 'x')}"
        )
        print(
            f"  Entry vs signal level: "
            f"{_format_diag(trade.get('entry_to_signal_level_distance'), 4)} "
            f"({ _format_diag(trade.get('entry_to_signal_level_atr'), 2, ' ATR') })"
        )
        print(
            f"  Holding: {trade.get('holding_bars')} bars "
            f"| MFE={_format_diag(trade.get('mfe_price'), 4)} "
            f"({_format_diag(trade.get('mfe_pct_of_entry'), 2, '%')}) "
            f"| MAE={_format_diag(trade.get('mae_price'), 4)} "
            f"({_format_diag(trade.get('mae_pct_of_entry'), 2, '%')})"
        )
        print(
            f"  MFE money={_format_diag(trade.get('mfe_money'), 2)} "
            f"| MAE money={_format_diag(trade.get('mae_money'), 2)}"
        )
        print(
            f"  Exit: {trade['reason']} "
            f"| NET={trade['net_pnl']:.2f}"
        )
        print(
            f"  Structure changes during trade: {changes}"
        )
        print()

    print("DIAGNOSTIC SUMMARY:")
    total = len(backtest["trades"])
    positive_mfe = sum(
        1 for trade in backtest["trades"]
        if trade.get("mfe_money", 0) > 0
    )
    trades_with_followup_change = sum(
        1 for trade in backtest["trades"]
        if trade.get("structure_events_during_trade")
    )
    print(
        f"Trades with favourable excursion > 0: "
        f"{positive_mfe}/{total}"
    )
    print(
        f"Trades with structure changes after entry: "
        f"{trades_with_followup_change}/{total}"
    )


