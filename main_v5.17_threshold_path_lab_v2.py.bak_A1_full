            )


def print_events(events):

    print()
    print("EVENTS:")
    print()

    if not events:

        print(
            "No structural events"
        )

        return

    for event in events:

        time_text = (
            event["time"]
            .strftime("%Y-%m-%d %H:%M")
        )

        line = (
            f"{time_text} "
            f"{event['event']}"
        )

        if event.get(
            "direction"
        ):

            line += (
                f" {event['direction']}"
            )

        if event.get(
            "level"
        ) is not None:

            line += (
                f" level="
                f"{event['level']:.2f}"
            )

        strength = event.get(
            "strength"
        )

        if strength is not None:

            line += (
                f" strength="
                f"{strength['score']:.0f}/100 "
                f"{strength['quality']} "
                f"ATR="
                f"{strength['atr']:.2f} "
                f"VOL="
            )

            if pd.isna(
                strength["volume_ratio"]
            ):

                line += "N/A"

            else:

                line += (
                    f"{strength['volume_ratio']:.2f}x"
                )

            line += (
                f" BODY="
                f"{strength['body_score']:.2f}"
            )

            line += (
                f" BREAK="
                f"{strength['break_score']:.2f}"
            )

        print(line)


