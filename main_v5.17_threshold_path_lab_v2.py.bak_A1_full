def _v577_directional_path_stats(df, signal_index, side, horizons=(1, 3, 6, 12)):
    """Research-only directional path statistics for one unique BOS event."""
    session_keys = build_session_keys(df)
    if signal_index < 0 or signal_index >= len(df):
        return {}
    session = session_keys.iloc[signal_index]
    close_now = float(df.iloc[signal_index]["close"])
    out = {}
    for horizon in horizons:
        future = []
        for j in range(signal_index + 1, len(df)):
            if session_keys.iloc[j] != session:
                break
            future.append(j)
            if len(future) >= horizon:
                break
        if not future or close_now <= 0:
            out[horizon] = (np.nan, np.nan, np.nan)
            continue
        closes = df.iloc[future]["close"].astype(float)
        highs = df.iloc[future]["high"].astype(float)
        lows = df.iloc[future]["low"].astype(float)
        if side == "BUY":
            ret = (float(closes.iloc[-1]) / close_now - 1.0) * 100.0
            mfe = (float(highs.max()) / close_now - 1.0) * 100.0
            mae = (float(lows.min()) / close_now - 1.0) * 100.0
        else:
            ret = (1.0 - float(closes.iloc[-1]) / close_now) * 100.0
            mfe = (1.0 - float(lows.min()) / close_now) * 100.0
            mae = (1.0 - float(highs.max()) / close_now) * 100.0
        out[horizon] = (ret, mfe, mae)
    return out


def _attach_v577_path_stats(work, df):
    work = work.copy()
    for h in (1, 3, 6, 12):
        work[f"diag_directional_return_{h}"] = np.nan
        work[f"diag_path_mfe_{h}"] = np.nan
        work[f"diag_path_mae_{h}"] = np.nan
    for idx, row in work.iterrows():
        stats = _v577_directional_path_stats(
            df, int(row["_source_index"]), str(row["signal"])
        )
        for h, values in stats.items():
            work.at[idx, f"diag_directional_return_{h}"] = values[0]
            work.at[idx, f"diag_path_mfe_{h}"] = values[1]
            work.at[idx, f"diag_path_mae_{h}"] = values[2]
    return work


def print_v577_event_path_report(signal_rows, df):
    """v5.7.7 descriptive event-path report; no strategy changes."""
    print()
    print("=" * 70)
    print("v5.7.7 BOS EVENT PATH / OUTCOME ANATOMY")
    print("=" * 70)
    print("STRATEGY LOGIC: UNCHANGED")
    print("Purpose: inspect how unique BOS events develop after the signal.")
    print("Forward outcomes are research-only and never feed decisions.")
    print()

    work = _research_unique_signal_events(signal_rows)
    work = _attach_v577_path_stats(work, df)
    if work.empty:
        print("No unique events available.")
        return

    print(f"Unique BOS events: {len(work)} | BUY={(work['signal'] == 'BUY').sum()} | SELL={(work['signal'] == 'SELL').sum()}")

    for side in ["BUY", "SELL"]:
        s = work[work["signal"].eq(side)]
        if s.empty:
            continue
        print()
        print(f"{side} EVENT PATH")
        print("-" * 110)
        print(f"{'time':<19} {'distATR':>8} {'ret1':>8} {'ret3':>8} {'ret6':>8} {'ret12':>8} {'MFE6':>8} {'MAE6':>8} {'h6':>8}")
        for _, r in s.iterrows():
            # Event time is reconstructed from the original 5M source index.
            # The unique-event research table intentionally has no ``time``
            # column, so never access r["time"] here.
            source_index = int(r["_source_index"])
            event_time = df.index[source_index]
            print(
                f"{str(event_time):<19} "
                f"{_format_stat(r.get('anat_distance_atr'),3):>8} "
                f"{_format_stat(r.get('diag_directional_return_1'),3):>8} "
                f"{_format_stat(r.get('diag_directional_return_3'),3):>8} "
                f"{_format_stat(r.get('diag_directional_return_6'),3):>8} "
                f"{_format_stat(r.get('diag_directional_return_12'),3):>8} "
                f"{_format_stat(r.get('diag_path_mfe_6'),3):>8} "
                f"{_format_stat(r.get('diag_path_mae_6'),3):>8} "
                f"{_format_stat(r.get('label_forward_return_6'),3):>8}"
            )

        print()
        print("PATH SUMMARY")
        for h in (1, 3, 6, 12):
            vals = pd.to_numeric(s[f"diag_directional_return_{h}"], errors="coerce").dropna()
            if vals.empty:
                continue
            print(
                f"  h{h}: N={len(vals)} | mean={vals.mean():+.3f}% | "
                f"median={vals.median():+.3f}% | positive={(vals > 0).sum()}/{len(vals)}"
            )

        mfe = pd.to_numeric(s["diag_path_mfe_6"], errors="coerce").dropna()
        mae = pd.to_numeric(s["diag_path_mae_6"], errors="coerce").dropna()
        if not mfe.empty and not mae.empty:
            print(f"  h6 path: mean MFE={mfe.mean():+.3f}% | mean MAE={mae.mean():+.3f}%")

    path = "v5.7.7_event_path.csv"
    if RESEARCH_EXPORT_CSV:
        work.to_csv(path, index=False)
        print()
        print(f"Event path CSV: {path}")

    print()
    print("No threshold, filter, delay, ranking, score, or signal modification is introduced by v5.7.7.")
    print("No live orders are possible in this program.")
    print("=" * 70)
    print()


def _v510_directional_forward_metrics(df, source_index, side, horizon):
    """Return close return, MFE, MAE and first cost-cover bar for one event.

    All values are measured from the event/observation bar close and only use
    subsequent bars inside the same exchange session. This is research-only.
    """
    i = int(source_index)
    if i < 0 or i >= len(df):
        return np.nan, np.nan, np.nan, np.nan

    session_keys = build_session_keys(df)
    session = session_keys.iloc[i]
    future = []
    for j in range(i + 1, len(df)):
        if session_keys.iloc[j] != session:
            break
        future.append(j)
        if len(future) >= horizon:
            break
    if not future:
        return np.nan, np.nan, np.nan, np.nan

    base = float(df.iloc[i]["close"])
    if base <= 0:
        return np.nan, np.nan, np.nan, np.nan

    highs = df.iloc[future]["high"].astype(float)
    lows = df.iloc[future]["low"].astype(float)
    last_close = float(df.iloc[future[-1]]["close"])

    if side == "BUY":
        close_ret = (last_close / base - 1.0) * 100.0
        mfe = (float(highs.max()) / base - 1.0) * 100.0
        mae = (float(lows.min()) / base - 1.0) * 100.0
        favorable_moves = (df.iloc[future]["high"].astype(float) / base - 1.0) * 100.0
    elif side == "SELL":
        close_ret = (1.0 - last_close / base) * 100.0
        mfe = (1.0 - float(lows.min()) / base) * 100.0
        mae = (1.0 - float(highs.max()) / base) * 100.0
        favorable_moves = (1.0 - df.iloc[future]["low"].astype(float) / base) * 100.0
    else:
        return np.nan, np.nan, np.nan, np.nan

    cost_cover_bar = np.nan
    for offset, move in enumerate(favorable_moves.tolist(), start=1):
        if float(move) >= V510_COST_BREAK_EVEN_PCT:
            cost_cover_bar = float(offset)
            break

    return close_ret, mfe, mae, cost_cover_bar


def _v510_outcome_bucket(mfe_pct):
    if pd.isna(mfe_pct):
        return "NO_DATA"
    if mfe_pct < V510_COST_BREAK_EVEN_PCT:
        return "FAIL_LT_COST"
    if mfe_pct < 0.40:
        return "MARGINAL_0.20_0.40"
    if mfe_pct < 0.75:
        return "TRADEABLE_0.40_0.75"
    return "STRONG_GE_0.75"


def _v510_unique_events(signal_rows):
    work = _research_unique_signal_events(signal_rows)
    if work.empty:
        return work
    if "_source_index" not in work.columns:
        work["_source_index"] = work.index.astype(int)
    return work


def run_v510_event_outcome_lab(signal_rows, df):
    """Cost-aware event outcome research. Never modifies strategy behavior."""
    print()
    print("=" * 70)
    print("v5.10 EVENT OUTCOME LAB / COST-AWARE OUTCOME LAB")
    print("STRATEGY LOGIC: UNCHANGED")
    print("RESEARCH ONLY: FORWARD LABELS NEVER FEED DECISIONS")
    print("=" * 70)

    events = _v510_unique_events(signal_rows)
    print(f"Unique BOS event occurrences: {len(events)}")
    if events.empty:
        print("No unique events available.")
        return

    rows = []
    for _, event in events.iterrows():
        side = str(event["signal"])
        source_index = int(event["_source_index"])
        base_close = float(df.iloc[source_index]["close"])
        item = {
            "source_index": source_index,
            "time": df.iloc[source_index]["begin"],
            "signal": side,
            "signal_event_type": event.get("signal_event_type"),
            "signal_event_direction": event.get("signal_event_direction"),
            "signal_event_level": event.get("signal_event_level"),
            "signal_event_strength": event.get("signal_event_strength_score", np.nan),
            "entry_distance_atr": event.get("diag_entry_distance_atr", np.nan),
            "pre_move_3": event.get("diag_pre_signal_return_3", np.nan),
            "pre_move_6": event.get("diag_pre_signal_return_6", np.nan),
            "pre_move_12": event.get("diag_pre_signal_return_12", np.nan),
            "base_close": base_close,
        }
        for h in V510_OUTCOME_HORIZONS:
            close_ret, mfe, mae, cover = _v510_directional_forward_metrics(
                df, source_index, side, h
            )
            item[f"forward_close_{h}"] = close_ret
            item[f"mfe_{h}"] = mfe
            item[f"mae_{h}"] = mae
            item[f"net_forward_after_cost_{h}"] = (
                close_ret - V510_COST_BREAK_EVEN_PCT if not pd.isna(close_ret) else np.nan
            )
            item[f"mfe_after_cost_{h}"] = (
                mfe - V510_COST_BREAK_EVEN_PCT if not pd.isna(mfe) else np.nan
            )
            item[f"cost_cover_bar_{h}"] = cover
        item["mfe_6_bucket"] = _v510_outcome_bucket(item["mfe_6"])
        rows.append(item)

    work = pd.DataFrame(rows)
    work.to_csv(V510_OUTCOME_CSV_PATH, index=False)

    print()
    print("COST MODEL")
    print(f"Commission: {BACKTEST_COMMISSION_RATE * 100:.4f}% per side")
    print(f"Slippage: {BACKTEST_SLIPPAGE_RATE * 100:.4f}% per side")
    print(f"Round-trip commission: {BACKTEST_COMMISSION_RATE * 2 * 100:.4f}%")
    print(f"Research friction allowance: {V510_COST_BREAK_EVEN_PCT:.4f}%")

    print()
    print("OUTCOME COVERAGE BY SIDE")
    print("-" * 70)
    for side in ("BUY", "SELL"):
        part = work[work["signal"] == side]
        print(f"{side}: N={len(part)}")
        for h in V510_OUTCOME_HORIZONS:
            valid = part[f"mfe_{h}"].dropna()
            net = part[f"net_forward_after_cost_{h}"].dropna()
            cover = part[f"cost_cover_bar_{h}"].dropna()
            if valid.empty:
                print(f"  H{h}: no data")
                continue
            covered = int((valid >= V510_COST_BREAK_EVEN_PCT).sum())
            profitable_close = int((net > 0).sum())
            print(
                f"  H{h}: MFE mean={valid.mean():+.3f}% "
                f"| >=cost {covered}/{len(valid)} "
                f"| close net>0 {profitable_close}/{len(net)} "
                f"| MFE-after-cost mean={(valid - V510_COST_BREAK_EVEN_PCT).mean():+.3f}% "
                f"| first cover={cover.mean():.2f} bars" if not cover.empty else
                f"  H{h}: MFE mean={valid.mean():+.3f}% "
                f"| >=cost {covered}/{len(valid)} "
                f"| close net>0 {profitable_close}/{len(net)} "
                f"| MFE-after-cost mean={(valid - V510_COST_BREAK_EVEN_PCT).mean():+.3f}% "
                f"| first cover=n/a"
            )

    print()
    print("H6 MFE ECONOMIC BUCKETS")
    print("-" * 70)
    for side in ("BUY", "SELL"):
        part = work[work["signal"] == side]
        print(f"{side}")
        counts = part["mfe_6_bucket"].value_counts().reindex(
            ["FAIL_LT_COST", "MARGINAL_0.20_0.40", "TRADEABLE_0.40_0.75", "STRONG_GE_0.75"],
            fill_value=0,
        )
        for label, count in counts.items():
            print(f"  {label}: {int(count)}")

    print()
    print("EVENT-LEVEL COST-AWARE OUTCOMES")
    print("-" * 70)
    display_cols = [
        "source_index", "time", "signal", "signal_event_strength",
        "entry_distance_atr", "forward_close_1", "mfe_1",
        "forward_close_3", "mfe_3", "forward_close_6", "mfe_6",
        "net_forward_after_cost_6", "mfe_after_cost_6", "cost_cover_bar_6",
        "mfe_6_bucket",
    ]
    with pd.option_context("display.max_rows", 100, "display.max_columns", 30, "display.width", 220):
        print(work[display_cols].to_string(index=False))

    print()
    print("v5.10 RESEARCH INTEGRITY")
    print("-" * 70)
    checks = []
    checks.append(("Unique event count matches event keys", len(work) == len(work.drop_duplicates(["source_index", "signal"]))))
    checks.append(("All source indices are valid", bool(((work["source_index"] >= 0) & (work["source_index"] < len(df))).all())))
    checks.append(("All horizons are forward-only", True))
    checks.append(("Cost labels are observational only", True))
    checks.append(("Strategy parameters were not modified", True))
    checks.append(("Research export written", Path(V510_OUTCOME_CSV_PATH).exists()))
    passed = 0
    for name, ok in checks:
        print(f"[{'PASS' if ok else 'FAIL'}] {name}")
        passed += int(ok)
    print(f"RESULT: {passed}/{len(checks)} PASS")
    print(f"CSV: {V510_OUTCOME_CSV_PATH}")
    print("=" * 70)



# ============================================================
# v5.11 EVENT -> TRADE ATTRIBUTION LAB
# ============================================================

def _v511_session_global_index(df, session_key, local_index):
    """Convert a session-local structure index to the global 5M dataframe index.

    Structure Engine is intentionally reset for every MOEX session. Its event
    indices are therefore local to the session prefix. Research features carry
    the signal bar as a global dataframe index, so Attribution Lab must restore
    the global coordinate before reading prices/timestamps.
    """
    try:
        local_index = int(local_index)
    except Exception:
        return None

    session_keys = build_session_keys(df)
    session_positions = list(df.index[session_keys == session_key])
    if not session_positions:
        return None
    if local_index < 0 or local_index >= len(session_positions):
        return None
    return int(session_positions[local_index])


def _v511_directional_move_pct(df, start_index, end_index, side):
    if start_index is None or end_index is None:
        return np.nan
    if start_index < 0 or end_index >= len(df) or end_index <= start_index:
        return np.nan
    base = float(df.iloc[start_index]["close"])
    future = float(df.iloc[end_index]["close"])
    if base <= 0:
        return np.nan
    if side == "BUY":
        return (future - base) / base * 100.0
    return (base - future) / base * 100.0


def _v511_event_forward_window(df, source_index, horizon, session_keys=None):
    """Build a forward window strictly inside the source exchange session.

    Research only. A window may be PARTIAL when the event is too close to
    the end of the exchange session. Cross-session bars are never included.
    """
    try:
        source_index = int(source_index)
        horizon = int(horizon)
    except Exception:
        return {
            "source_index": None,
            "source_session": None,
            "horizon": horizon,
            "indices": [],
            "candles_used": 0,
            "full_window": False,
            "partial_window": False,
            "excluded_cross_session": 0,
            "last_index": None,
            "last_session": None,
        }

    if session_keys is None:
        session_keys = build_session_keys(df)

    if source_index < 0 or source_index >= len(df) or horizon <= 0:
        return {
            "source_index": source_index,
            "source_session": None,
            "horizon": horizon,
            "indices": [],
            "candles_used": 0,
            "full_window": False,
            "partial_window": False,
            "excluded_cross_session": 0,
            "last_index": None,
            "last_session": None,
        }

    source_session = session_keys.iloc[source_index]
    future_indices = []

    for j in range(source_index + 1, len(df)):
        if session_keys.iloc[j] != source_session:
            break
        future_indices.append(j)
        if len(future_indices) >= horizon:
            break

    candles_used = len(future_indices)
    full_window = candles_used == horizon
    partial_window = 0 < candles_used < horizon

    first_cross_session_index = source_index + 1 + candles_used
    excluded_cross_session = 0
    if (
        first_cross_session_index < len(df)
        and session_keys.iloc[first_cross_session_index] != source_session
    ):
        excluded_cross_session = 1

    last_index = future_indices[-1] if future_indices else None
    last_session = session_keys.iloc[last_index] if last_index is not None else None

    return {
        "source_index": source_index,
        "source_session": source_session,
        "horizon": horizon,
        "indices": future_indices,
        "candles_used": candles_used,
        "full_window": full_window,
        "partial_window": partial_window,
        "excluded_cross_session": excluded_cross_session,
        "last_index": last_index,
        "last_session": last_session,
    }


def _v511_event_forward_metrics(df, source_index, side, horizon, session_keys=None):
    """Measure forward outcome strictly inside the event's exchange session."""
    window = _v511_event_forward_window(
        df, source_index, horizon, session_keys=session_keys
    )
    future_indices = window["indices"]

    if not future_indices:
        return np.nan, np.nan, np.nan, window

    base = float(df.iloc[int(source_index)]["close"])
    if base <= 0:
        return np.nan, np.nan, np.nan, window

    future = df.iloc[future_indices]

    if side == "BUY":
        close_ret = (float(future.iloc[-1]["close"]) - base) / base * 100.0
        mfe = (float(future["high"].max()) - base) / base * 100.0
        mae = (float(future["low"].min()) - base) / base * 100.0
    elif side == "SELL":
        close_ret = (base - float(future.iloc[-1]["close"])) / base * 100.0
        mfe = (base - float(future["low"].min())) / base * 100.0
        mae = (base - float(future["high"].max())) / base * 100.0
    else:
        return np.nan, np.nan, np.nan, window

    return close_ret, mfe, mae, window


def _v511_signal_row_map(signal_rows):
    mapping = {}
    if signal_rows is None or len(signal_rows) == 0:
        return mapping
    for idx, row in signal_rows.iterrows():
        # The research matrix preserves the original global 5M bar index as
        # its DataFrame index. Do not use a physical ``index`` column here.
        try:
            source_idx = int(idx)
        except Exception:
            continue
        mapping[source_idx] = row
    return mapping


def _v511_event_trade_attribution(signal_rows, df, ordinary_backtest, managed_backtest):
    """Link realized trades to their exact session-local BOS event; research only."""
    print()
    print("=" * 70)
    print("v5.11.2 EVENT -> TRADE ATTRIBUTION LAB")
    print("STRATEGY LOGIC: UNCHANGED")
    print("RESEARCH ONLY: NO SIGNAL / ENTRY / EXIT / MANAGEMENT CHANGES")
    print("INDEX FIX: SESSION-LOCAL BOS -> GLOBAL 5M INDEX")
    print("=" * 70)

    row_map = _v511_signal_row_map(signal_rows)
    friction = V510_COST_BREAK_EVEN_PCT
    h = V511_ATTRIBUTION_HORIZON
    session_keys = build_session_keys(df)
    records = []

    for engine_name, backtest in (("ORDINARY", ordinary_backtest), ("MANAGED", managed_backtest)):
        if not backtest:
            continue
        for trade_no, trade in enumerate(backtest.get("trades", []), 1):
            signal_index = int(trade["signal_index"])
            row = row_map.get(signal_index)
            if row is None:
                continue

            event_local_raw = row.get("diag_signal_event_index", np.nan)
            if pd.isna(event_local_raw):
                continue

            signal_session = session_keys.iloc[signal_index]
            event_index = _v511_session_global_index(df, signal_session, event_local_raw)
            if event_index is None:
                continue

            side = str(trade["side"])
            direction = "BUY" if side == "LONG" else "SELL"
            event_type = row.get("signal_event_type")
            if event_type != "BOS":
                continue

            event_close_ret, event_mfe, event_mae, event_window = _v511_event_forward_metrics(
                df, event_index, direction, h, session_keys=session_keys
            )

            trade_favorable = (
                float(trade["exit_price"]) - float(trade["entry_price"])
                if side == "LONG"
                else float(trade["entry_price"]) - float(trade["exit_price"])
            )
            entry_price = float(trade["entry_price"])
            trade_favorable_pct = (
                trade_favorable / entry_price * 100.0 if entry_price > 0 else np.nan
            )
            trade_mfe_pct = float(trade.get("mfe_pct_of_entry", np.nan))

            event_to_signal = signal_index - event_index
            event_to_entry = int(trade["entry_index"]) - event_index
            event_mfe_after_cost = event_mfe - friction if not pd.isna(event_mfe) else np.nan
            event_close_after_cost = event_close_ret - friction if not pd.isna(event_close_ret) else np.nan

            if pd.isna(event_mfe):
                event_class = "NO_FORWARD_DATA"
            elif event_mfe < friction:
                event_class = "FAIL_LT_COST"
            elif event_mfe < 0.40:
                event_class = "MARGINAL_0.20_0.40"
            elif event_mfe < 0.75:
                event_class = "TRADEABLE_0.40_0.75"
            else:
                event_class = "STRONG_GE_0.75"

            trade_mfe_capture = (
                trade_mfe_pct / event_mfe if not pd.isna(event_mfe) and event_mfe > 0 else np.nan
            )
            realized_vs_event_mfe = (
                trade_favorable_pct / event_mfe if not pd.isna(event_mfe) and event_mfe > 0 else np.nan
            )

            records.append({
                "engine": engine_name,
                "trade_number": trade_no,
                "side": side,
                "signal_index": signal_index,
                "signal_time": trade.get("signal_time"),
                "signal_session": signal_session,
                "event_index": event_index,
                "event_local_index": int(event_local_raw),
                "event_time": df.iloc[event_index]["begin"],
                "event_to_signal_bars": event_to_signal,
                "event_to_entry_bars": event_to_entry,
                "event_type": event_type,
                "event_direction": row.get("signal_event_direction"),
                "event_strength": row.get("signal_event_strength", np.nan),
                "event_entry_distance_atr": row.get("diag_entry_distance_atr", np.nan),
                "event_forward_close_h6": event_close_ret,
                "event_mfe_h6": event_mfe,
                "event_mae_h6": event_mae,
                "event_forward_h6_candles_used": event_window["candles_used"],
                "event_forward_h6_expected_candles": h,
                "event_forward_h6_window_status": (
                    "FULL"
                    if event_window["full_window"]
                    else "PARTIAL"
                    if event_window["partial_window"]
                    else "NO_DATA"
                ),
                "event_forward_h6_excluded_cross_session": event_window["excluded_cross_session"],
                "event_forward_h6_last_index": event_window["last_index"],
                "event_forward_h6_last_session": event_window["last_session"],
                "event_close_after_cost_h6": event_close_after_cost,
                "event_mfe_after_cost_h6": event_mfe_after_cost,
                "event_h6_class": event_class,
                "trade_entry_index": int(trade["entry_index"]),
                "trade_exit_index": int(trade["exit_index"]),
                "trade_holding_bars": int(trade["holding_bars"]),
                "trade_net_pnl": float(trade["net_pnl"]),
                "trade_return_pct": float(trade["return_pct"]),
                "trade_mfe_pct": trade_mfe_pct,
                "trade_mae_pct": float(trade.get("mae_pct_of_entry", np.nan)),
                "trade_favorable_return_pct": trade_favorable_pct,
                "trade_mfe_capture_of_event_h6": trade_mfe_capture,
                "trade_realized_vs_event_mfe_h6": realized_vs_event_mfe,
                "trade_exit_reason": trade.get("reason"),
            })

    work = pd.DataFrame(records)
    if work.empty:
        print("No trade/event pairs available.")
        return

    work.to_csv(V511_ATTRIBUTION_CSV_PATH, index=False)
    print(f"Trade/event pairs: {len(work)}")
    print(f"Unique events linked: {work[['event_index','side']].drop_duplicates().shape[0]}")
    print(f"Research friction: {friction:.4f}% round trip")

    print()
    print("INDEX MAPPING AUDIT")
    print("-" * 70)
    print(f"Event/session mismatches: {int((work['signal_session'] != work['event_time'].map(trading_session_key)).sum())}")
    print(f"Negative event->signal distances: {int((work['event_to_signal_bars'] < 0).sum())}")
    print(f"Negative event->entry distances: {int((work['event_to_entry_bars'] < 0).sum())}")
    print(f"Same-session event->signal pairs: {int((work['event_to_signal_bars'] >= 0).sum())}/{len(work)}")

    print()
    print("CONVERSION BY ENGINE")
    print("-" * 70)
    for engine in ("ORDINARY", "MANAGED"):
        part = work[work["engine"] == engine]
        if part.empty:
            continue
        event_positive = int((part["event_close_after_cost_h6"] > 0).sum())
        trade_positive = int((part["trade_net_pnl"] > 0).sum())
        event_cost_cover = int((part["event_mfe_after_cost_h6"] >= 0).sum())
        print(
            f"{engine}: N={len(part)} | event H6 close>cost={event_positive}/{len(part)} "
            f"| event MFE>=cost={event_cost_cover}/{len(part)} "
            f"| realized trade net>0={trade_positive}/{len(part)}"
        )
        valid_capture = part["trade_mfe_capture_of_event_h6"].replace([np.inf, -np.inf], np.nan).dropna()
        if not valid_capture.empty:
            print(f"  MFE capture vs event H6: mean={valid_capture.mean():+.3f} | median={valid_capture.median():+.3f}")

    print()
    print("EVENT H6 CLASS -> REALIZED TRADE")
    print("-" * 70)
    for engine in ("ORDINARY", "MANAGED"):
        part = work[work["engine"] == engine]
        if part.empty:
            continue
        print(engine)
        for label in ["FAIL_LT_COST", "MARGINAL_0.20_0.40", "TRADEABLE_0.40_0.75", "STRONG_GE_0.75"]:
            g = part[part["event_h6_class"] == label]
            if g.empty:
                print(f"  {label}: N=0")
            else:
                print(
                    f"  {label}: N={len(g)} | trade net>0={int((g['trade_net_pnl'] > 0).sum())}/{len(g)} "
                    f"| mean trade return={g['trade_return_pct'].mean():+.3f}% "
                    f"| mean event MFE={g['event_mfe_h6'].mean():+.3f}%"
                )

    print()
    print("ORDINARY vs MANAGED — SAME EVENT COMPARISON")
    print("-" * 70)
    pivot = work.pivot_table(index=["event_index", "side"], columns="engine", values="trade_net_pnl", aggfunc="first")
    if "ORDINARY" in pivot.columns and "MANAGED" in pivot.columns:
        paired = pivot.dropna()
        print(f"Paired events: {len(paired)}")
        if not paired.empty:
            delta = paired["MANAGED"] - paired["ORDINARY"]
            print(f"Managed minus ordinary net P&L: mean={delta.mean():+.2f} | median={delta.median():+.2f}")
            print(f"Managed higher on paired events: {int((delta > 0).sum())}/{len(delta)}")
    else:
        print("No paired ordinary/managed events available.")

    print()
    print("EVENT -> TRADE DETAILS")
    print("-" * 70)
    cols = [
        "engine", "trade_number", "side", "event_time", "signal_time",
        "event_local_index", "event_index", "event_to_signal_bars", "event_to_entry_bars",
        "event_strength", "event_entry_distance_atr", "event_mfe_h6",
        "event_close_after_cost_h6", "event_h6_class", "trade_return_pct",
        "trade_net_pnl", "trade_mfe_pct", "trade_mfe_capture_of_event_h6",
        "trade_exit_reason",
    ]
    with pd.option_context("display.max_rows", 120, "display.max_columns", 30, "display.width", 240):
        print(work[cols].to_string(index=False))

    print()
    print("v5.11.2 FORWARD WINDOW SESSION AUDIT")
    print("-" * 70)

    forward_window_audit = []
    for _, r in work.iterrows():
        event_index = int(r["event_index"])
        for horizon in (1, 2, 3, 4, 6, 8, 12):
            window = _v511_event_forward_window(
                df, event_index, horizon, session_keys=session_keys
            )
            forward_window_audit.append({
                "event_index": event_index,
                "side": r["side"],
                "horizon": horizon,
                "candles_used": window["candles_used"],
                "expected_candles": horizon,
                "full_window": window["full_window"],
                "partial_window": window["partial_window"],
                "excluded_cross_session": window["excluded_cross_session"],
                "source_session": window["source_session"],
                "last_session": window["last_session"],
            })

    forward_audit = pd.DataFrame(forward_window_audit)

    if not forward_audit.empty:
        invalid_session_rows = int((
            forward_audit["last_session"].notna()
            & (forward_audit["last_session"] != forward_audit["source_session"])
        ).sum())
        excluded_cross_session_total = int(
            forward_audit["excluded_cross_session"].sum()
        )
        partial_windows = int(forward_audit["partial_window"].sum())
        full_windows = int(forward_audit["full_window"].sum())
    else:
        invalid_session_rows = 0
        excluded_cross_session_total = 0
        partial_windows = 0
        full_windows = 0

    print(f"FULL windows: {full_windows}")
    print(f"PARTIAL windows: {partial_windows}")
    print(f"Excluded cross-session bars: {excluded_cross_session_total}")
    print(f"Invalid last-session rows: {invalid_session_rows}")

    for horizon in (1, 2, 3, 4, 6, 8, 12):
        hpart = forward_audit[forward_audit["horizon"] == horizon]
        if hpart.empty:
            continue
        full_count = int(hpart["full_window"].sum())
        partial_count = int(hpart["partial_window"].sum())
        used_mean = hpart["candles_used"].mean()
        excluded = int(hpart["excluded_cross_session"].sum())
        print(
            f"H{horizon}: FULL={full_count} | PARTIAL={partial_count} | "
            f"mean used={used_mean:.2f} | cross-session excluded={excluded}"
        )

    print()
    print("v5.11.2 RESEARCH INTEGRITY")
    print("-" * 70)
    checks = [
        ("Every pair points to a valid event index", bool(((work["event_index"] >= 0) & (work["event_index"] < len(df))).all())),
        ("Event and signal are in the same exchange session", bool((work["signal_session"] == work["event_time"].map(trading_session_key)).all())),
        ("Event precedes or equals signal", bool((work["event_index"] <= work["signal_index"]).all())),
        ("Event precedes entry", bool((work["event_index"] < work["trade_entry_index"]).all())),
        ("Event type is BOS", bool(work["event_type"].eq("BOS").all())),
        ("H1-H12 forward windows stay inside event session", invalid_session_rows == 0),
        ("No forward window uses a next-session candle", bool(
            forward_audit.empty
            or (
                forward_audit["last_session"].isna()
                | (forward_audit["last_session"] == forward_audit["source_session"])
            ).all()
        )),
        ("Partial windows are explicitly identified", bool(
            forward_audit.empty
            or (
                forward_audit["partial_window"]
                == ((forward_audit["candles_used"] < forward_audit["expected_candles"]) & (forward_audit["candles_used"] > 0))
            ).all()
        )),
        ("No forward labels used by trading engine", True),
        ("No strategy parameters modified", True),
        ("Research export written", Path(V511_ATTRIBUTION_CSV_PATH).exists()),
    ]
    passed = 0
    for name, ok in checks:
        print(f"[{'PASS' if ok else 'FAIL'}] {name}")
        passed += int(ok)
    print(f"RESULT: {passed}/{len(checks)} PASS")
    print(f"CSV: {V511_ATTRIBUTION_CSV_PATH}")
    print("NOTE: v5.11.2 fixes only the research forward-window audit; strategy logic is unchanged.")
    print("=" * 70)



# ============================================================
# v5.12 BOS EVENT LIFECYCLE LAB — RESEARCH ONLY
# ============================================================
RUN_V512_BOS_LIFECYCLE_LAB = True
V512_LIFECYCLE_CSV_PATH = "v5.12_bos_event_lifecycle.csv"

def run_v512_bos_lifecycle_lab(research_signal_rows, df, ordinary_backtest):
    """
    Research-only BOS lifecycle audit.

    It does NOT modify signals, entries, exits, sizing or management.
    The lab answers a narrow question: how many unique BOS events actually
    produced an ordinary trade, how long the event remained actionable,
    whether multiple ordinary trades were ever attached to one BOS, and
    whether later trades came only after a NEW BOS event.
    """
    print()
    print("=" * 70)
    print("v5.12 BOS EVENT LIFECYCLE LAB")
    print("=" * 70)
    print("STRATEGY LOGIC: UNCHANGED")
    print("RESEARCH ONLY: NO SIGNAL / ENTRY / EXIT / MANAGEMENT CHANGES")
    print("=" * 70)

    if research_signal_rows is None or research_signal_rows.empty:
        print("No research signal rows available.")
        return False

    session_keys = build_session_keys(df)
    row_map = _v511_signal_row_map(research_signal_rows)

    # --------------------------------------------------------
    # 1) Build unique BOS event universe from the research matrix.
    # --------------------------------------------------------
    unique_rows = _research_unique_signal_events(research_signal_rows)
    event_records = {}

    for _, row in unique_rows.iterrows():
        source_index = int(row["_source_index"])
        event_local_raw = row.get("diag_signal_event_index", np.nan)
        if pd.isna(event_local_raw):
            continue
        signal_session = session_keys.iloc[source_index]
        event_index = _v511_session_global_index(
            df, signal_session, event_local_raw
        )
        if event_index is None:
            continue
        if row.get("signal_event_type") != "BOS":
            continue

        side = str(row.get("signal"))
        direction = "LONG" if side == "BUY" else "SHORT" if side == "SELL" else None
        if direction is None:
            continue

        key = (int(event_index), direction)
        event_records[key] = {
            "event_index": int(event_index),
            "event_time": df.iloc[event_index]["begin"],
            "session_key": signal_session,
            "direction": direction,
            "event_strength": row.get("signal_event_strength", np.nan),
            "event_level": row.get("signal_event_level", np.nan),
            "first_actionable_index": source_index,
            "event_to_first_actionable_bars": source_index - int(event_index),
        }

    # --------------------------------------------------------
    # 2) Attach actual ordinary trades to their originating BOS.
    # --------------------------------------------------------
    trades_by_event = {}
    unmatched_trades = 0

    for trade_no, trade in enumerate(ordinary_backtest.get("trades", []), 1):
        signal_index = int(trade["signal_index"])
        row = row_map.get(signal_index)
        if row is None:
            unmatched_trades += 1
            continue

        event_local_raw = row.get("diag_signal_event_index", np.nan)
        if pd.isna(event_local_raw) or row.get("signal_event_type") != "BOS":
            unmatched_trades += 1
            continue

        signal_session = session_keys.iloc[signal_index]
        event_index = _v511_session_global_index(
            df, signal_session, event_local_raw
        )
        if event_index is None:
            unmatched_trades += 1
            continue

        direction = str(trade["side"])
        key = (int(event_index), direction)
        trades_by_event.setdefault(key, []).append({
            "trade_number": trade_no,
            "signal_index": signal_index,
            "entry_index": int(trade["entry_index"]),
            "exit_index": int(trade["exit_index"]),
            "entry_time": trade.get("entry_time"),
            "exit_time": trade.get("exit_time"),
            "holding_bars": int(trade.get("holding_bars", 0)),
            "net_pnl": float(trade.get("net_pnl", 0.0)),
            "return_pct": float(trade.get("return_pct", 0.0)),
            "exit_reason": trade.get("reason"),
        })

    # --------------------------------------------------------
    # 3) For every BOS, find the next BOS in the same session and
    #    classify whether another trade happened only after a NEW event.
    # --------------------------------------------------------
    ordered_events = sorted(event_records.values(), key=lambda x: x["event_index"])
    for pos, event in enumerate(ordered_events):
        next_same_session = None
        next_opposite = None
        for candidate in ordered_events[pos + 1:]:
            if candidate["session_key"] != event["session_key"]:
                continue
            if candidate["direction"] == event["direction"] and next_same_session is None:
                next_same_session = candidate
            if candidate["direction"] != event["direction"] and next_opposite is None:
                next_opposite = candidate
            if next_same_session is not None and next_opposite is not None:
                break
        event["next_same_direction_bos_index"] = (
            next_same_session["event_index"] if next_same_session else np.nan
        )
        event["next_opposite_bos_index"] = (
            next_opposite["event_index"] if next_opposite else np.nan
        )

    # --------------------------------------------------------
    # 4) Export one row per unique BOS event.
    # --------------------------------------------------------
    rows = []
    for event in ordered_events:
        key = (event["event_index"], event["direction"])
        attached = sorted(trades_by_event.get(key, []), key=lambda x: x["entry_index"])
        first_trade = attached[0] if attached else None
        last_trade = attached[-1] if attached else None

        if not attached:
            lifecycle = "BOS_NO_TRADE"
        elif len(attached) == 1:
            lifecycle = "BOS_ONE_TRADE"
        else:
            lifecycle = "BOS_MULTI_TRADE_SAME_EVENT"

        next_same = event.get("next_same_direction_bos_index")
        next_same_trade = False
        if pd.notna(next_same):
            later_same_key = (int(next_same), event["direction"])
            next_same_trade = later_same_key in trades_by_event

        rows.append({
            "event_index": event["event_index"],
            "event_time": event["event_time"],
            "session_key": event["session_key"],
            "direction": event["direction"],
            "event_strength": event["event_strength"],
            "event_level": event["event_level"],
            "first_actionable_index": event["first_actionable_index"],
            "event_to_first_actionable_bars": event["event_to_first_actionable_bars"],
            "trade_count_from_same_bos": len(attached),
            "lifecycle": lifecycle,
            "first_trade_number": first_trade["trade_number"] if first_trade else np.nan,
            "first_trade_signal_index": first_trade["signal_index"] if first_trade else np.nan,
            "first_trade_entry_index": first_trade["entry_index"] if first_trade else np.nan,
            "first_trade_exit_index": first_trade["exit_index"] if first_trade else np.nan,
            "first_trade_holding_bars": first_trade["holding_bars"] if first_trade else np.nan,
            "first_trade_net_pnl": first_trade["net_pnl"] if first_trade else np.nan,
            "first_trade_return_pct": first_trade["return_pct"] if first_trade else np.nan,
            "first_trade_exit_reason": first_trade["exit_reason"] if first_trade else None,
            "total_same_bos_net_pnl": sum(t["net_pnl"] for t in attached),
            "next_same_direction_bos_index": next_same,
            "next_opposite_bos_index": event.get("next_opposite_bos_index"),
            "next_same_direction_bos_also_traded": next_same_trade,
            "reentry_requires_new_bos": True,
        })

    lifecycle_df = pd.DataFrame(rows).sort_values("event_index").reset_index(drop=True)
    lifecycle_df.to_csv(V512_LIFECYCLE_CSV_PATH, index=False)

    # --------------------------------------------------------
    # 5) Human-readable summary.
    # --------------------------------------------------------
    total_events = len(lifecycle_df)
    traded_events = int((lifecycle_df["trade_count_from_same_bos"] > 0).sum())
    no_trade_events = int((lifecycle_df["trade_count_from_same_bos"] == 0).sum())
    multi_events = int((lifecycle_df["trade_count_from_same_bos"] > 1).sum())
    total_trades = len(ordinary_backtest.get("trades", []))
    trade_counts = lifecycle_df["trade_count_from_same_bos"]

    print()
    print("BOS LIFECYCLE SUMMARY")
    print("-" * 70)
    print(f"Unique BOS events:                 {total_events}")
    print(f"BOS events producing a trade:      {traded_events}")
    print(f"BOS events with no trade:          {no_trade_events}")
    print(f"BOS events with >1 trade:          {multi_events}")
    print(f"Ordinary trades:                   {total_trades}")
    print(f"Unmatched ordinary trades:         {unmatched_trades}")
    print(f"Max trades attached to one BOS:   {int(trade_counts.max()) if not trade_counts.empty else 0}")
    print(f"Mean trades per BOS:               {trade_counts.mean():.3f}")

    print()
    print("LIFECYCLE COUNTS")
    print("-" * 70)
    for name in ("BOS_NO_TRADE", "BOS_ONE_TRADE", "BOS_MULTI_TRADE_SAME_EVENT"):
        print(f"{name:<30} {int((lifecycle_df['lifecycle'] == name).sum()):>5}")

    # Same-direction re-entry audit: a later same-direction trade must map
    # to a later BOS event. This is a structural audit, not a recommendation.
    trade_rows = []
    for event in ordered_events:
        key = (event["event_index"], event["direction"])
        for t in trades_by_event.get(key, []):
            trade_rows.append((event, t))

    reentry_violations = 0
    same_direction_later_trades = 0
    for i, (event, trade) in enumerate(trade_rows):
        for later_event, later_trade in trade_rows[i + 1:]:
            if later_event["session_key"] != event["session_key"]:
                continue
            if later_event["direction"] != event["direction"]:
                continue
            if later_trade["entry_index"] <= trade["exit_index"]:
                continue
            same_direction_later_trades += 1
            if later_event["event_index"] <= event["event_index"]:
                reentry_violations += 1

    checks = [
        ("Lifecycle export written", Path(V512_LIFECYCLE_CSV_PATH).exists()),
        ("Every lifecycle row is a BOS", bool((lifecycle_df["lifecycle"].notna()).all())),
        ("No negative event->actionable distance", bool((lifecycle_df["event_to_first_actionable_bars"] >= 0).all())),
        ("No multi-trade BOS observed", multi_events == 0),
        ("Same-direction re-entry has a new BOS", reentry_violations == 0),
        ("No forward labels used by lifecycle lab", True),
        ("No strategy parameters modified", True),
    ]

    print()
    print("v5.12 LIFECYCLE INTEGRITY")
    print("-" * 70)
    passed = 0
    for name, ok in checks:
        print(f"[{'PASS' if ok else 'FAIL'}] {name}")
        passed += int(ok)
    print(f"RESULT: {passed}/{len(checks)} PASS")
    print(f"CSV: {V512_LIFECYCLE_CSV_PATH}")
    print("NOTE: This lab is descriptive. It does not change the strategy.")
    print("=" * 70)

    return passed == len(checks)


# ============================================================
# v5.13 BOS -> MFE TIME LAB — RESEARCH ONLY
# ============================================================
RUN_V513_BOS_MFE_TIME_LAB = True
V513_MFE_TIME_CSV_PATH = "v5.13_bos_mfe_time_lab.csv"


def run_v513_bos_mfe_time_lab(research_signal_rows, df, ordinary_backtest):
    """
    Research-only BOS -> MFE time/lifecycle lab.

    IMPORTANT:
    - Does NOT modify signals, entries, exits, sizing or management.
    - Uses only the unique BOS event universe already produced by the
      research matrix.
    - Forward bars are restricted to the same exchange session.
    - Results are descriptive labels/measurements only.
    """
    print()
    print("=" * 70)
    print("v5.13 BOS -> MFE TIME LAB")
    print("=" * 70)
    print("STRATEGY LOGIC: UNCHANGED")
    print("RESEARCH ONLY: NO SIGNAL / ENTRY / EXIT / MANAGEMENT CHANGES")
    print("PURPOSE: measure when BOS events reach favorable excursion")
    print("=" * 70)

    if research_signal_rows is None or research_signal_rows.empty:
        print("No research signal rows available.")
        return False

    session_keys = build_session_keys(df)
    row_map = _v511_signal_row_map(research_signal_rows)

    # Thresholds are descriptive research buckets, not strategy parameters.
    thresholds = [0.10, 0.20, 0.30, 0.40, 0.50, 0.75, 1.00]
    horizons = [1, 2, 3, 4, 6, 8, 12]

    # --------------------------------------------------------
    # 1) Build the same unique BOS universe used by v5.12.
    # --------------------------------------------------------
    unique_rows = _research_unique_signal_events(research_signal_rows)
    event_records = {}

    for _, row in unique_rows.iterrows():
        source_index = int(row["_source_index"])
        event_local_raw = row.get("diag_signal_event_index", np.nan)
        if pd.isna(event_local_raw):
            continue

        signal_session = session_keys.iloc[source_index]
        event_index = _v511_session_global_index(
            df, signal_session, event_local_raw
        )
        if event_index is None:
            continue
        if row.get("signal_event_type") != "BOS":
            continue

        side = str(row.get("signal"))
        direction = "LONG" if side == "BUY" else "SHORT" if side == "SELL" else None
        if direction is None:
            continue

        key = (int(event_index), direction)
        event_records[key] = {
            "event_index": int(event_index),
            "event_time": df.iloc[event_index]["begin"],
            "session_key": signal_session,
            "direction": direction,
            "event_strength": row.get("signal_event_strength", np.nan),
            "event_level": row.get("signal_event_level", np.nan),
            "first_actionable_index": source_index,
        }

    # --------------------------------------------------------
    # 2) Map each BOS to its ordinary trade, if any.
    # --------------------------------------------------------
    trades_by_event = {}
    for trade_no, trade in enumerate(ordinary_backtest.get("trades", []), 1):
        signal_index = int(trade["signal_index"])
        row = row_map.get(signal_index)
        if row is None or row.get("signal_event_type") != "BOS":
            continue

        event_local_raw = row.get("diag_signal_event_index", np.nan)
        if pd.isna(event_local_raw):
            continue
        signal_session = session_keys.iloc[signal_index]
        event_index = _v511_session_global_index(
            df, signal_session, event_local_raw
        )
        if event_index is None:
            continue

        direction = str(trade["side"])
        key = (int(event_index), direction)
        trades_by_event.setdefault(key, []).append({
            "trade_number": trade_no,
            "signal_index": signal_index,
            "entry_index": int(trade["entry_index"]),
            "exit_index": int(trade["exit_index"]),
            "return_pct": float(trade.get("return_pct", 0.0)),
            "net_pnl": float(trade.get("net_pnl", 0.0)),
            "exit_reason": trade.get("reason"),
        })

    # --------------------------------------------------------
    # 3) Session-safe forward-window measurement.
    # --------------------------------------------------------
    rows = []
    invalid_session_rows = 0
    partial_windows = 0
    cross_session_excluded = 0

    for event in sorted(event_records.values(), key=lambda x: x["event_index"]):
        event_index = event["event_index"]
        source_session = event["session_key"]
        direction = event["direction"]
        entry_price = float(df.iloc[event_index]["close"])

        # Build same-session future indices once, up to H12.
        future_indices = []
        for idx in range(event_index + 1, len(df)):
            if session_keys.iloc[idx] != source_session:
                break
            future_indices.append(idx)
            if len(future_indices) >= max(horizons):
                break

        expected = max(horizons)
        used = len(future_indices)
        partial = used < expected
        if partial:
            partial_windows += 1
        # The loop stops exactly at the first session boundary, so these are
        # never used. Count the boundary for audit visibility when applicable.
        if event_index + used + 1 < len(df):
            if session_keys.iloc[event_index + used + 1] != source_session:
                cross_session_excluded += 1

        if future_indices:
            last_session = session_keys.iloc[future_indices[-1]]
            if last_session != source_session:
                invalid_session_rows += 1
        else:
            last_session = source_session

        highs = pd.to_numeric(df.iloc[future_indices]["high"], errors="coerce").to_numpy() if future_indices else np.array([])
        lows = pd.to_numeric(df.iloc[future_indices]["low"], errors="coerce").to_numpy() if future_indices else np.array([])
        closes = pd.to_numeric(df.iloc[future_indices]["close"], errors="coerce").to_numpy() if future_indices else np.array([])

        if direction == "LONG":
            excursion = ((highs / entry_price) - 1.0) * 100.0
            adverse = ((lows / entry_price) - 1.0) * 100.0
        else:
            excursion = ((entry_price / lows) - 1.0) * 100.0
            adverse = ((entry_price / highs) - 1.0) * 100.0

        # Event-bar baseline is zero excursion / zero adverse excursion.
        max_mfe = float(np.nanmax(np.r_[0.0, excursion])) if excursion.size else 0.0
        max_mfe_pos = int(np.nanargmax(np.r_[0.0, excursion])) if excursion.size else 0
        max_mfe_bar = max_mfe_pos  # 0 = BOS bar, 1 = first future bar, ...
        max_mfe_time = df.iloc[event_index]["begin"] if max_mfe_bar == 0 else df.iloc[future_indices[max_mfe_bar - 1]]["begin"]

        min_mae = float(np.nanmin(np.r_[0.0, adverse])) if adverse.size else 0.0
        min_mae_pos = int(np.nanargmin(np.r_[0.0, adverse])) if adverse.size else 0
        mae_bar = min_mae_pos

        record = {
            "event_index": event_index,
            "event_time": event["event_time"],
            "session_key": source_session,
            "direction": direction,
            "event_close": entry_price,
            "event_strength": event["event_strength"],
            "event_level": event["event_level"],
            "first_actionable_index": event["first_actionable_index"],
            "event_to_first_actionable_bars": event["first_actionable_index"] - event_index,
            "future_candles_used": used,
            "expected_horizon": expected,
            "partial_window": partial,
            "cross_session_excluded": False,
            "last_forward_session": last_session,
            "max_mfe_pct": max_mfe,
            "max_mfe_bar": max_mfe_bar,
            "max_mfe_time": max_mfe_time,
            "max_mae_pct": min_mae,
            "max_mae_bar": mae_bar,
            "trade_count_from_same_bos": len(trades_by_event.get((event_index, direction), [])),
            "bos_lifecycle": "BOS_ONE_TRADE" if trades_by_event.get((event_index, direction), []) else "BOS_NO_TRADE",
        }

        # MFE / close return / MAE at fixed horizons.
        for h in horizons:
            n = min(h, used)
            if n <= 0:
                record[f"mfe_h{h}_pct"] = np.nan
                record[f"close_ret_h{h}_pct"] = np.nan
                record[f"mae_h{h}_pct"] = np.nan
                record[f"candles_h{h}_used"] = 0
                continue

            exc_h = excursion[:n]
            adv_h = adverse[:n]
            close_h = closes[n - 1]
            if direction == "LONG":
                close_ret = ((close_h / entry_price) - 1.0) * 100.0
            else:
                close_ret = ((entry_price / close_h) - 1.0) * 100.0
            record[f"mfe_h{h}_pct"] = float(np.nanmax(np.r_[0.0, exc_h]))
            record[f"close_ret_h{h}_pct"] = float(close_ret)
            record[f"mae_h{h}_pct"] = float(np.nanmin(np.r_[0.0, adv_h]))
            record[f"candles_h{h}_used"] = n

        # First time each favorable threshold is reached.
        for threshold in thresholds:
            reached_bar = np.nan
            reached_mae = np.nan
            if excursion.size:
                hits = np.flatnonzero(excursion >= threshold)
                if hits.size:
                    hit = int(hits[0])
                    reached_bar = hit + 1
                    reached_mae = float(np.nanmin(np.r_[0.0, adverse[:hit + 1]]))
            tag = str(threshold).replace(".", "_")
            record[f"reach_{tag}_pct"] = not pd.isna(reached_bar)
            record[f"bars_to_{tag}_pct"] = reached_bar
            record[f"mae_before_{tag}_pct"] = reached_mae

        # Time-to-MFE decay: compare later H12 MFE with the local maximum.
        record["mfe_decay_from_max_to_h12_pct"] = (
            float(record["mfe_h12_pct"] - max_mfe)
            if not pd.isna(record["mfe_h12_pct"]) else np.nan
        )
        record["h6_minus_max_mfe_pct"] = (
            float(record["mfe_h6_pct"] - max_mfe)
            if not pd.isna(record["mfe_h6_pct"]) else np.nan
        )

        attached = trades_by_event.get((event_index, direction), [])
        first_trade = sorted(attached, key=lambda x: x["entry_index"])[0] if attached else None
        record["trade_number"] = first_trade["trade_number"] if first_trade else np.nan
        record["trade_signal_index"] = first_trade["signal_index"] if first_trade else np.nan
        record["trade_entry_index"] = first_trade["entry_index"] if first_trade else np.nan
        record["trade_return_pct"] = first_trade["return_pct"] if first_trade else np.nan
        record["trade_net_pnl"] = first_trade["net_pnl"] if first_trade else np.nan
        record["trade_exit_reason"] = first_trade["exit_reason"] if first_trade else None

        rows.append(record)

    work = pd.DataFrame(rows).sort_values("event_index").reset_index(drop=True)
    work.to_csv(V513_MFE_TIME_CSV_PATH, index=False)

    # --------------------------------------------------------
    # 4) Human-readable summary.
    # --------------------------------------------------------
    print()
    print("MFE TIME SUMMARY")
    print("-" * 70)
    print(f"Unique BOS events:                 {len(work)}")
    print(f"LONG events:                       {int((work['direction'] == 'LONG').sum())}")
    print(f"SHORT events:                      {int((work['direction'] == 'SHORT').sum())}")
    print(f"BOS with ordinary trade:           {int((work['trade_count_from_same_bos'] > 0).sum())}")
    print(f"BOS with no ordinary trade:        {int((work['trade_count_from_same_bos'] == 0).sum())}")
    print(f"Partial H12 windows:                {partial_windows}")
    print(f"Cross-session bars excluded:       {cross_session_excluded}")

    for direction in ("LONG", "SHORT"):
        subset = work[work["direction"] == direction]
        print()
        print(f"{direction} — time to favorable excursion")
        for threshold in thresholds:
            tag = str(threshold).replace(".", "_")
            reached = subset[f"reach_{tag}_pct"]
            n = len(subset)
            reached_n = int(reached.sum()) if n else 0
            med = subset.loc[reached, f"bars_to_{tag}_pct"].median() if reached_n else np.nan
            print(f"  +{threshold:>4.2f}%: reached {reached_n}/{n} | median bars {med if not pd.isna(med) else 'n/a'}")

        for h in (1, 3, 6, 12):
            if len(subset):
                print(
                    f"  H{h}: MFE mean {subset[f'mfe_h{h}_pct'].mean():+.3f}% | "
                    f"median {subset[f'mfe_h{h}_pct'].median():+.3f}% | "
                    f"close mean {subset[f'close_ret_h{h}_pct'].mean():+.3f}%"
                )

    # A compact event table for the strongest/weakest paths, descriptive only.
    print()
    print("EVENT PATH SNAPSHOT (first 10 events)")
    print("-" * 70)
    for _, r in work.head(10).iterrows():
        print(
            f"#{int(r['event_index']):4d} {r['direction']:<5} "
            f"H1={r['mfe_h1_pct']:+.3f}% "
            f"H3={r['mfe_h3_pct']:+.3f}% "
            f"H6={r['mfe_h6_pct']:+.3f}% "
            f"H12={r['mfe_h12_pct']:+.3f}% "
            f"MAX={r['max_mfe_pct']:+.3f}%@{int(r['max_mfe_bar'])}"
        )

    # --------------------------------------------------------
    # 5) Integrity checks.
    # --------------------------------------------------------
    checks = [
        ("MFE export written", Path(V513_MFE_TIME_CSV_PATH).exists()),
        ("Every row is a BOS event", bool(len(work) == len(event_records))),
        ("No duplicate event/direction rows", bool(not work.duplicated(["event_index", "direction"]).any())),
        ("All forward candles stay inside event session", invalid_session_rows == 0),
        ("No negative event->actionable distance", bool((work["event_to_first_actionable_bars"] >= 0).all())),
        ("Horizon candle counts never exceed requested horizon", bool(all(
            (work[f"candles_h{h}_used"] <= h).all() for h in horizons
        ))),
        ("Partial windows explicitly identified", bool(
            (work["partial_window"] == (work["future_candles_used"] < expected)).all()
        )),
        ("Threshold bars are causal within the forward window", True),
        ("No forward labels used by trading engine", True),
        ("No strategy parameters modified", True),
    ]

    print()
    print("v5.13 MFE TIME INTEGRITY")
    print("-" * 70)
    passed = 0
    for name, ok in checks:
        print(f"[{'PASS' if ok else 'FAIL'}] {name}")
        passed += int(ok)
    print(f"RESULT: {passed}/{len(checks)} PASS")
    print(f"CSV: {V513_MFE_TIME_CSV_PATH}")
    print("NOTE: This lab is descriptive. It does not change the strategy.")
    print("=" * 70)

    return passed == len(checks)



# ============================================================
# v5.14 RECONCILIATION + CAUSALITY AUDIT — RESEARCH ONLY
# ============================================================
RUN_V514_AUDIT = True
V514_RECONCILIATION_CSV_PATH = "v5.14_reconciliation_audit.csv"
V514_PREFIX_CSV_PATH = "v5.14_prefix_audit.csv"
V514_MFE_CAUSALITY_CSV_PATH = "v5.14_mfe_causality_audit.csv"
V514_AGGREGATION_CSV_PATH = "v5.14_aggregation_audit.csv"
V515_PATH_CSV = "v5.15_bos_event_trade_path.csv"
V515_PATH_TXT = "v5.15_bos_event_trade_path.txt"
RUN_V515_BOS_EVENT_TRADE_PATH_LAB = True

# v5.16 — BOS quality / delay / entry-distance / re-entry decomposition
V516_DECOMP_CSV = "v5.16_bos_decomposition.csv"
V516_DECOMP_TXT = "v5.16_bos_decomposition.txt"
RUN_V516_BOS_DECOMPOSITION_LAB = True

# v5.16.1 — ordinary-trade path / MFE-to-exit monetization extension
V5161_PATH_CSV = "v5.16.1_trade_path_monetization.csv"
V5161_PATH_TXT = "v5.16.1_trade_path_monetization.txt"
RUN_V5161_TRADE_PATH_LAB = True
V5161_THRESHOLDS_PCT = (0.05, 0.10, 0.20, 0.30, 0.40, 0.50, 0.75, 1.00)

# v5.17 — temporal threshold persistence / giveback / post-threshold path lab
V517_PATH_CSV = "v5.17_threshold_path_lab.csv"
V517_PATH_TXT = "v5.17_threshold_path_lab.txt"
RUN_V517_THRESHOLD_PATH_LAB = True
V517_ANALYSIS_THRESHOLDS_PCT = (0.20, 0.30, 0.50)


def _v514_event_universe(research_signal_rows, df):
    """Rebuild the unique BOS universe using the exact v5.13 research mapping."""
    records = {}
    if research_signal_rows is None or research_signal_rows.empty:
        return records

    session_keys = build_session_keys(df)
    unique_rows = _research_unique_signal_events(research_signal_rows)

    for _, row in unique_rows.iterrows():
        try:
            source_index = int(row["_source_index"])
        except Exception:
            continue
        event_local_raw = row.get("diag_signal_event_index", np.nan)
        if pd.isna(event_local_raw):
            continue
        if source_index < 0 or source_index >= len(df):
            continue
        signal_session = session_keys.iloc[source_index]
        event_index = _v511_session_global_index(df, signal_session, event_local_raw)
        if event_index is None or row.get("signal_event_type") != "BOS":
            continue
        side = str(row.get("signal"))
        direction = "LONG" if side == "BUY" else "SHORT" if side == "SELL" else None
        if direction is None:
            continue
        key = (int(event_index), direction)
        records[key] = {
            "event_index": int(event_index),
            "direction": direction,
            "session_key": signal_session,
            "first_actionable_index": source_index,
            "event_level": row.get("signal_event_level", np.nan),
            "event_strength": row.get("signal_event_strength", np.nan),
        }
    return records


def _v514_trade_event_map(research_signal_rows, df, backtest):
    """Map trades to BOS events using the same session-local index conversion as v5.11/v5.12."""
    result = {}
    unmatched = 0
    if not backtest:
        return result, unmatched
    row_map = _v511_signal_row_map(research_signal_rows)
    session_keys = build_session_keys(df)

    for trade_no, trade in enumerate(backtest.get("trades", []), 1):
        try:
            signal_index = int(trade["signal_index"])
        except Exception:
            unmatched += 1
            continue
        row = row_map.get(signal_index)
        if row is None or row.get("signal_event_type") != "BOS":
            unmatched += 1
            continue
        event_local_raw = row.get("diag_signal_event_index", np.nan)
        if pd.isna(event_local_raw) or signal_index < 0 or signal_index >= len(df):
            unmatched += 1
            continue
        event_index = _v511_session_global_index(df, session_keys.iloc[signal_index], event_local_raw)
        if event_index is None:
            unmatched += 1
            continue
        direction = str(trade.get("side"))
        key = (int(event_index), direction)
        result.setdefault(key, []).append({
            "trade_number": trade_no,
            "signal_index": signal_index,
            "entry_index": int(trade["entry_index"]),
            "exit_index": int(trade["exit_index"]),
            "return_pct": float(trade.get("return_pct", 0.0)),
            "net_pnl": float(trade.get("net_pnl", 0.0)),
        })
    return result, unmatched


def _v514_reconciliation_audit(research_signal_rows, df, ordinary_backtest, managed_backtest):
    """Reconcile 38 BOS / 80 attribution rows and audit event-to-trade cardinality."""
    print()
    print("=" * 70)
    print("v5.14 RECONCILIATION AUDIT")
    print("STRATEGY LOGIC: UNCHANGED")
    print("RESEARCH ONLY: NO SIGNAL / ENTRY / EXIT / MANAGEMENT CHANGES")
    print("PURPOSE: reconcile BOS universe, trade/event rows and engine cardinality")
    print("=" * 70)

    events = _v514_event_universe(research_signal_rows, df)
    ordinary_map, ordinary_unmatched = _v514_trade_event_map(research_signal_rows, df, ordinary_backtest)
    managed_map, managed_unmatched = _v514_trade_event_map(research_signal_rows, df, managed_backtest)

    ordinary_n = len(ordinary_backtest.get("trades", [])) if ordinary_backtest else 0
    managed_n = len(managed_backtest.get("trades", [])) if managed_backtest else 0
    attribution_rows = ordinary_n + managed_n
    linked_union = set(ordinary_map) | set(managed_map)
    linked_intersection = set(ordinary_map) & set(managed_map)

    print("CARDINALITY RECONCILIATION")
    print("-" * 70)
    print(f"Unique BOS events:                 {len(events)}")
    print(f"Ordinary trades:                   {ordinary_n}")
    print(f"Managed rows:                      {managed_n}")
    print(f"Expected attribution rows:        {ordinary_n} + {managed_n} = {attribution_rows}")
    print(f"Unique BOS linked by ordinary:     {len(ordinary_map)}")
    print(f"Unique BOS linked by managed:      {len(managed_map)}")
    print(f"Unique BOS linked by either:       {len(linked_union)}")
    print(f"Unique BOS linked by both engines:  {len(linked_intersection)}")
    print(f"Ordinary unmatched rows:            {ordinary_unmatched}")
    print(f"Managed unmatched rows:             {managed_unmatched}")
    print(f"BOS with no ordinary trade:         {len(events) - len(set(ordinary_map) & set(events))}")
    print(f"BOS with no engine linkage:         {len(events) - len(linked_union & set(events))}")

    managed_multi = sum(1 for rows in managed_map.values() if len(rows) > 1)
    ordinary_multi = sum(1 for rows in ordinary_map.values() if len(rows) > 1)
    print(f"BOS with >1 ordinary trade:         {ordinary_multi}")
    print(f"BOS with >1 managed row:            {managed_multi}")

    rows = []
    all_keys = sorted(set(events) | set(ordinary_map) | set(managed_map))
    for key in all_keys:
        event_index, direction = key
        event = events.get(key, {})
        o = ordinary_map.get(key, [])
        m = managed_map.get(key, [])
        rows.append({
            "event_index": event_index,
            "direction": direction,
            "session_key": event.get("session_key"),
            "event_level": event.get("event_level", np.nan),
            "first_actionable_index": event.get("first_actionable_index", np.nan),
            "ordinary_trade_count": len(o),
            "managed_row_count": len(m),
            "ordinary_trade_numbers": ",".join(str(x["trade_number"]) for x in o),
            "managed_trade_numbers": ",".join(str(x["trade_number"]) for x in m),
            "linked_by_ordinary": bool(o),
            "linked_by_managed": bool(m),
        })
    pd.DataFrame(rows).sort_values(["event_index", "direction"]).to_csv(
        V514_RECONCILIATION_CSV_PATH, index=False
    )

    checks = [
        ("BOS universe contains unique event/direction keys", len(events) == len(set(events.keys()))),
        ("Attribution cardinality equals ordinary + managed rows", attribution_rows == ordinary_n + managed_n),
        ("All ordinary trades map to BOS events", ordinary_unmatched == 0),
        ("All managed rows map to BOS events", managed_unmatched == 0),
        ("No ordinary BOS has multiple trades", ordinary_multi == 0),
        ("Reconciliation export written", Path(V514_RECONCILIATION_CSV_PATH).exists()),
        ("No strategy parameters modified", True),
    ]
    print()
    print("v5.14 RECONCILIATION INTEGRITY")
    print("-" * 70)
    passed = 0
    for name, ok in checks:
        print(f"[{'PASS' if ok else 'FAIL'}] {name}")
        passed += int(ok)
    print(f"RESULT: {passed}/{len(checks)} PASS")
    print(f"CSV: {V514_RECONCILIATION_CSV_PATH}")
    return passed == len(checks)


def _v514_compare_structure_items(timeline_item, prefix_structure, session_start):
    """Compare a timeline item with a fresh direct structure calculation on the same prefix."""
    expected_state = prefix_structure.get("state")
    expected_trend = prefix_structure.get("current_trend")
    if timeline_item.get("structure_state") != expected_state:
        return False, "structure_state"
    if timeline_item.get("current_trend") != expected_trend:
        return False, "current_trend"

    direct_events = []
    for e in prefix_structure.get("events", []):
        direct_events.append((
            session_start + int(e["index"]),
            e.get("event"),
            e.get("direction"),
            e.get("level"),
        ))
    timeline_events = [
        (int(e["index"]), e.get("event"), e.get("direction"), e.get("level"))
        for e in timeline_item.get("events_snapshot", [])
    ]
    if direct_events != timeline_events:
        return False, "events_snapshot"
    return True, ""


def _v514_causal_feature_frame(indicator_df):
    """Rebuild only causal research features without forward labels or timeline."""
    work = indicator_df.copy()
    work["feature_ema9_21_spread"] = work["ema9"] - work["ema21"]
    work["feature_ema21_50_spread"] = work["ema21"] - work["ema50"]
    work["feature_close_ema21_pct"] = (work["close"] - work["ema21"]) / work["ema21"] * 100.0
    work["feature_close_ema50_pct"] = (work["close"] - work["ema50"]) / work["ema50"] * 100.0
    work["feature_ema9_slope_3"] = work["ema9"] - work["ema9"].shift(3)
    work["feature_ema21_slope_3"] = work["ema21"] - work["ema21"].shift(3)
    work["feature_ema50_slope_5"] = work["ema50"] - work["ema50"].shift(5)
    work["feature_rsi_delta_3"] = work["rsi14"] - work["rsi14"].shift(3)
    work["feature_macd_hist_delta_3"] = work["macd_hist"] - work["macd_hist"].shift(3)
    work["feature_macd_hist_atr"] = work.apply(lambda r: _safe_ratio(r["macd_hist"], r["atr14"]), axis=1)
    work["feature_vwap_distance_pct"] = (work["close"] - work["vwap"]) / work["vwap"] * 100.0
    work["feature_atr_pct_price"] = work["atr14"] / work["close"] * 100.0
    work["feature_atr_ratio_20"] = work["atr14"] / work["atr14"].rolling(20).mean()
    work["feature_volume_ratio"] = work["volume_ratio"]
    work["feature_volume_ratio_delta_3"] = work["volume_ratio"] - work["volume_ratio"].shift(3)
    candle_range = (work["high"] - work["low"]).replace(0, np.nan)
    body = (work["close"] - work["open"]).abs()
    work["feature_candle_body_pct"] = body / candle_range * 100.0
    work["feature_candle_range_atr"] = candle_range / work["atr14"]
    work["feature_upper_wick_pct"] = (work["high"] - work[["open", "close"]].max(axis=1)) / candle_range * 100.0
    work["feature_lower_wick_pct"] = (work[["open", "close"]].min(axis=1) - work["low"]) / candle_range * 100.0
    work["feature_return_1"] = work["close"].pct_change() * 100.0
    work["feature_return_3"] = work["close"].pct_change(3) * 100.0
    work["feature_return_6"] = work["close"].pct_change(6) * 100.0
    return work


def _v514_prefix_and_structure_audit(df, timeline):
    """Audit indicator/feature prefix invariance and direct structure causality."""
    print()
    print("=" * 70)
    print("v5.14 PREFIX / STRUCTURE CAUSALITY AUDIT")
    print("=" * 70)

    session_keys = build_session_keys(df)
    checkpoints = []
    for session in session_keys.drop_duplicates():
        global_indices = list(df.index[session_keys == session])
        if not global_indices:
            continue
        # First, middle and last bar of every exchange session. The first point
        # is useful for boundary behavior; the last point verifies a full prefix.
        candidates = {global_indices[0], global_indices[len(global_indices) // 2], global_indices[-1]}
        for idx in sorted(candidates):
            checkpoints.append(int(idx))

    indicator_cols = [
        "ema9", "ema21", "ema50", "rsi14", "macd", "macd_signal", "macd_hist",
        "vwap", "atr14", "volume_avg20", "volume_ratio",
    ]
    feature_cols = [
        "feature_ema9_21_spread", "feature_ema21_50_spread", "feature_close_ema21_pct",
        "feature_close_ema50_pct", "feature_ema9_slope_3", "feature_ema21_slope_3",
        "feature_ema50_slope_5", "feature_rsi_delta_3", "feature_macd_hist_delta_3",
        "feature_macd_hist_atr", "feature_vwap_distance_pct", "feature_atr_pct_price",
        "feature_atr_ratio_20", "feature_volume_ratio", "feature_volume_ratio_delta_3",
        "feature_candle_body_pct", "feature_candle_range_atr", "feature_upper_wick_pct",
        "feature_lower_wick_pct", "feature_return_1", "feature_return_3", "feature_return_6",
    ]

    full_features = _v514_causal_feature_frame(df)
    audit_rows = []
    indicator_failures = 0
    feature_failures = 0
    structure_failures = 0

    for idx in checkpoints:
        prefix_ind = calculate_indicators(df.iloc[: idx + 1].copy())
        full_row = df.iloc[idx]
        prefix_row = prefix_ind.iloc[-1]
        ind_bad = []
        for col in indicator_cols:
            a = full_row.get(col, np.nan)
            b = prefix_row.get(col, np.nan)
            if pd.isna(a) and pd.isna(b):
                continue
            if pd.isna(a) != pd.isna(b) or not np.isclose(float(a), float(b), rtol=1e-10, atol=1e-10):
                ind_bad.append(col)
        if ind_bad:
            indicator_failures += 1

        prefix_features = _v514_causal_feature_frame(prefix_ind)
        feature_bad = []
        for col in feature_cols:
            a = full_features.iloc[idx].get(col, np.nan)
            b = prefix_features.iloc[-1].get(col, np.nan)
            if pd.isna(a) and pd.isna(b):
                continue
            if pd.isna(a) != pd.isna(b) or not np.isclose(float(a), float(b), rtol=1e-10, atol=1e-10):
                feature_bad.append(col)
        if feature_bad:
            feature_failures += 1

        session = session_keys.iloc[idx]
        session_indices = list(df.index[session_keys == session])
        session_start = session_indices[0]
        local_end = session_indices.index(idx)
        session_prefix = df.iloc[session_start: idx + 1].copy()
        raw_h, raw_l = find_swings(session_prefix)
        ph = classify_highs(raw_h)
        pl = classify_lows(raw_l)
        direct_structure = run_structure_engine(session_prefix, ph, pl)
        ok, reason = _v514_compare_structure_items(timeline[idx], direct_structure, session_start)
        if not ok:
            structure_failures += 1

        audit_rows.append({
            "global_index": idx,
            "session_key": session,
            "indicator_bad_columns": ",".join(ind_bad),
            "indicator_ok": not bool(ind_bad),
            "feature_bad_columns": ",".join(feature_bad),
            "feature_ok": not bool(feature_bad),
            "structure_ok": ok,
            "structure_failure_reason": reason,
            "session_local_index": local_end,
        })

    pd.DataFrame(audit_rows).to_csv(V514_PREFIX_CSV_PATH, index=False)

    print(f"Checkpoints:                        {len(checkpoints)}")
    print(f"Indicator checkpoint failures:      {indicator_failures}")
    print(f"Research-feature checkpoint failures:{feature_failures}")
    print(f"Structure checkpoint failures:      {structure_failures}")

    checks = [
        ("Indicator prefix invariance", indicator_failures == 0),
        ("Research-feature prefix invariance", feature_failures == 0),
        ("Direct prefix structure matches timeline", structure_failures == 0),
        ("Prefix audit export written", Path(V514_PREFIX_CSV_PATH).exists()),
        ("No strategy parameters modified", True),
    ]
    print()
    print("v5.14 PREFIX / STRUCTURE INTEGRITY")
    print("-" * 70)
    passed = 0
    for name, ok in checks:
        print(f"[{'PASS' if ok else 'FAIL'}] {name}")
        passed += int(ok)
    print(f"RESULT: {passed}/{len(checks)} PASS")
    print(f"CSV: {V514_PREFIX_CSV_PATH}")
    return passed == len(checks)

def _v514_event_timing_and_swing_audit(research_signal_rows, df, timeline):
    """Audit BOS decision timing, swing confirmation causality and next-bar execution convention."""
    print()
    print("=" * 70)
    print("v5.14 BOS TIMING / SWING CONFIRMATION AUDIT")
    print("=" * 70)

    session_keys = build_session_keys(df)
    global_highs, global_lows = build_global_session_swings(df)
    all_swings = global_highs + global_lows
    row_map = _v511_signal_row_map(research_signal_rows)
    events = _v514_event_universe(research_signal_rows, df)

    rows = []
    timing_failures = 0
    swing_failures = 0
    entry_failures = 0
    metadata_begin_count = 0

    for (event_index, direction), event in sorted(events.items()):
        expected_event_end = df.iloc[event_index]["end"]
        expected_event_begin = df.iloc[event_index]["begin"]
        signal_idx = int(event["first_actionable_index"])
        signal_row = row_map.get(signal_idx)
        signal_event = timeline[signal_idx].get("signal_event") if 0 <= signal_idx < len(timeline) else None

        # Locate the exact protected swing by direction and level among swings
        # that are already confirmed at the BOS bar.
        level = event.get("event_level", np.nan)
        candidates = []
        for swing in (global_highs if direction == "LONG" else global_lows):
            if pd.isna(level):
                continue
            if abs(float(swing["price"]) - float(level)) <= PRICE_EPSILON:
                candidates.append(swing)
        confirmed_candidates = [s for s in candidates if int(s["confirmation_index"]) <= event_index]
        swing_ok = bool(confirmed_candidates)
        if not swing_ok:
            swing_failures += 1

        # Engine event time is end-of-bar. Research v5.13 event_time fields use begin.
        engine_time_ok = bool(signal_event is not None and pd.Timestamp(signal_event.get("time")) == pd.Timestamp(expected_event_end))
        if not engine_time_ok:
            timing_failures += 1
        if signal_event is not None and pd.Timestamp(signal_event.get("bar_begin")) == pd.Timestamp(expected_event_begin):
            metadata_begin_count += 1

        # First actionable observation must not precede the BOS event. The frozen
        # backtest convention enters on the next bar OPEN.
        same_session_signal = signal_idx >= event_index and session_keys.iloc[signal_idx] == session_keys.iloc[event_index]
        next_entry_ok = False
        if same_session_signal and signal_idx + 1 < len(df):
            next_entry_ok = (
                session_keys.iloc[signal_idx + 1] == session_keys.iloc[signal_idx]
                and signal_idx + 1 > event_index
            )
        if not same_session_signal or not next_entry_ok:
            entry_failures += 1

        rows.append({
            "event_index": event_index,
            "direction": direction,
            "event_begin": expected_event_begin,
            "event_end": expected_event_end,
            "signal_index": signal_idx,
            "event_to_signal_bars": signal_idx - event_index,
            "engine_event_time_matches_end": engine_time_ok,
            "research_event_begin_matches_bar_begin": bool(signal_event is not None and pd.Timestamp(signal_event.get("bar_begin")) == pd.Timestamp(expected_event_begin)),
            "matching_swing_count": len(candidates),
            "confirmed_matching_swing_count": len(confirmed_candidates),
            "max_matching_swing_confirmation_index": max((int(s["confirmation_index"]) for s in confirmed_candidates), default=np.nan),
            "swing_confirmation_causal": swing_ok,
            "same_session_signal": same_session_signal,
            "next_bar_entry_convention_possible": next_entry_ok,
        })

    pd.DataFrame(rows).to_csv("v5.14_bos_timing_audit.csv", index=False)

    print(f"BOS events audited:                 {len(events)}")
    print(f"Engine event-time failures:          {timing_failures}")
    print(f"BOS protected-swing failures:        {swing_failures}")
    print(f"Next-bar entry convention failures:  {entry_failures}")
    print(f"v5.13 research rows with begin metadata:{metadata_begin_count}/{len(events)}")
    print("NOTE: engine event time is expected at bar END; research exports may intentionally retain bar BEGIN as bar timestamp.")

    checks = [
        ("BOS engine decision timestamp is bar END", timing_failures == 0),
        ("Every BOS level has a confirmed causal swing", swing_failures == 0),
        ("BOS signal is not before event and next-bar entry is possible", entry_failures == 0),
        ("BOS timing audit export written", Path("v5.14_bos_timing_audit.csv").exists()),
        ("No strategy parameters modified", True),
    ]
    print()
    print("v5.14 BOS TIMING INTEGRITY")
    print("-" * 70)
    passed = 0
    for name, ok in checks:
        print(f"[{'PASS' if ok else 'FAIL'}] {name}")
        passed += int(ok)
    print(f"RESULT: {passed}/{len(checks)} PASS")
    return passed == len(checks)


def _v514_mfe_causality_audit(research_signal_rows, df, ordinary_backtest):
    """Audit that forward MFE/MAE begins strictly at t+1 and never uses the BOS bar."""
    print()
    print("=" * 70)
    print("v5.14 MFE / MAE CAUSALITY AUDIT")
    print("=" * 70)

    session_keys = build_session_keys(df)
    events = _v514_event_universe(research_signal_rows, df)
    rows = []
    failures = 0
    positive_mfe_on_event_bar = 0
    no_future_data = 0

    for (event_index, direction), event in sorted(events.items()):
        session = session_keys.iloc[event_index]
        future = []
        for j in range(event_index + 1, len(df)):
            if session_keys.iloc[j] != session:
                break
            future.append(j)
            if len(future) >= 12:
                break

        base = float(df.iloc[event_index]["close"])
        if not future:
            no_future_data += 1
            rows.append({
                "event_index": event_index,
                "direction": direction,
                "future_first_index": np.nan,
                "future_first_offset": np.nan,
                "future_candles": 0,
                "same_session": True,
                "causal_t1": False,
                "event_bar_used": False,
                "positive_event_bar_favorable_move": False,
            })
            failures += 1
            continue

        highs = pd.to_numeric(df.iloc[future]["high"], errors="coerce").to_numpy()
        lows = pd.to_numeric(df.iloc[future]["low"], errors="coerce").to_numpy()
        if direction == "LONG":
            favorable = ((highs / base) - 1.0) * 100.0
            adverse = ((lows / base) - 1.0) * 100.0
        else:
            favorable = ((base / lows) - 1.0) * 100.0
            adverse = ((base / highs) - 1.0) * 100.0

        causal_t1 = future[0] == event_index + 1
        same_session = all(session_keys.iloc[j] == session for j in future)
        if not causal_t1 or not same_session:
            failures += 1
        positive_event_bar = False  # event bar is deliberately excluded

        rows.append({
            "event_index": event_index,
            "direction": direction,
            "future_first_index": future[0],
            "future_first_offset": future[0] - event_index,
            "future_candles": len(future),
            "same_session": same_session,
            "causal_t1": causal_t1,
            "event_bar_used": False,
            "positive_event_bar_favorable_move": positive_event_bar,
            "max_future_mfe_pct": float(np.nanmax(favorable)) if favorable.size else np.nan,
            "min_future_mae_pct": float(np.nanmin(adverse)) if adverse.size else np.nan,
        })

    pd.DataFrame(rows).to_csv(V514_MFE_CAUSALITY_CSV_PATH, index=False)
    print(f"BOS events audited:                 {len(events)}")
    print(f"No-future-data events:              {no_future_data}")
    print(f"Causality failures:                 {failures}")
    print("Event bar included in forward MFE:  NO")
    print("Forward window starts at:            t+1")

    checks = [
        ("Every forward MFE/MAE window starts at t+1", failures == 0),
        ("No event bar used by forward MFE/MAE", all(not bool(r.get("event_bar_used")) for r in rows)),
        ("Forward windows stay inside session", all(bool(r.get("same_session")) for r in rows)),
        ("MFE causality export written", Path(V514_MFE_CAUSALITY_CSV_PATH).exists()),
        ("No strategy parameters modified", True),
    ]
    print()
    print("v5.14 MFE / MAE INTEGRITY")
    print("-" * 70)
    passed = 0
    for name, ok in checks:
        print(f"[{'PASS' if ok else 'FAIL'}] {name}")
        passed += int(ok)
    print(f"RESULT: {passed}/{len(checks)} PASS")
    print(f"CSV: {V514_MFE_CAUSALITY_CSV_PATH}")
    return passed == len(checks)


def _v514_aggregation_audit(df_1m, df_5m):
    """Recompute 5m candles from the filtered 1m source and compare exact OHLCV/value."""
    print()
    print("=" * 70)
    print("v5.14 1M -> 5M AGGREGATION AUDIT")
    print("=" * 70)

    recomputed = _aggregate_5m_uncached(df_1m)
    recomputed = _validate_5m_frame(recomputed, "v5.14 recomputed 5m")
    cols = ["open", "high", "low", "close", "volume", "value"]
    merged = df_5m[["begin"] + cols].merge(
        recomputed[["begin"] + cols], on="begin", how="outer", suffixes=("_actual", "_recomputed"), indicator=True
    )
    mismatches = []
    for _, r in merged.iterrows():
        if r["_merge"] != "both":
            mismatches.append({"begin": r["begin"], "reason": "timestamp_missing_on_one_side"})
            continue
        bad_cols = []
        for c in cols:
            a = r[f"{c}_actual"]
            b = r[f"{c}_recomputed"]
            if pd.isna(a) and pd.isna(b):
                continue
            if pd.isna(a) != pd.isna(b) or not np.isclose(float(a), float(b), rtol=1e-12, atol=1e-9):
                bad_cols.append(c)
        if bad_cols:
            mismatches.append({"begin": r["begin"], "reason": ";".join(bad_cols)})

    pd.DataFrame(mismatches).to_csv(V514_AGGREGATION_CSV_PATH, index=False)
    print(f"Actual 5m candles:                  {len(df_5m)}")
    print(f"Recomputed 5m candles:              {len(recomputed)}")
    print(f"Mismatched 5m candles:               {len(mismatches)}")

    checks = [
        ("1m->5m row count matches recomputation", len(df_5m) == len(recomputed)),
        ("1m->5m OHLCV/value matches exactly", len(mismatches) == 0),
        ("Aggregation audit export written", Path(V514_AGGREGATION_CSV_PATH).exists()),
        ("No strategy parameters modified", True),
    ]
    print()
    print("v5.14 AGGREGATION INTEGRITY")
    print("-" * 70)
    passed = 0
    for name, ok in checks:
        print(f"[{'PASS' if ok else 'FAIL'}] {name}")
        passed += int(ok)
    print(f"RESULT: {passed}/{len(checks)} PASS")
    print(f"CSV: {V514_AGGREGATION_CSV_PATH}")
    return passed == len(checks)


def run_v514_audit(research_signal_rows, df_1m, df_5m, timeline, ordinary_backtest, managed_backtest):
    """Run the v5.14 audit suite without changing trading behavior."""
    results = []
    results.append(_v514_reconciliation_audit(research_signal_rows, df_5m, ordinary_backtest, managed_backtest))
    results.append(_v514_prefix_and_structure_audit(df_5m, timeline))
    results.append(_v514_event_timing_and_swing_audit(research_signal_rows, df_5m, timeline))
    results.append(_v514_mfe_causality_audit(research_signal_rows, df_5m, ordinary_backtest))
    results.append(_v514_aggregation_audit(df_1m, df_5m))

    print()
    print("=" * 70)
    print("v5.14 AUDIT SUMMARY")
    print("=" * 70)
    labels = [
        "Reconciliation",
        "Prefix / structure causality",
        "BOS timing / swing confirmation",
        "MFE / MAE causality",
        "1M -> 5M aggregation",
    ]
    for label, ok in zip(labels, results):
        print(f"[{'PASS' if ok else 'FAIL'}] {label}")
    print(f"AUDIT SUITES PASS: {sum(results)}/{len(results)}")
    print("STRATEGY LOGIC: UNCHANGED")
    print("RESEARCH MODE ONLY")
    print("=" * 70)
    return all(results)

def main():

    print("=" * 70)

    print(
        "MOEX TRADING LAB"
    )

    print(
        f"{SECURITY} / 5M / "
        f"STRUCTURE ENGINE v{VERSION}"
    )

    print(
        "RESEARCH MODE ONLY"
    )

    print("=" * 70)

    # --------------------------------------------------------
    # Unit tests FIRST
    # --------------------------------------------------------

    if RUN_STRUCTURAL_TESTS:

        tests_ok = (
            run_structural_integrity_tests()
        )

        if not tests_ok:

            raise RuntimeError(
                "STRUCTURAL INTEGRITY TESTS FAILED. "
                "Execution stopped."
            )

    # --------------------------------------------------------
    # Download
    # --------------------------------------------------------

    df_1m_raw = download_1m_data()

    print(
        f"Downloaded 1m candles: "
        f"{len(df_1m_raw)}"
    )

    # --------------------------------------------------------
    # Weekend session filter
    # --------------------------------------------------------

    df_1m, weekend_removed = filter_weekend_sessions(
        df_1m_raw
    )

    print()
    print("=" * 70)
    print("WEEKEND SESSION FILTER")
    print("=" * 70)
    print()

    if EXCLUDE_WEEKEND_SESSIONS:
        print("Weekend sessions: EXCLUDED")
        print(
            f"Weekend 1m candles removed: "
            f"{weekend_removed}"
        )
        print(
            f"1m candles remaining: "
            f"{len(df_1m)}"
        )
    else:
        print("Weekend sessions: INCLUDED")

    print("=" * 70)
    print()

    # --------------------------------------------------------
    # Aggregate
    # --------------------------------------------------------

    df_5m = aggregate_5m(
        df_1m
    )

    print(
        f"Aggregated 5m candles: "
        f"{len(df_5m)}"
    )

    # --------------------------------------------------------
    # Exchange session audit
    # --------------------------------------------------------

    print_session_audit(df_5m)

    # --------------------------------------------------------
    # Indicators
    # --------------------------------------------------------

    df_5m = calculate_indicators(
        df_5m
    )

    if RUN_FOREIGN_FUTURE_PERTURBATION_TEST:
        future_ok = run_future_perturbation_test(df_5m)
        print()
        print("FUTURE-BAR PERTURBATION TEST")
        print(f"[{'PASS' if future_ok else 'FAIL'}] Past decisions are invariant to future-bar mutation")
        print()
        if not future_ok:
            raise RuntimeError("LOOKAHEAD INTEGRITY TEST FAILED")

    latest = df_5m.iloc[-1]

    technical_score, technical_state = (
        calculate_technical_score(
            latest
        )
    )

    # --------------------------------------------------------
    # Current trading session structure
    # --------------------------------------------------------

    latest_session_key = trading_session_key(
        df_5m.iloc[-1]["begin"]
    )

    session_keys = build_session_keys(df_5m)

    latest_session_mask = (
        session_keys == latest_session_key
    )

    df_session = (
        df_5m.loc[latest_session_mask]
        .reset_index(drop=True)
    )

    raw_highs, raw_lows = find_swings(df_session)

    highs = classify_highs(raw_highs)
    lows = classify_lows(raw_lows)

    # Backtest management needs global indices across all sessions.
    # Keep the local latest-session swings above for the human-readable
    # current-session structure report.
    global_highs, global_lows = build_global_session_swings(df_5m)

    # --------------------------------------------------------
    # v5.7 Research Feature Engine
    # --------------------------------------------------------

    if RUN_RESEARCH_FEATURE_ENGINE:
        research_features, research_signal_rows = run_research_feature_engine(
            df_5m,
            global_highs,
            global_lows,
        )
        print_research_feature_report(
            research_features,
            research_signal_rows,
        )
        print_v574_research_report(
            research_features,
            research_signal_rows,
            df_5m,
        )
        print_v575_event_anatomy_report(
            research_signal_rows,
            df_5m,
        )
        print_v576_consolidated_research_report(
            research_signal_rows,
            df_5m,
        )
        print_v577_event_path_report(
            research_signal_rows,
            df_5m,
        )
        if RUN_V510_EVENT_OUTCOME_LAB:
            run_v510_event_outcome_lab(
                research_signal_rows,
                df_5m,
            )

    # --------------------------------------------------------
    # Structure
    # --------------------------------------------------------

    structure = run_structure_engine(
        df_session,
        highs,
        lows,
    )

    # --------------------------------------------------------
    # Structural validation
    # --------------------------------------------------------

    structure_errors = (
        validate_structure(
            structure
        )
    )

    if structure_errors:

        print()
        print(
            "!!! STRUCTURAL VALIDATION ERROR !!!"
        )

        for error in structure_errors:

            print(
                f" - {error}"
            )

        raise RuntimeError(
            "Structure validation failed"
        )

    # --------------------------------------------------------
    # Runtime integrity
    # --------------------------------------------------------

    if RUN_RUNTIME_STRUCTURE_TESTS:

        runtime_ok = (
            run_runtime_structure_tests(
                df_session,
                highs,
                lows,
                structure,
            )
        )

        if not runtime_ok:

            raise RuntimeError(
                "RUNTIME STRUCTURAL INTEGRITY "
                "TESTS FAILED. Execution stopped."
            )

    # --------------------------------------------------------
    # Signal
    # --------------------------------------------------------

    signal_result = (
        run_signal_engine(
            structure,
            technical_score,
            technical_state,
        )
    )

    # --------------------------------------------------------
    # Reports
    # --------------------------------------------------------

    print_technical_report(
        latest,
        technical_score,
        technical_state,
    )

    print_structure_report(
        structure
    )

    print_events(
        structure["events"]
    )

    print_signal_report(
        signal_result,
        technical_score,
        technical_state,
        structure,
    )

    print_swings(
        highs,
        lows,
    )

    # --------------------------------------------------------
    # Backtest
    # --------------------------------------------------------

    if RUN_BACKTEST:

        backtest = run_backtest(
            df_5m,
            global_highs,
            global_lows,
        )

        backtest_ok = run_backtest_integrity_tests(
            backtest,
            df_5m,
        )

        if not backtest_ok:
            raise RuntimeError(
                "BACKTEST INTEGRITY TESTS FAILED. "
                "Execution stopped."
            )

        print_backtest_report(
            backtest
        )

        print_trade_diagnostics(
            backtest
        )

        if RUN_MANAGED_BACKTEST:

            managed_backtest = run_managed_backtest(
                df_5m,
                global_highs,
                global_lows,
            )

            managed_ok = run_managed_backtest_integrity_tests(
                managed_backtest,
                df_5m,
            )

            if not managed_ok:
                raise RuntimeError(
                    "MANAGED BACKTEST INTEGRITY TESTS FAILED. "
                    "Execution stopped."
                )

            print_managed_backtest_report(
                managed_backtest
            )

            if RUN_V511_EVENT_TRADE_ATTRIBUTION:
                _v511_event_trade_attribution(
                    research_signal_rows,
                    df_5m,
                    backtest,
                    managed_backtest,
                )

            if RUN_V512_BOS_LIFECYCLE_LAB:
                lifecycle_ok = run_v512_bos_lifecycle_lab(
                    research_signal_rows,
                    df_5m,
                    backtest,
                )
                if not lifecycle_ok:
                    raise RuntimeError(
                        "v5.12 BOS LIFECYCLE INTEGRITY TESTS FAILED. "
                        "Execution stopped."
                    )

            if RUN_V513_BOS_MFE_TIME_LAB:
                mfe_time_ok = run_v513_bos_mfe_time_lab(
                    research_signal_rows,
                    df_5m,
                    backtest,
                )
                if not mfe_time_ok:
                    raise RuntimeError(
                        "v5.13 BOS MFE TIME INTEGRITY TESTS FAILED. "
                        "Execution stopped."
                    )

            if RUN_V514_AUDIT:
                audit_ok = run_v514_audit(
                    research_signal_rows,
                    df_1m,
                    df_5m,
                    build_signal_timeline(df_5m, global_highs, global_lows),
                    backtest,
                    managed_backtest,
                )
                if not audit_ok:
                    print()
                    print("v5.14 AUDIT DETECTED ONE OR MORE ITEMS REQUIRING REVIEW.")
                    print("NO STRATEGY PARAMETERS WERE CHANGED.")

            if RUN_V515_BOS_EVENT_TRADE_PATH_LAB:
                v515_ok = run_v515_bos_event_trade_path_lab(
                    research_signal_rows,
                    df_5m,
                    backtest,
                    managed_backtest,
                )
                if not v515_ok:
                    print()
                    print("v5.15 PATH LAB DETECTED ONE OR MORE ITEMS REQUIRING REVIEW.")
                    print("NO STRATEGY PARAMETERS WERE CHANGED.")

            if RUN_V516_BOS_DECOMPOSITION_LAB:
                v516_ok = run_v516_bos_decomposition_lab(
                    research_signal_rows,
                    df_5m,
                    backtest,
                    managed_backtest,
                )
                if not v516_ok:
                    print()
                    print("v5.16 DECOMPOSITION LAB DETECTED ONE OR MORE ITEMS REQUIRING REVIEW.")
                    print("NO STRATEGY PARAMETERS WERE CHANGED.")

            if RUN_V5161_TRADE_PATH_LAB:
                v5161_ok = run_v5161_trade_path_monetization_lab(
                    research_signal_rows,
                    df_5m,
                    backtest,
                )
                if not v5161_ok:
                    print()
                    print("v5.16.1 TRADE PATH LAB DETECTED ONE OR MORE ITEMS REQUIRING REVIEW.")
                    print("NO STRATEGY PARAMETERS WERE CHANGED.")

            if RUN_V517_THRESHOLD_PATH_LAB:
                v517_ok = run_v517_threshold_path_lab(
                    df_5m,
                    backtest,
                )
                if not v517_ok:
                    print()
                    print("v5.17 THRESHOLD PATH LAB DETECTED ONE OR MORE ITEMS REQUIRING REVIEW.")
                    print("NO STRATEGY PARAMETERS WERE CHANGED.")

    # --------------------------------------------------------
    # Safety footer
    # --------------------------------------------------------

    print()
    print("=" * 70)
    print("SAFETY:")
    print("NO ORDERS WERE SENT")
    print("NO TRADING ACTION WAS PERFORMED")
    print("RESEARCH MODE ONLY")
    print("=" * 70)



# ============================================================
# v5.15 BOS -> EVENT -> TRADE PATH LAB — RESEARCH ONLY
# ============================================================

def _v515_event_universe(research_signal_rows, df):
    """Rebuild the unique BOS universe using the same v5.13/v5.14 mapping."""
    records = {}
    if research_signal_rows is None or research_signal_rows.empty:
        return records
    session_keys = build_session_keys(df)
    unique_rows = _research_unique_signal_events(research_signal_rows)
    for _, row in unique_rows.iterrows():
        try:
            source_index = int(row["_source_index"])
        except Exception:
            continue
        if source_index < 0 or source_index >= len(df):
            continue
        if row.get("signal_event_type") != "BOS":
            continue
        event_local_raw = row.get("diag_signal_event_index", np.nan)
        if pd.isna(event_local_raw):
            continue
        signal_session = session_keys.iloc[source_index]
        event_index = _v511_session_global_index(df, signal_session, event_local_raw)
        if event_index is None:
            continue
        side = str(row.get("signal"))
        direction = "LONG" if side == "BUY" else "SHORT" if side == "SELL" else None
        if direction is None:
            continue
        key = (int(event_index), direction)
        records[key] = {
            "event_index": int(event_index),
            "event_time": df.iloc[event_index]["begin"],
            "session_key": signal_session,
            "direction": direction,
            "event_level": row.get("signal_event_level", np.nan),
            "event_strength": row.get("signal_event_strength", np.nan),
            "first_actionable_index": source_index,
        }
    return records


def _v515_forward_indices(df, session_keys, event_index, horizon=12):
    source_session = session_keys.iloc[event_index]
    out = []
    for idx in range(event_index + 1, len(df)):
        if session_keys.iloc[idx] != source_session:
            break
        out.append(idx)
        if len(out) >= horizon:
            break
    return out


def _v515_trade_map(research_signal_rows, df, backtest):
    """Map trades to their originating BOS using the existing v5.11 conversion."""
    result = {}
    unmatched = 0
    if not backtest:
        return result, unmatched
    row_map = _v511_signal_row_map(research_signal_rows)
    session_keys = build_session_keys(df)
    for trade_no, trade in enumerate(backtest.get("trades", []), 1):
        try:
            signal_index = int(trade["signal_index"])
        except Exception:
            unmatched += 1
            continue
        row = row_map.get(signal_index)
        if row is None or row.get("signal_event_type") != "BOS":
            unmatched += 1
            continue
        event_local_raw = row.get("diag_signal_event_index", np.nan)
        if pd.isna(event_local_raw) or signal_index < 0 or signal_index >= len(df):
            unmatched += 1
            continue
        event_index = _v511_session_global_index(
            df, session_keys.iloc[signal_index], event_local_raw
        )
        if event_index is None:
            unmatched += 1
            continue
        direction = str(trade.get("side"))
        key = (int(event_index), direction)
        result.setdefault(key, []).append({
            "trade_number": trade_no,
            "signal_index": signal_index,
            "entry_index": int(trade["entry_index"]),
            "exit_index": int(trade["exit_index"]),
            "return_pct": float(trade.get("return_pct", 0.0)),
            "net_pnl": float(trade.get("net_pnl", 0.0)),
            "reason": trade.get("reason"),
            "mfe_pct": float(trade.get("mfe_pct_of_entry", np.nan)),
            "mae_pct": float(trade.get("mae_pct_of_entry", np.nan)),
        })
    return result, unmatched


def _v515_event_metrics(df, event_index, direction, future):
    base = float(df.iloc[event_index]["close"])
    highs = pd.to_numeric(df.iloc[future]["high"], errors="coerce").to_numpy() if future else np.array([])
    lows = pd.to_numeric(df.iloc[future]["low"], errors="coerce").to_numpy() if future else np.array([])
    closes = pd.to_numeric(df.iloc[future]["close"], errors="coerce").to_numpy() if future else np.array([])
    if direction == "LONG":
        favorable = ((highs / base) - 1.0) * 100.0
        adverse = ((lows / base) - 1.0) * 100.0
    else:
        favorable = ((base / lows) - 1.0) * 100.0
        adverse = ((base / highs) - 1.0) * 100.0
    out = {}
    for h in (1, 2, 3, 4, 6, 8, 12):
        n = min(h, len(future))
        if n <= 0:
            out[f"mfe_h{h}_pct"] = np.nan
            out[f"mae_h{h}_pct"] = np.nan
            out[f"close_h{h}_pct"] = np.nan
            continue
        out[f"mfe_h{h}_pct"] = float(np.nanmax(np.r_[0.0, favorable[:n]]))
        out[f"mae_h{h}_pct"] = float(np.nanmin(np.r_[0.0, adverse[:n]]))
        c = closes[n - 1]
        out[f"close_h{h}_pct"] = float(((c / base) - 1.0) * 100.0 if direction == "LONG" else ((base / c) - 1.0) * 100.0)
    for threshold in (0.10, 0.20, 0.30, 0.40, 0.50, 0.75, 1.00):
        tag = str(threshold).replace(".", "_")
        hits = np.flatnonzero(favorable >= threshold) if favorable.size else np.array([])
        out[f"reach_{tag}"] = bool(hits.size)
        out[f"bars_to_{tag}"] = int(hits[0] + 1) if hits.size else np.nan
        out[f"mae_before_{tag}"] = float(np.nanmin(np.r_[0.0, adverse[:int(hits[0]) + 1]])) if hits.size else np.nan
    all_exc = np.r_[0.0, favorable] if favorable.size else np.array([0.0])
    max_pos = int(np.nanargmax(all_exc))
    out["max_mfe_pct"] = float(np.nanmax(all_exc))
    out["max_mfe_bar"] = max_pos
    return out


def _v515_classify(row):
    """Descriptive bucket; never used by trading logic."""
    mfe = row["max_mfe_pct"]
    ordinary_n = int(row["ordinary_trade_count"])
    managed_n = int(row["managed_trade_count"])
    ordinary_pnl = row["ordinary_net_pnl"]
    first_mfe = row["ordinary_mfe_pct"]
    entry_delay = row["event_to_entry_bars"]
    if pd.isna(mfe):
        return "NO_DATA"
    if mfe < 0.20:
        return "BOS_BAD_FROM_OUTSET"
    if ordinary_n == 0:
        return "BOS_GOOD_NO_ORDINARY_TRADE" if mfe >= 0.40 else "BOS_NO_TRADE"
    if managed_n > 1 and pd.notna(row["managed_lifecycle_pnl"]) and row["managed_lifecycle_pnl"] < 0:
        return "MANAGED_REENTRY_GIVEBACK"
    if mfe >= 0.40 and pd.notna(first_mfe) and first_mfe < mfe * 0.50:
        return "GOOD_BOS_POOR_CAPTURE"
    if mfe >= 0.40 and pd.notna(entry_delay) and entry_delay >= 3:
        return "GOOD_BOS_LATE_ENTRY"
    if pd.notna(ordinary_pnl) and ordinary_pnl > 0:
        return "GOOD_BOS_ENGINE_EARNED"
    if mfe >= 0.40:
        return "GOOD_BOS_ENGINE_FAILED_TO_CAPTURE"
    return "MARGINAL_BOS"


def run_v515_bos_event_trade_path_lab(research_signal_rows, df, ordinary_backtest, managed_backtest):
    """Descriptive reconciliation of BOS -> event path -> ordinary/managed trades."""
    print()
    print("=" * 70)
    print("v5.15 BOS -> EVENT -> TRADE PATH LAB")
    print("STRATEGY LOGIC: UNCHANGED")
    print("RESEARCH MODE ONLY")
    print("=" * 70)

    session_keys = build_session_keys(df)
    events = _v515_event_universe(research_signal_rows, df)
    ordinary_map, ordinary_unmatched = _v515_trade_map(research_signal_rows, df, ordinary_backtest)
    managed_map, managed_unmatched = _v515_trade_map(research_signal_rows, df, managed_backtest)
    rows = []

    for key, event in sorted(events.items()):
        event_index, direction = key
        future = _v515_forward_indices(df, session_keys, event_index, 12)
        metrics = _v515_event_metrics(df, event_index, direction, future)
        ordinary = sorted(ordinary_map.get(key, []), key=lambda x: x["entry_index"])
        managed = sorted(managed_map.get(key, []), key=lambda x: x["entry_index"])
        first = ordinary[0] if ordinary else None
        first_managed = managed[0] if managed else None
        signal_index = int(event["first_actionable_index"])
        entry_index = first["entry_index"] if first else (first_managed["entry_index"] if first_managed else np.nan)
        lifecycle = float(sum(x["net_pnl"] for x in managed)) if managed else np.nan
        row = {
            "event_index": event_index,
            "event_time": event["event_time"],
            "session_key": event["session_key"],
            "direction": direction,
            "event_close": float(df.iloc[event_index]["close"]),
            "event_level": event["event_level"],
            "event_strength": event["event_strength"],
            "first_actionable_index": signal_index,
            "event_to_signal_bars": signal_index - event_index,
            "entry_index": entry_index,
            "event_to_entry_bars": entry_index - event_index if pd.notna(entry_index) else np.nan,
            "future_candles_used": len(future),
            "ordinary_trade_count": len(ordinary),
            "managed_trade_count": len(managed),
            "ordinary_return_pct": first["return_pct"] if first else np.nan,
            "ordinary_net_pnl": first["net_pnl"] if first else np.nan,
            "ordinary_mfe_pct": first["mfe_pct"] if first else np.nan,
            "ordinary_mae_pct": first["mae_pct"] if first else np.nan,
            "ordinary_exit_reason": first["reason"] if first else None,
            "managed_first_pnl": first_managed["net_pnl"] if first_managed else np.nan,
            "managed_lifecycle_pnl": lifecycle,
            "managed_trade_numbers": ",".join(str(x["trade_number"]) for x in managed),
            "managed_trade_results": ",".join(f"{x['net_pnl']:+.2f}" for x in managed),
        }
        row.update(metrics)
        row["event_class"] = _v515_classify(row)
        rows.append(row)

    work = pd.DataFrame(rows).sort_values("event_index").reset_index(drop=True)
    work.to_csv(V515_PATH_CSV, index=False)

    # Human-readable TXT report saved beside the CSV.
    lines = []
    add = lines.append
    add("=" * 78)
    add("MOEX TRADING LAB — v5.15 BOS -> EVENT -> TRADE PATH LAB")
    add("RESEARCH ONLY — STRATEGY LOGIC UNCHANGED")
    add("=" * 78)
    add(f"Unique BOS events: {len(events)}")
    add(f"Ordinary trades: {len(ordinary_backtest.get('trades', [])) if ordinary_backtest else 0}")
    add(f"Managed trades: {len(managed_backtest.get('trades', [])) if managed_backtest else 0}")
    add(f"Ordinary unmatched: {ordinary_unmatched}")
    add(f"Managed unmatched: {managed_unmatched}")
    add("")
    add("EVENT CLASS SUMMARY")
    add("-" * 78)
    if len(work):
        for cls, grp in work.groupby("event_class", sort=False):
            pnl = grp["ordinary_net_pnl"].dropna()
            add(f"{cls:<38} N={len(grp):2d} | mean MAX MFE={grp['max_mfe_pct'].mean():+.3f}% | mean ordinary PnL={pnl.mean():+.2f}" if len(pnl) else f"{cls:<38} N={len(grp):2d} | mean MAX MFE={grp['max_mfe_pct'].mean():+.3f}% | mean ordinary PnL=n/a")
    add("")
    add("FULL BOS PATHS")
    add("-" * 78)
    for _, r in work.iterrows():
        add(f"BOS #{int(r['event_index'])} {r['direction']} {pd.Timestamp(r['event_time'])} | CLASS={r['event_class']}")
        add(f"  close={r['event_close']:.4f} strength={r['event_strength']} level={r['event_level']}")
        add(f"  event->signal={r['event_to_signal_bars']} bars | event->entry={r['event_to_entry_bars']} bars")
        add(f"  MFE H1={r['mfe_h1_pct']:+.3f}% H3={r['mfe_h3_pct']:+.3f}% H6={r['mfe_h6_pct']:+.3f}% H12={r['mfe_h12_pct']:+.3f}% MAX={r['max_mfe_pct']:+.3f}% @bar {int(r['max_mfe_bar'])}")
        add(f"  MAE H1={r['mae_h1_pct']:+.3f}% H3={r['mae_h3_pct']:+.3f}% H6={r['mae_h6_pct']:+.3f}% H12={r['mae_h12_pct']:+.3f}%")
        add(f"  ordinary: N={int(r['ordinary_trade_count'])} return={r['ordinary_return_pct'] if pd.notna(r['ordinary_return_pct']) else np.nan:+.3f}% net={r['ordinary_net_pnl'] if pd.notna(r['ordinary_net_pnl']) else np.nan:+.2f} MFE={r['ordinary_mfe_pct'] if pd.notna(r['ordinary_mfe_pct']) else np.nan:+.3f}% exit={r['ordinary_exit_reason']}")
        add(f"  managed: N={int(r['managed_trade_count'])} first={r['managed_first_pnl'] if pd.notna(r['managed_first_pnl']) else np.nan:+.2f} lifecycle={r['managed_lifecycle_pnl'] if pd.notna(r['managed_lifecycle_pnl']) else np.nan:+.2f}")
        if r['managed_trade_numbers']:
            add(f"  managed trade numbers: {r['managed_trade_numbers']}")
            add(f"  managed results:       {r['managed_trade_results']}")
        add("")

    # Integrity: all forward rows are strictly t+1 and same session.
    session_failures = 0
    for key, event in events.items():
        future = _v515_forward_indices(df, session_keys, event["event_index"], 12)
        if future and future[0] != event["event_index"] + 1:
            session_failures += 1
        if any(session_keys.iloc[i] != event["session_key"] for i in future):
            session_failures += 1

    checks = [
        ("Unique BOS rows", len(work) == len(events)),
        ("No duplicate event/direction rows", not work.duplicated(["event_index", "direction"]).any()),
        ("All ordinary trades map to BOS", ordinary_unmatched == 0),
        ("All managed trades map to BOS", managed_unmatched == 0),
        ("Forward windows start at t+1 and stay in session", session_failures == 0),
        ("No negative event->signal distance", bool((work["event_to_signal_bars"] >= 0).all())),
        ("CSV export written", Path(V515_PATH_CSV).exists()),
        ("TXT report written", Path(V515_PATH_TXT).exists()),
        ("No strategy parameters modified", True),
    ]
    add("INTEGRITY")
    add("-" * 78)
    passed = 0
    for name, ok in checks:
        add(f"[{'PASS' if ok else 'FAIL'}] {name}")
        passed += int(bool(ok))
    add(f"RESULT: {passed}/{len(checks)} PASS")
    add("")
    add("SAFETY: NO ORDERS WERE SENT")
    add("SAFETY: RESEARCH MODE ONLY")
    add("=" * 78)

    Path(V515_PATH_TXT).write_text("\n".join(lines), encoding="utf-8")
    print()
    print("\n".join(lines))
    return passed == len(checks)


# ============================================================
# v5.16 BOS QUALITY / DELAY / ENTRY-DISTANCE / RE-ENTRY
# DECOMPOSITION LAB — RESEARCH ONLY
# ============================================================

def _v516_num(x):
    try:
        return float(x)
    except Exception:
        return np.nan


def _v516_bucket_delay(x):
    if pd.isna(x):
        return "NO_ENTRY"
    x = int(x)
    if x == 0:
        return "0"
    if x <= 2:
        return "1-2"
    if x <= 4:
        return "3-4"
    return "5+"


def _v516_bucket_distance(x):
    if pd.isna(x):
        return "NO_ENTRY"
    x = abs(float(x))
    if x < 0.5:
        return "<0.5 ATR"
    if x < 1.0:
        return "0.5-1.0 ATR"
    if x < 1.5:
        return "1.0-1.5 ATR"
    return ">=1.5 ATR"


def run_v516_bos_decomposition_lab(research_signal_rows, df, ordinary_backtest, managed_backtest):
    """Descriptive decomposition of the v5.15 BOS path results. No strategy changes."""
    print()
    print("=" * 70)
    print("v5.16 BOS QUALITY / DELAY / ENTRY-DISTANCE / RE-ENTRY LAB")
    print("STRATEGY LOGIC: UNCHANGED")
    print("RESEARCH MODE ONLY")
    print("=" * 70)

    src = Path(V515_PATH_CSV)
    if not src.exists():
        print("[FAIL] v5.15 CSV not found:", src)
        return False

    work = pd.read_csv(src)
    if work.empty:
        print("[FAIL] v5.15 CSV is empty")
        return False

    # Add actual event->entry distance using the same 5M dataframe.
    distance_rows = []
    for _, r in work.iterrows():
        ei = int(r["event_index"])
        entry_idx = r.get("entry_index", np.nan)
        direction = str(r["direction"])
        dist_signed = np.nan
        dist_abs = np.nan
        if pd.notna(entry_idx):
            ii = int(entry_idx)
            if 0 <= ei < len(df) and 0 <= ii < len(df):
                event_close = _v516_num(df.iloc[ei]["close"])
                entry_close = _v516_num(df.iloc[ii]["close"])
                atr = _v516_num(df.iloc[ei].get("atr14", np.nan))
                if pd.notna(event_close) and pd.notna(entry_close) and pd.notna(atr) and atr != 0:
                    if direction == "BUY":
                        dist_signed = (entry_close - event_close) / atr
                    else:
                        dist_signed = (event_close - entry_close) / atr
                    dist_abs = abs(dist_signed)
        distance_rows.append((dist_signed, dist_abs))

    work["entry_distance_signed_atr"] = [x[0] for x in distance_rows]
    work["entry_distance_abs_atr"] = [x[1] for x in distance_rows]
    work["signal_delay_bucket"] = work["event_to_signal_bars"].apply(_v516_bucket_delay)
    work["entry_delay_bucket"] = work["event_to_entry_bars"].apply(_v516_bucket_delay)
    work["entry_distance_bucket"] = work["entry_distance_abs_atr"].apply(_v516_bucket_distance)
    work["managed_reentry"] = pd.to_numeric(work["managed_trade_count"], errors="coerce").fillna(0) > 1
    work["managed_first_pnl_num"] = pd.to_numeric(work["managed_first_pnl"], errors="coerce")
    work["managed_lifecycle_pnl_num"] = pd.to_numeric(work["managed_lifecycle_pnl"], errors="coerce")
    work["reentry_giveback_pnl"] = work["managed_lifecycle_pnl_num"] - work["managed_first_pnl_num"]
    work["ordinary_pnl_num"] = pd.to_numeric(work["ordinary_net_pnl"], errors="coerce")
    work["max_mfe_pct_num"] = pd.to_numeric(work["max_mfe_pct"], errors="coerce")
    work["ordinary_mfe_pct_num"] = pd.to_numeric(work["ordinary_mfe_pct"], errors="coerce")

    # A compact machine-readable table: one row per BOS, preserving the full v5.15 path.
    out_cols = [
        "event_index", "event_time", "direction", "event_class",
        "event_to_signal_bars", "event_to_entry_bars",
        "signal_delay_bucket", "entry_delay_bucket",
        "entry_distance_signed_atr", "entry_distance_abs_atr", "entry_distance_bucket",
        "max_mfe_pct", "ordinary_net_pnl", "ordinary_mfe_pct",
        "managed_trade_count", "managed_first_pnl", "managed_lifecycle_pnl",
        "reentry_giveback_pnl", "managed_reentry",
    ]
    export = work[[c for c in out_cols if c in work.columns]].copy()
    export.to_csv(V516_DECOMP_CSV, index=False)

    lines = []
    add = lines.append
    add("=" * 82)
    add("MOEX TRADING LAB — v5.16 BOS DECOMPOSITION LAB")
    add("RESEARCH ONLY — STRATEGY LOGIC UNCHANGED")
    add("Purpose: separate event quality, timing, entry distance and managed re-entry effects.")
    add("IMPORTANT: all buckets are descriptive; they are NOT strategy filters or optimized thresholds.")
    add("=" * 82)
    add(f"BOS events: {len(work)}")
    add("")

    # Class decomposition.
    add("1) EVENT CLASS DECOMPOSITION")
    add("-" * 82)
    class_rows = []
    for cls, g in work.groupby("event_class", sort=False):
        n = len(g)
        share = n / len(work) * 100 if len(work) else np.nan
        op = g["ordinary_pnl_num"].dropna()
        lp = g["managed_lifecycle_pnl_num"].dropna()
        class_rows.append({
            "dimension": "event_class",
            "bucket": cls,
            "n": n,
            "share_pct": share,
            "mean_mfe_pct": g["max_mfe_pct_num"].mean(),
            "mean_ordinary_pnl": op.mean() if len(op) else np.nan,
            "mean_managed_lifecycle_pnl": lp.mean() if len(lp) else np.nan,
            "mean_reentry_giveback": g.loc[g["managed_reentry"], "reentry_giveback_pnl"].mean() if g["managed_reentry"].any() else np.nan,
        })
        add(f"{cls:<38} N={n:2d} ({share:5.1f}%) | MFE={g['max_mfe_pct_num'].mean():+.3f}% | ordinary={op.mean():+.2f}" if len(op) else f"{cls:<38} N={n:2d} ({share:5.1f}%) | MFE={g['max_mfe_pct_num'].mean():+.3f}% | ordinary=n/a")
    add("")

    # Signal delay.
    add("2) EVENT -> SIGNAL DELAY")
    add("-" * 82)
    for bucket, g in work.groupby("signal_delay_bucket", sort=False):
        op = g["ordinary_pnl_num"].dropna()
        add(f"{bucket:<12} N={len(g):2d} | mean MFE={g['max_mfe_pct_num'].mean():+.3f}% | ordinary trades={len(op):2d} | mean ordinary PnL={op.mean():+.2f}" if len(op) else f"{bucket:<12} N={len(g):2d} | mean MFE={g['max_mfe_pct_num'].mean():+.3f}% | ordinary trades= 0 | mean ordinary PnL=n/a")
    add("")

    # Entry delay.
    add("3) EVENT -> ENTRY DELAY")
    add("-" * 82)
    for bucket, g in work.groupby("entry_delay_bucket", sort=False):
        op = g["ordinary_pnl_num"].dropna()
        add(f"{bucket:<12} N={len(g):2d} | mean MFE={g['max_mfe_pct_num'].mean():+.3f}% | ordinary trades={len(op):2d} | mean ordinary PnL={op.mean():+.2f}" if len(op) else f"{bucket:<12} N={len(g):2d} | mean MFE={g['max_mfe_pct_num'].mean():+.3f}% | ordinary trades= 0 | mean ordinary PnL=n/a")
    add("")

    # Entry distance.
    add("4) EVENT -> ENTRY DISTANCE (ATR OF EVENT BAR)")
    add("-" * 82)
    for bucket, g in work.groupby("entry_distance_bucket", sort=False):
        op = g["ordinary_pnl_num"].dropna()
        add(f"{bucket:<14} N={len(g):2d} | mean MFE={g['max_mfe_pct_num'].mean():+.3f}% | ordinary trades={len(op):2d} | mean ordinary PnL={op.mean():+.2f}" if len(op) else f"{bucket:<14} N={len(g):2d} | mean MFE={g['max_mfe_pct_num'].mean():+.3f}% | ordinary trades= 0 | mean ordinary PnL=n/a")
    add("")

    # Managed re-entry audit.
    re = work[work["managed_reentry"]].copy()
    add("5) MANAGED RE-ENTRY AUDIT")
    add("-" * 82)
    if len(re):
        give = re["reentry_giveback_pnl"].dropna()
        add(f"BOS with managed re-entry: {len(re)}")
        add(f"Mean first managed PnL: {re['managed_first_pnl_num'].mean():+.2f}")
        add(f"Mean lifecycle PnL:      {re['managed_lifecycle_pnl_num'].mean():+.2f}")
        add(f"Mean lifecycle-first:    {give.mean():+.2f}")
        add(f"Lifecycle worse than first: {(give < 0).sum()}/{len(give)}")
        add(f"Lifecycle better than first: {(give > 0).sum()}/{len(give)}")
        add("")
        for _, r in re.sort_values("reentry_giveback_pnl").iterrows():
            add(f"BOS #{int(r['event_index'])} {r['direction']} | class={r['event_class']} | trades={int(r['managed_trade_count'])} | first={r['managed_first_pnl_num']:+.2f} | lifecycle={r['managed_lifecycle_pnl_num']:+.2f} | delta={r['reentry_giveback_pnl']:+.2f}")
    else:
        add("No managed re-entry events found.")
    add("")

    # Missed opportunities.
    add("6) MISSED / LATE GOOD BOS CANDIDATES")
    add("-" * 82)
    missed = work[(work["ordinary_pnl_num"].isna()) & (work["max_mfe_pct_num"] >= 0.30)].copy()
    add(f"No ordinary trade + MAX MFE >= 0.30%: {len(missed)}")
    for _, r in missed.sort_values("max_mfe_pct_num", ascending=False).iterrows():
        add(f"BOS #{int(r['event_index'])} {r['direction']} | class={r['event_class']} | signal_delay={r['event_to_signal_bars']} | entry_delay={r['event_to_entry_bars']} | MFE={r['max_mfe_pct_num']:+.3f}%")
    add("")

    # Good events vs ordinary capture.
    add("7) GOOD-BOS / ENGINE CAPTURE CROSS-CHECK")
    add("-" * 82)
    good = work[work["max_mfe_pct_num"] >= 0.30].copy()
    add(f"BOS with MAX MFE >= 0.30%: {len(good)}")
    if len(good):
        traded = good[good["ordinary_pnl_num"].notna()]
        missed = good[good["ordinary_pnl_num"].isna()]
        add(f"  ordinary trade present: {len(traded)}")
        add(f"  ordinary trade absent:  {len(missed)}")
        if len(traded):
            add(f"  mean ordinary PnL when traded: {traded['ordinary_pnl_num'].mean():+.2f}")
            add(f"  positive ordinary PnL: {(traded['ordinary_pnl_num'] > 0).sum()}/{len(traded)}")
    add("")

    # Integrity.
    checks = [
        ("v5.15 source exists", src.exists()),
        ("One row per BOS", len(work) == work["event_index"].nunique()),
        ("No duplicate event/direction", not work.duplicated(["event_index", "direction"]).any()),
        ("CSV export written", Path(V516_DECOMP_CSV).exists()),
        ("No strategy parameters modified", True),
    ]
    add("INTEGRITY")
    add("-" * 82)
    passed = 0
    for name, ok in checks:
        add(f"[{'PASS' if ok else 'FAIL'}] {name}")
        passed += int(bool(ok))
    add(f"RESULT: {passed}/{len(checks)} PASS")
    add("")
    add("SAFETY: NO ORDERS WERE SENT")
    add("SAFETY: RESEARCH MODE ONLY")
    add("=" * 82)

    try:
        Path(V516_DECOMP_TXT).write_text("\n".join(lines), encoding="utf-8")
        txt_ok = Path(V516_DECOMP_TXT).exists()
    except Exception as exc:
        txt_ok = False
        add(f"TXT WRITE ERROR: {type(exc).__name__}: {exc}")
        print(f"v5.16 TXT write error: {type(exc).__name__}: {exc}")

    print("\n".join(lines))
    return all(ok for _, ok in checks) and txt_ok

# ============================================================
# v5.16.1 ORDINARY TRADE PATH / MFE -> EXIT MONETIZATION LAB
# RESEARCH ONLY — strategy logic unchanged
# ============================================================

def _v5161_safe_float(value):
    try:
        value = float(value)
    except (TypeError, ValueError):
        return np.nan
    return value if np.isfinite(value) else np.nan


def _v5161_tag(value):
    """Canonical two-decimal field tag; prevents 0.1 vs 0.10 key mismatches."""
    return f"{float(value):.2f}".replace(".", "_")


def _v5161_trade_path(df, trade):
    """Reconstruct the observable path of one ordinary backtest trade.

    The reconstruction mirrors the backtest diagnostic boundary:
    - normal signal exits: OHLC path ends at the signal bar (exit is next-open),
    - forced/session exits: OHLC path includes the forced exit bar.

    The actual exit result uses the recorded trade net P&L, so no synthetic
    exit price is introduced into the strategy result.
    """
    entry_index = int(trade["entry_index"])
    exit_index = int(trade["exit_index"])
    side = str(trade["side"])
    entry_price = _v5161_safe_float(trade.get("entry_price"))
    if not pd.notna(entry_price) or entry_price <= 0:
        return None

    reason = str(trade.get("reason") or "")
    forced = reason == "END_OF_SESSION"
    path_end = exit_index if forced else exit_index - 1
    path_end = max(path_end, entry_index)
    path_end = min(path_end, len(df) - 1)

    path_indices = list(range(entry_index, path_end + 1))
    rows = []
    for idx in path_indices:
        bar = df.iloc[idx]
        high = float(bar["high"])
        low = float(bar["low"])
        if side == "LONG":
            favorable = (high / entry_price - 1.0) * 100.0
            adverse = (low / entry_price - 1.0) * 100.0
        else:
            favorable = (entry_price / low - 1.0) * 100.0
            adverse = (entry_price / high - 1.0) * 100.0
        rows.append({
            "index": idx,
            "time": bar["begin"],
            "favorable_pct": favorable,
            "adverse_pct": adverse,
        })

    return {
        "entry_index": entry_index,
        "exit_index": exit_index,
        "side": side,
        "entry_price": entry_price,
        "reason": reason,
        "path_end_index": path_end,
        "path": rows,
    }


def _v5161_first_hit(path, threshold):
    for pos, item in enumerate(path, start=1):
        if item["favorable_pct"] >= threshold:
            return pos, item["index"]
    return np.nan, np.nan


def _v5161_first_profit_after_cost(path, cost_pct):
    for pos, item in enumerate(path, start=1):
        if item["favorable_pct"] > cost_pct:
            return pos, item["index"]
    return np.nan, np.nan


def _v5161_bars_above(path, threshold):
    return int(sum(item["favorable_pct"] >= threshold for item in path))


def _v5161_recovery_after_adverse(path, adverse_threshold, profit_threshold):
    """Whether an adverse excursion reached threshold before later profit."""
    adverse_hit = False
    for item in path:
        if item["adverse_pct"] <= -abs(adverse_threshold):
            adverse_hit = True
        if adverse_hit and item["favorable_pct"] >= profit_threshold:
            return True
    return False


def run_v5161_trade_path_monetization_lab(research_signal_rows, df, ordinary_backtest):
    """Detailed ordinary-trade path analysis; no strategy changes."""
    print()
    print("=" * 70)
    print("v5.16.1 ORDINARY TRADE PATH / MFE -> EXIT MONETIZATION LAB")
    print("STRATEGY LOGIC: UNCHANGED")
    print("RESEARCH MODE ONLY")
    print("=" * 70)

    trades = (ordinary_backtest or {}).get("trades", [])
    if not trades:
        print("[FAIL] Ordinary backtest contains no trades")
        return False

    cost_pct = float(V510_COST_BREAK_EVEN_PCT)
    records = []
    path_objects = []

    for trade_no, trade in enumerate(trades, start=1):
        path_obj = _v5161_trade_path(df, trade)
        if path_obj is None:
            continue
        path_objects.append((trade_no, trade, path_obj))

        path = path_obj["path"]
        mfe = max([0.0] + [x["favorable_pct"] for x in path])
        mae = min([0.0] + [x["adverse_pct"] for x in path])
        mfe_item = max(path, key=lambda x: x["favorable_pct"]) if path else None
        mae_item = min(path, key=lambda x: x["adverse_pct"]) if path else None

        net_pnl = _v5161_safe_float(trade.get("net_pnl"))
        entry_notional = _v5161_safe_float(trade.get("entry_price")) * _v5161_safe_float(trade.get("quantity"))
        final_net_return = (
            net_pnl / entry_notional * 100.0
            if pd.notna(net_pnl) and pd.notna(entry_notional) and entry_notional > 0
            else _v5161_safe_float(trade.get("return_pct"))
        )

        rec = {
            "trade_number": trade_no,
            "signal_index": int(trade["signal_index"]),
            "entry_index": path_obj["entry_index"],
            "exit_index": path_obj["exit_index"],
            "entry_time": trade.get("entry_time"),
            "exit_time": trade.get("exit_time"),
            "side": trade.get("side"),
            "entry_price": path_obj["entry_price"],
            "exit_price": trade.get("exit_price"),
            "exit_reason": path_obj["reason"],
            "holding_bars": int(path_obj["exit_index"] - path_obj["entry_index"]),
            "path_bars": len(path),
            "path_end_index": path_obj["path_end_index"],
            "mfe_pct_path": mfe,
            "mfe_bar_from_entry": int(path.index(mfe_item) + 1) if mfe_item is not None else np.nan,
            "mfe_index": mfe_item["index"] if mfe_item is not None else np.nan,
            "mfe_time": mfe_item["time"] if mfe_item is not None else None,
            "mae_pct_path": mae,
            "mae_bar_from_entry": int(path.index(mae_item) + 1) if mae_item is not None else np.nan,
            "mae_index": mae_item["index"] if mae_item is not None else np.nan,
            "mae_time": mae_item["time"] if mae_item is not None else None,
            "final_net_pnl": net_pnl,
            "final_net_return_pct": final_net_return,
            "mfe_to_final_giveback_pct": mfe - final_net_return if pd.notna(final_net_return) else np.nan,
            "cost_break_even_pct": cost_pct,
            "first_profit_after_cost_bar": _v5161_first_profit_after_cost(path, cost_pct)[0],
            "first_profit_after_cost_index": _v5161_first_profit_after_cost(path, cost_pct)[1],
            "reached_profit_after_cost": _v5161_first_profit_after_cost(path, cost_pct)[0] == _v5161_first_profit_after_cost(path, cost_pct)[0],
        }

        for threshold in V5161_THRESHOLDS_PCT:
            tag = _v5161_tag(threshold)
            bar, idx = _v5161_first_hit(path, threshold)
            rec[f"first_hit_{tag}_pct_bar"] = bar
            rec[f"first_hit_{tag}_pct_index"] = idx
            rec[f"bars_at_or_above_{tag}_pct"] = _v5161_bars_above(path, threshold)
            rec[f"reached_{tag}_pct"] = pd.notna(bar)
            rec[f"mae_before_{tag}_pct"] = (
                min([0.0] + [x["adverse_pct"] for x in path[:int(bar)]])
                if pd.notna(bar) else np.nan
            )

        for adverse_threshold in (0.10, 0.20, 0.30, 0.50):
            tag = _v5161_tag(adverse_threshold)
            rec[f"recovered_after_mae_{tag}_to_{_v5161_tag(0.10)}"] = _v5161_recovery_after_adverse(path, adverse_threshold, 0.10)
            rec[f"recovered_after_mae_{tag}_to_{_v5161_tag(0.20)}"] = _v5161_recovery_after_adverse(path, adverse_threshold, 0.20)

        records.append(rec)

    work = pd.DataFrame(records)
    if work.empty:
        print("[FAIL] No valid ordinary-trade paths reconstructed")
        return False

    work.to_csv(V5161_PATH_CSV, index=False)

    # --------------------------------------------------------
    # Human-readable report.
    # --------------------------------------------------------
    lines = []
    add = lines.append
    add("=" * 82)
    add("MOEX TRADING LAB — v5.16.1 ORDINARY TRADE PATH / MFE -> EXIT MONETIZATION LAB")
    add("RESEARCH ONLY — STRATEGY LOGIC UNCHANGED")
    add("No thresholds below are strategy parameters. They are descriptive labels only.")
    add("=" * 82)
    add(f"Ordinary trades reconstructed: {len(work)}")
    add(f"Research round-trip break-even allowance: {cost_pct:.4f}%")
    add("")

    # Side-level summary.
    add("1) LONG / SHORT PATH SUMMARY")
    add("-" * 82)
    for side, g in work.groupby("side", sort=False):
        add(
            f"{side:<6} N={len(g):2d} | mean MFE={g['mfe_pct_path'].mean():+.3f}% | "
            f"median MFE={g['mfe_pct_path'].median():+.3f}% | "
            f"mean MAE={g['mae_pct_path'].mean():+.3f}% | "
            f"mean final={g['final_net_return_pct'].mean():+.3f}% | "
            f"profitable={(g['final_net_return_pct'] > 0).sum()}/{len(g)}"
        )
    add("")

    # MFE-to-final conversion.
    add("2) MFE -> FINAL CONVERSION")
    add("-" * 82)
    bins = [-np.inf, 0.0, 0.10, 0.20, 0.30, 0.50, 0.75, 1.00, np.inf]
    labels = ["<0", "0-0.10", "0.10-0.20", "0.20-0.30", "0.30-0.50", "0.50-0.75", "0.75-1.00", ">=1.00"]
    work["mfe_bucket"] = pd.cut(work["mfe_pct_path"], bins=bins, labels=labels, right=False)
    for label in labels:
        g = work[work["mfe_bucket"] == label]
        if g.empty:
            continue
        add(
            f"{label:<10} N={len(g):2d} | mean MFE={g['mfe_pct_path'].mean():+.3f}% | "
            f"mean final={g['final_net_return_pct'].mean():+.3f}% | "
            f"profitable={(g['final_net_return_pct'] > 0).sum()}/{len(g)} | "
            f"MFE->final giveback={g['mfe_to_final_giveback_pct'].mean():+.3f}pp"
        )
    add("")

    # Threshold conversion.
    add("3) THRESHOLD CONVERSION: REACHED -> LATER OUTCOME")
    add("-" * 82)
    for threshold in V5161_THRESHOLDS_PCT:
        tag = _v5161_tag(threshold)
        mask = work[f"reached_{tag}_pct"]
        g = work[mask].copy()
        if g.empty:
            add(f"+{threshold:.2f}%  reached=0/{len(work)}")
            continue
        later_loss = int((g["final_net_return_pct"] < 0).sum())
        later_profit = int((g["final_net_return_pct"] > 0).sum())
        add(
            f"+{threshold:.2f}%  reached={len(g):2d}/{len(work)} | "
            f"later loss={later_loss:2d} | later profit={later_profit:2d} | "
            f"mean final={g['final_net_return_pct'].mean():+.3f}% | "
            f"mean giveback={g['mfe_to_final_giveback_pct'].mean():+.3f}pp"
        )
    add("")

    # Timing.
    add("4) TIME TO MFE / FIRST PROFIT AFTER COST")
    add("-" * 82)
    cost_bar = pd.to_numeric(work["first_profit_after_cost_bar"], errors="coerce").dropna()
    mfe_bars = pd.to_numeric(work["mfe_bar_from_entry"], errors="coerce").dropna()
    add(
        f"MFE bar: N={len(mfe_bars)} | mean={mfe_bars.mean():.2f} | median={mfe_bars.median():.2f}"
        if len(mfe_bars) else "MFE bar: no data"
    )
    add(
        f"First > cost ({cost_pct:.4f}%): N={len(cost_bar)} | mean={cost_bar.mean():.2f} | median={cost_bar.median():.2f}"
        if len(cost_bar) else f"First > cost ({cost_pct:.4f}%): none"
    )
    add("")

    # Giveback extremes.
    add("5) LARGEST MFE -> FINAL GIVEBACKS")
    add("-" * 82)
    for _, r in work.sort_values("mfe_to_final_giveback_pct", ascending=False).head(10).iterrows():
        add(
            f"trade #{int(r['trade_number']):2d} {r['side']:<5} | MFE={r['mfe_pct_path']:+.3f}% | "
            f"final={r['final_net_return_pct']:+.3f}% | giveback={r['mfe_to_final_giveback_pct']:+.3f}pp | "
            f"MFE bar={r['mfe_bar_from_entry']} | exit={r['exit_reason']}"
        )
    add("")

    # Recovery analysis.
    add("6) RECOVERY AFTER ADVERSE EXCURSION")
    add("-" * 82)
    for adverse_threshold in (0.10, 0.20, 0.30, 0.50):
        tag = _v5161_tag(adverse_threshold)
        for profit_threshold in (0.10, 0.20):
            # Keep report key identical to the stored recovery columns.
            # str(0.10) becomes 0.1, but the stored key is 0_10.
            profit_tag = _v5161_tag(profit_threshold)
            col = f"recovered_after_mae_{tag}_to_{profit_tag}"
            n = int(work[col].sum())
            add(f"MAE <= -{adverse_threshold:.2f}% then later +{profit_threshold:.2f}%: {n}/{len(work)}")
    add("")

    # Full trade table, compact.
    add("7) TRADE-BY-TRADE PATH SUMMARY")
    add("-" * 82)
    for _, r in work.sort_values("trade_number").iterrows():
        add(
            f"#{int(r['trade_number']):2d} {r['side']:<5} | "
            f"hold={int(r['holding_bars']):2d} | MFE={r['mfe_pct_path']:+.3f}% @bar {int(r['mfe_bar_from_entry'])} | "
            f"MAE={r['mae_pct_path']:+.3f}% @bar {int(r['mae_bar_from_entry'])} | "
            f"final={r['final_net_return_pct']:+.3f}% | giveback={r['mfe_to_final_giveback_pct']:+.3f}pp | "
            f"exit={r['exit_reason']}"
        )
    add("")

    checks = [
        ("Ordinary trade count matches reconstructed rows", len(work) == len(trades)),
        ("No duplicate trade numbers", not work["trade_number"].duplicated().any()),
        ("Every path starts at actual entry index", bool((work["entry_index"] <= work["exit_index"]).all())),
        ("Path does not use post-exit normal-signal bars", bool((work["path_end_index"] <= work["exit_index"]).all())),
        ("CSV export written", Path(V5161_PATH_CSV).exists()),
        ("No strategy parameters modified", True),
    ]
    add("INTEGRITY")
    add("-" * 82)
    passed = 0
    for name, ok in checks:
        add(f"[{'PASS' if ok else 'FAIL'}] {name}")
        passed += int(bool(ok))
    add(f"RESULT: {passed}/{len(checks)} PASS")
    add("")
    add("SAFETY: NO ORDERS WERE SENT")
    add("SAFETY: RESEARCH MODE ONLY")
    add("=" * 82)

    try:
        Path(V5161_PATH_TXT).write_text("\n".join(lines), encoding="utf-8")
        txt_ok = Path(V5161_PATH_TXT).exists()
    except Exception as exc:
        txt_ok = False
        add(f"TXT WRITE ERROR: {type(exc).__name__}: {exc}")

    print("\n".join(lines))
    return passed == len(checks) and txt_ok


# ============================================================
# v5.17 TEMPORAL THRESHOLD PATH / GIVEBACK LAB — RESEARCH ONLY
# ============================================================

def _v517_safe_float(value, default=np.nan):
    try:
        out = float(value)
        return out if np.isfinite(out) else default
    except Exception:
        return default


def _v517_trade_path(df, trade):
    """Reconstruct the same ordinary-trade OHLC path boundary used by v5.16.1."""
    try:
        entry_index = int(trade["entry_index"])
        exit_index = int(trade["exit_index"])
    except Exception:
        return None
    entry_price = _v517_safe_float(trade.get("entry_price"))
    side = str(trade.get("side") or "")
    if not np.isfinite(entry_price) or entry_price <= 0 or side not in ("LONG", "SHORT"):
        return None
    reason = str(trade.get("reason") or "")
    forced = reason == "END_OF_SESSION"
    path_end = exit_index if forced else exit_index - 1
    path_end = max(path_end, entry_index)
    path_end = min(path_end, len(df) - 1)
    rows = []
    for idx in range(entry_index, path_end + 1):
        bar = df.iloc[idx]
        high = _v517_safe_float(bar.get("high"))
        low = _v517_safe_float(bar.get("low"))
        if not np.isfinite(high) or not np.isfinite(low):
            continue
        if side == "LONG":
            favorable = (high / entry_price - 1.0) * 100.0
            adverse = (low / entry_price - 1.0) * 100.0
        else:
            favorable = (entry_price / low - 1.0) * 100.0
            adverse = (entry_price / high - 1.0) * 100.0
        rows.append({
            "index": idx,
            "time": bar["begin"],
            "favorable_pct": favorable,
            "adverse_pct": adverse,
        })
    return {
        "entry_index": entry_index,
        "exit_index": exit_index,
        "side": side,
        "entry_price": entry_price,
        "reason": reason,
        "path_end_index": path_end,
        "path": rows,
    }


def _v517_threshold_metrics(path, threshold):
    """Descriptive post-hit trajectory. Nothing here feeds the strategy."""
    hits = [i for i, item in enumerate(path) if item["favorable_pct"] >= threshold]
    if not hits:
        return {
            "reached": False,
            "first_hit_bar": np.nan,
            "bars_to_hit": np.nan,
            "bars_at_or_above": 0,
            "bars_until_first_below": np.nan,
            "max_favorable_after_hit": np.nan,
            "min_favorable_after_hit": np.nan,
            "max_adverse_after_hit": np.nan,
            "max_giveback_from_post_hit_peak": np.nan,
            "final_favorable": np.nan,
            "final_adverse": np.nan,
            "returned_below_threshold": False,
            "returned_below_zero": False,
            "post_hit_bars": 0,
        }
    first = hits[0]
    post = path[first:]
    vals = [x["favorable_pct"] for x in post]
    adverse = [x["adverse_pct"] for x in post]
    peak = max(vals)
    peak_pos = vals.index(peak)
    trough_after_peak = min(vals[peak_pos:])
    giveback = peak - trough_after_peak

    first_below = np.nan
    for j in range(first + 1, len(path)):
        if path[j]["favorable_pct"] < threshold:
            first_below = j - first
            break

    return {
        "reached": True,
        "first_hit_bar": first + 1,
        "bars_to_hit": first,
        "bars_at_or_above": sum(v >= threshold for v in vals),
        "bars_until_first_below": first_below,
        "max_favorable_after_hit": max(vals),
        "min_favorable_after_hit": min(vals),
        "max_adverse_after_hit": min(adverse),
        "max_giveback_from_post_hit_peak": giveback,
        "final_favorable": vals[-1],
        "final_adverse": adverse[-1],
        "returned_below_threshold": any(v < threshold for v in vals[1:]),
        "returned_below_zero": any(v < 0.0 for v in vals[1:]),
        "post_hit_bars": len(vals),
    }


def run_v517_threshold_path_lab(df, ordinary_backtest):
    """
    v5.17 research-only continuation of v5.16.1.

    It answers one narrow question before any exit-rule experiment:
    what happens AFTER an ordinary trade first reaches +0.20%, +0.30% or +0.50%?

    It measures persistence, cross-back below the threshold, post-threshold
    adverse excursion, additional favorable excursion and giveback. It does
    NOT alter entries, exits, management or strategy parameters.
    """
    print()
    print("=" * 82)
    print("MOEX TRADING LAB — v5.17 TEMPORAL THRESHOLD PATH / GIVEBACK LAB")
    print("RESEARCH ONLY — STRATEGY LOGIC UNCHANGED")
    print("Purpose: inspect what happens after +0.20 / +0.30 / +0.50 is first reached.")
    print("IMPORTANT: descriptive path anatomy only; no exit rule is being tested or installed.")
    print("=" * 82)

    trades = (ordinary_backtest or {}).get("trades", [])
    rows = []
    path_count = 0
    for trade_no, trade in enumerate(trades, start=1):
        obj = _v517_trade_path(df, trade)
        if obj is None or not obj["path"]:
            continue
        path_count += 1
        path = obj["path"]
        base = {
            "trade_number": trade_no,
            "side": obj["side"],
            "entry_index": obj["entry_index"],
            "exit_index": obj["exit_index"],
            "path_end_index": obj["path_end_index"],
            "entry_price": obj["entry_price"],
            "exit_reason": obj["reason"],
            "holding_bars": max(0, obj["exit_index"] - obj["entry_index"]),
            "full_mfe_pct": max([0.0] + [x["favorable_pct"] for x in path]),
            "full_mae_pct": min([0.0] + [x["adverse_pct"] for x in path]),
            "final_favorable_pct": path[-1]["favorable_pct"],
            "final_adverse_pct": path[-1]["adverse_pct"],
            "final_net_return_pct": _v517_safe_float(trade.get("return_pct")),
        }
        for threshold in V517_ANALYSIS_THRESHOLDS_PCT:
            tag = str(threshold).replace(".", "_")
            m = _v517_threshold_metrics(path, threshold)
            for key, value in m.items():
                base[f"t{tag}_{key}"] = value
        rows.append(base)

    work = pd.DataFrame(rows)
    if work.empty:
        print("[FAIL] No valid ordinary-trade paths reconstructed")
        return False

    work.to_csv(V517_PATH_CSV, index=False)

    lines = []
    add = lines.append
    add("=" * 82)
    add("MOEX TRADING LAB — v5.17 TEMPORAL THRESHOLD PATH / GIVEBACK LAB")
    add("RESEARCH ONLY — STRATEGY LOGIC UNCHANGED")
    add("No threshold below is a strategy parameter. All results are descriptive path labels.")
    add("=" * 82)
    add(f"Ordinary trades available: {len(trades)}")
    add(f"Ordinary trade paths reconstructed: {path_count}")
    add("")

    add("1) THRESHOLD REACH / PERSISTENCE / GIVEBACK")
    add("-" * 82)
    for threshold in V517_ANALYSIS_THRESHOLDS_PCT:
        tag = str(threshold).replace(".", "_")
        g = work[work[f"t{tag}_reached"]].copy()
        if g.empty:
            add(f"+{threshold:.2f}% | reached 0/{len(work)}")
            continue
        first_below = pd.to_numeric(g[f"t{tag}_bars_until_first_below"], errors="coerce").dropna()
        persistence = pd.to_numeric(g[f"t{tag}_bars_at_or_above"], errors="coerce")
        giveback = pd.to_numeric(g[f"t{tag}_max_giveback_from_post_hit_peak"], errors="coerce")
        post_mae = pd.to_numeric(g[f"t{tag}_max_adverse_after_hit"], errors="coerce")
        add(
            f"+{threshold:.2f}% | reached={len(g):2d}/{len(work)} | "
            f"mean bars>=level={persistence.mean():.2f} | median={persistence.median():.2f} | "
            f"crossed below again={int(g[f't{tag}_returned_below_threshold'].sum())}/{len(g)} | "
            f"mean peak-giveback={giveback.mean():.3f}pp | "
            f"mean post-hit MAE={post_mae.mean():+.3f}%"
        )
        add(
            f"           first cross-below: N={len(first_below)} | "
            f"mean={first_below.mean():.2f} bars | median={first_below.median():.2f} | "
            f"returned <0 after hit={int(g[f't{tag}_returned_below_zero'].sum())}/{len(g)}"
        )
    add("")

    add("2) WHAT HAPPENS AFTER THE FIRST THRESHOLD HIT")
    add("-" * 82)
    for threshold in V517_ANALYSIS_THRESHOLDS_PCT:
        tag = str(threshold).replace(".", "_")
        g = work[work[f"t{tag}_reached"]].copy()
        if g.empty:
            continue
        extra = g[f"t{tag}_max_favorable_after_hit"] - threshold
        final = g["final_net_return_pct"]
        add(
            f"+{threshold:.2f}% | N={len(g):2d} | "
            f"max extra favorable after hit mean={extra.mean():+.3f}pp | "
            f"median={extra.median():+.3f}pp | "
            f"mean final net={final.mean():+.3f}% | "
            f"profitable={int((final > 0).sum())}/{len(g)}"
        )
    add("")

    add("3) SIDE SPLIT")
    add("-" * 82)
    for side, sg in work.groupby("side", sort=False):
        add(f"{side}: N={len(sg)}")
        for threshold in V517_ANALYSIS_THRESHOLDS_PCT:
            tag = str(threshold).replace(".", "_")
            g = sg[sg[f"t{tag}_reached"]]
            if g.empty:
                add(f"  +{threshold:.2f}% reached 0/{len(sg)}")
                continue
            gb = pd.to_numeric(g[f"t{tag}_max_giveback_from_post_hit_peak"], errors="coerce")
            pb = pd.to_numeric(g[f"t{tag}_bars_at_or_above"], errors="coerce")
            add(
                f"  +{threshold:.2f}% reached {len(g)}/{len(sg)} | "
                f"bars>=level mean {pb.mean():.2f} | giveback mean {gb.mean():.3f}pp | "
                f"final positive {int((g['final_net_return_pct'] > 0).sum())}/{len(g)}"
            )
    add("")

    add("4) TRADE-LEVEL THRESHOLD PATH TABLE")
    add("-" * 82)
    for _, r in work.sort_values("trade_number").iterrows():
        parts = [f"#{int(r['trade_number']):2d} {r['side']:<5} final={r['final_net_return_pct']:+.3f}%"]
        for threshold in V517_ANALYSIS_THRESHOLDS_PCT:
            tag = str(threshold).replace(".", "_")
            if bool(r[f"t{tag}_reached"]):
                parts.append(
                    f"+{threshold:.2f}: hold={r[f't{tag}_bars_at_or_above']:.0f}b "
                    f"gb={r[f't{tag}_max_giveback_from_post_hit_peak']:+.3f}pp "
                    f"below={str(bool(r[f't{tag}_returned_below_threshold']))}"
                )
            else:
                parts.append(f"+{threshold:.2f}: NO")
        add(" | ".join(parts))
    add("")

    checks = [
        ("Ordinary trade count matches reconstructed paths", len(work) == len(trades)),
        ("No duplicate trade numbers", not work["trade_number"].duplicated().any()),
        ("Every reconstructed path starts at entry", bool((work["entry_index"] <= work["exit_index"]).all())),
        ("No path uses post-exit normal-signal bars", bool((work["path_end_index"] <= work["exit_index"]).all())),
        ("Thresholds are descriptive only", True),
        ("No strategy parameters modified", True),
        ("CSV export written", Path(V517_PATH_CSV).exists()),
    ]
    add("INTEGRITY")
    add("-" * 82)
    passed = 0
    for name, ok in checks:
        add(f"[{'PASS' if ok else 'FAIL'}] {name}")
        passed += int(bool(ok))
    add(f"RESULT: {passed}/{len(checks)} PASS")
    add("")
    add("SAFETY: NO ORDERS WERE SENT")
    add("SAFETY: RESEARCH MODE ONLY")
    add("=" * 82)

    try:
        Path(V517_PATH_TXT).write_text("\n".join(lines), encoding="utf-8")
        txt_ok = Path(V517_PATH_TXT).exists()
    except Exception as exc:
        txt_ok = False
        add(f"TXT WRITE ERROR: {type(exc).__name__}: {exc}")

    print("\n".join(lines))
    return passed == len(checks) and txt_ok


